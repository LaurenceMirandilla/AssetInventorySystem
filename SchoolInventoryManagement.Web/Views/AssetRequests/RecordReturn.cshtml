@model SchoolInventoryManagement.Web.ViewModels.ReturnRequestViewModel
@{
    ViewData["Title"] = "Record Return";
    var request = ViewBag.Request as SchoolInventoryManagement.BLL.DTOs.AssetRequestResponseDTO;
    var outUnits = request?.Units.Where(u => u.ReturnDate == null).ToList()
        ?? new List<SchoolInventoryManagement.BLL.DTOs.AssetRequestUnitDTO>();
}

<h2>Record Return — Request #@Model.RequestID</h2>

@if (request is not null)
{
    <p class="text-muted">
        @request.ItemsSummary, with @request.RequestedByUser.FullName.
        @outUnits.Count unit@(outUnits.Count == 1 ? " is" : "s are") still out.
    </p>
}

<form asp-action="RecordReturn" asp-route-id="@Model.RequestID" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="RequestID" />
    <input type="hidden" asp-for="RowVersionBase64" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="fw-semibold">Units coming back</div>
                <div class="small">
                    <a href="#" id="tickAll">Tick all</a> &middot; <a href="#" id="tickNone">None</a>
                </div>
            </div>
            <div class="row row-cols-1 row-cols-md-2 g-1">
                @foreach (var unit in outUnits)
                {
                    <div class="col">
                        <label class="form-check">
                            <input type="checkbox" class="form-check-input return-box" name="AssignmentIDs"
                                   value="@unit.AssignmentID" checked="@Model.AssignmentIDs.Contains(unit.AssignmentID)" />
                            <span class="form-check-label small">
                                <span class="sab-code">@unit.AssetCode</span> @unit.AssetName
                            </span>
                        </label>
                    </div>
                }
            </div>
            <span asp-validation-for="AssignmentIDs" class="text-danger d-block"></span>
            <div class="form-text">Untick any that are not back yet — they stay out and can be returned later.</div>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="ConditionOnReturn" class="form-label">Condition on return</label>
        <select asp-for="ConditionOnReturn"
                asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.ConditionStatus>()"
                class="form-select"></select>
        <div class="form-text">Applies to every ticked unit. If some came back in a different state, return them separately.</div>
    </div>

    <div class="mb-3">
        <label asp-for="ReturnLocationID" class="form-label">Return to location</label>
        <select asp-for="ReturnLocationID" asp-items="ViewBag.Locations" class="form-select">
            <option value="">-- Select Location --</option>
        </select>
        <div class="form-text">Where the units are being put back. They become Available there.</div>
        <span asp-validation-for="ReturnLocationID" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Confirm Return</button>
    <a asp-action="Details" asp-route-id="@Model.RequestID" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            var boxes = document.querySelectorAll('.return-box');
            function setAll(value) { boxes.forEach(function (b) { b.checked = value; }); }
            document.getElementById('tickAll').addEventListener('click', function (e) { e.preventDefault(); setAll(true); });
            document.getElementById('tickNone').addEventListener('click', function (e) { e.preventDefault(); setAll(false); });
        })();
    </script>
}