@model List<SchoolInventoryManagement.BLL.DTOs.AssetRequestResponseDTO>
@using SchoolInventoryManagement.DAL.Constants
@using SchoolInventoryManagement.DAL.Entities.Enums
@{
    ViewData["Title"] = "Pending Requests";

    // Approved requests still out: In Transit or Assigned, until returned.
    var inProgress = ViewBag.InProgress as List<SchoolInventoryManagement.BLL.DTOs.AssetRequestResponseDTO>
        ?? new List<SchoolInventoryManagement.BLL.DTOs.AssetRequestResponseDTO>();

    // Principals see this list but cannot act on it: handing over and
    // recording returns is Officers' and Administrators' work.
    var canManageAssets = User.IsInRole(RoleNames.AssetOfficer)
        || User.IsInRole(RoleNames.Administrator);
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="sab-page-head">
    <div>
        <h2>Approvals</h2>
        <p class="sab-page-sub">
            @Model.Count request@(Model.Count == 1 ? "" : "s") awaiting a decision from you, oldest first.
        </p>
    </div>
    @if (User.IsInRole("Asset Officer") || User.IsInRole("Administrator"))
    {
        <div class="sab-page-actions">
            <a asp-action="History" class="btn btn-outline-secondary">Request History</a>
        </div>
    }
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            @foreach (var request in Model)
            {
                var requesterName = request.RequestedByUser.FullName;
                var requesterInitials = string.Concat(requesterName
                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Select(part => part[0])).ToUpperInvariant();
                if (requesterInitials.Length > 2) { requesterInitials = requesterInitials[..2]; }

                <div class="sab-row">
                    <div class="d-flex align-items-center" style="gap:12px; min-width:0;">
                        <span class="sab-avatar sab-avatar-soft">@requesterInitials</span>
                        <div style="min-width:0;">
                            <div class="sab-row-title">
                                @requesterName &mdash;
                                @request.ItemsSummary
                                @if (request.RequestType == RequestType.Transfer)
                                {
                                    <text> &rarr; @request.RequestedLocationName</text>
                                }
                            </div>
                            <div class="sab-row-meta">
                                <span class="status-pill status-@request.RequestType.ToString().ToLowerInvariant()">@request.RequestType</span>
                                <span class="ms-1">
                                    @request.RequestedByUser.RoleName &middot; @request.DepartmentName
                                    &middot; submitted <strong>@request.RequestDate.ToString("MMM d, yyyy h:mm tt")</strong>
                                    @if (request.RequestType == RequestType.Borrow && request.RequestedLocationName is not null)
                                    {
                                        <text>&middot; pickup at @request.RequestedLocationName</text>
                                    }
                                    @if (request.NeededFrom is not null)
                                    {
                                        <text>&middot; needed @request.NeededFrom.Value.ToString("MMM d")</text>
                                        @if (request.ReturnBy is not null)
                                        {
                                            <text>&ndash; @request.ReturnBy.Value.ToString("MMM d")</text>
                                        }
                                    }
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@request.RequestID">View</a>
                        <a asp-action="Approve" asp-route-id="@request.RequestID" class="ms-3">Approve</a>
                        <a asp-action="Reject" asp-route-id="@request.RequestID" class="ms-3 text-danger">Reject</a>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="sab-empty">
            <div class="sab-empty-title">Nothing is waiting on you</div>
            <p>Requests appear here as soon as somebody submits one.</p>
        </div>
    </div>
}

<div class="sab-page-head mt-4">
    <div>
        <h2>In Progress</h2>
        <p class="sab-page-sub">
            Approved and still out, oldest request first. <strong>In Transit</strong> means
            waiting to be collected (Borrow) or on its way (Transfer); <strong>Assigned</strong>
            means the requester has it. Each stays here until its return is recorded.
        </p>
    </div>
    @if (inProgress.Any())
    {
        <div class="sab-page-actions">
            <button type="button" id="ipToggle" class="btn btn-outline-secondary" aria-expanded="false" aria-controls="ipFilters">Filter</button>
        </div>
    }
</div>

@if (inProgress.Any())
{
    var departments = inProgress.Select(r => r.DepartmentName).Where(d => !string.IsNullOrEmpty(d)).Distinct().OrderBy(d => d).ToList();

    @* Off until "Filter" is clicked. Everything here runs in the browser on
       the rows already on the page -- the list is only what is out right
       now, so there is nothing to fetch. Turning the filter off clears it
       and puts the list back in its usual order. *@
    <div id="ipFilters" class="card mb-3 d-none">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-2">
                    <label for="ipTicket" class="form-label small mb-1">Ticket #</label>
                    <input type="search" id="ipTicket" class="form-control form-control-sm" inputmode="numeric" placeholder="e.g. 42" autocomplete="off" />
                </div>
                <div class="col-6 col-md-3">
                    <label for="ipRequester" class="form-label small mb-1">Requester</label>
                    <input type="search" id="ipRequester" class="form-control form-control-sm" placeholder="Name" autocomplete="off" />
                </div>
                <div class="col-6 col-md-3">
                    <label for="ipItem" class="form-label small mb-1">Item</label>
                    <input type="search" id="ipItem" class="form-control form-control-sm" placeholder="Model or unit code" autocomplete="off" />
                </div>
                <div class="col-6 col-md-2">
                    <label for="ipStatus" class="form-label small mb-1">Status</label>
                    <select id="ipStatus" class="form-select form-select-sm">
                        <option value="">Any</option>
                        <option value="intransit">In Transit</option>
                        <option value="assigned">Assigned</option>
                        <option value="overdue">Overdue</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label for="ipType" class="form-label small mb-1">Type</label>
                    <select id="ipType" class="form-select form-select-sm">
                        <option value="">Any</option>
                        <option value="borrow">Borrow</option>
                        <option value="transfer">Transfer</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label for="ipDepartment" class="form-label small mb-1">Department</label>
                    <select id="ipDepartment" class="form-select form-select-sm">
                        <option value="">Any</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d!.ToLowerInvariant()">@d</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label for="ipSort" class="form-label small mb-1">Sort by</label>
                    <select id="ipSort" class="form-select form-select-sm">
                        <option value="submitted-asc">Submitted — oldest first</option>
                        <option value="submitted-desc">Submitted — newest first</option>
                        <option value="due-asc">Due back — soonest first</option>
                        <option value="due-desc">Due back — latest first</option>
                        <option value="ticket-asc">Ticket # — low to high</option>
                        <option value="ticket-desc">Ticket # — high to low</option>
                        <option value="requester-asc">Requester — A to Z</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 d-flex align-items-center" style="gap:12px;">
                    <button type="button" id="ipClear" class="btn btn-link btn-sm p-0">Clear filters</button>
                    <span id="ipCount" class="text-muted small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="sab-table-card">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Submitted</th>
                    <th>Requester</th>
                    <th>Items</th>
                    <th>Where</th>
                    <th>Due back</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="ipRows">
                @for (var i = 0; i < inProgress.Count; i++)
                {
                    var r = inProgress[i];
                    var isBorrow = r.RequestType == RequestType.Borrow;
                    var overdue = r.RequestStatus == RequestStatus.Assigned
                        && r.ReturnBy is not null && r.ReturnBy.Value < DateTime.Now;

                    // What the filter matches and sorts on. Item covers the
                    // models asked for and the codes of the units handed out.
                    var itemText = (r.ItemsSummary + " " + string.Join(" ", r.Units.Select(u => u.AssetCode))).ToLowerInvariant();

                    <tr class="ip-row"
                        data-order="@i"
                        data-ticket="@r.RequestID"
                        data-submitted="@r.RequestDate.Ticks"
                        data-due="@(r.ReturnBy?.Ticks.ToString() ?? "")"
                        data-requester="@r.RequestedByUser.FullName.ToLowerInvariant()"
                        data-items="@itemText"
                        data-status="@(overdue ? "overdue" : r.RequestStatus.ToString().ToLowerInvariant())"
                        data-type="@r.RequestType.ToString().ToLowerInvariant()"
                        data-department="@(r.DepartmentName?.ToLowerInvariant() ?? "")">
                        <td><a asp-action="Details" asp-route-id="@r.RequestID">@r.RequestID</a></td>
                        <td class="small text-nowrap">
                            <div>@r.RequestDate.ToString("MMM d, yyyy")</div>
                            <div class="text-muted">@r.RequestDate.ToString("h:mm tt")</div>
                        </td>
                        <td>
                            <div>@r.RequestedByUser.FullName</div>
                            <div class="text-muted small">@r.DepartmentName</div>
                        </td>
                        <td>
                            <div>@r.ItemsSummary</div>
                            <div class="text-muted small">@r.UnitsOut of @r.Units.Count unit@(r.Units.Count == 1 ? "" : "s") out</div>
                        </td>
                        <td class="small">
                            @if (isBorrow)
                            {
                                @(r.RequestStatus == RequestStatus.InTransit
                                    ? "Pickup: " + (r.PickupLocationName ?? "—")
                                    : "With requester")
                            }
                            else
                            {
                                <text>&rarr; @r.RequestedLocationName</text>
                            }
                        </td>
                        <td class="small @(overdue ? "text-danger fw-semibold" : "")">
                            @(r.ReturnBy?.ToString("MMM d, h:mm tt") ?? "—")
                            @if (overdue)
                            {
                                <div>Overdue</div>
                            }
                        </td>
                        <td>
                            <span class="status-pill status-@r.RequestType.ToString().ToLowerInvariant()">@r.RequestType</span>
                            <span class="status-pill status-@r.RequestStatus.ToString().ToLowerInvariant()">@DisplayText.Humanize(r.RequestStatus.ToString())</span>
                        </td>
                        <td class="text-nowrap">
                            @if (canManageAssets && r.RequestStatus == RequestStatus.InTransit)
                            {
                                <form asp-action="MarkAssigned" asp-route-id="@r.RequestID" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(r.RowVersion)" />
                                    <input type="hidden" name="fromApprovals" value="true" />
                                    <button type="submit" class="btn btn-link p-0">@(isBorrow ? "Picked up" : "Delivered")</button>
                                </form>
                            }
                            @* Not picked up or delivered yet: cancel, don't return. *@
                            @if (canManageAssets && r.RequestStatus == RequestStatus.InTransit)
                            {
                                <a asp-action="Cancel" asp-route-id="@r.RequestID" class="ms-3 text-danger">Cancel</a>
                            }
                            else if (canManageAssets && r.UnitsOut > 0)
                            {
                                <a asp-action="RecordReturn" asp-route-id="@r.RequestID" class="ms-3">Record return</a>
                            }
                            @if (!canManageAssets)
                            {
                                <a asp-action="Details" asp-route-id="@r.RequestID">View</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div id="ipNoMatch" class="sab-empty d-none">
            <div class="sab-empty-title">No requests match these filters</div>
            <p>Change or clear the filters to see the rest.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="sab-empty">
            <div class="sab-empty-title">Nothing out right now</div>
            <p>Approved requests appear here until their return is recorded.</p>
        </div>
    </div>
}

<div class="sab-callout sab-callout-warn mt-3">
    <span class="sab-callout-label">Not yours to decide</span>
    A request cannot be decided by someone holding the requester's own role.
    One from an approver of your own role stays listed here, but has to go to
    an approver of a different role.
</div>

@section Scripts {
    <script>
        (function () {
            var toggle = document.getElementById('ipToggle');
            var panel = document.getElementById('ipFilters');
            var tbody = document.getElementById('ipRows');
            if (!toggle || !panel || !tbody) return;

            var rows = Array.from(tbody.querySelectorAll('.ip-row'));
            var ticket = document.getElementById('ipTicket');
            var requester = document.getElementById('ipRequester');
            var item = document.getElementById('ipItem');
            var status = document.getElementById('ipStatus');
            var type = document.getElementById('ipType');
            var department = document.getElementById('ipDepartment');
            var sort = document.getElementById('ipSort');
            var count = document.getElementById('ipCount');
            var noMatch = document.getElementById('ipNoMatch');
            var table = tbody.closest('table');
            var inputs = [ticket, requester, item, status, type, department, sort];

            function text(el) { return (el.value || '').trim().toLowerCase(); }
            function num(row, attr) { var v = row.getAttribute(attr); return v === '' ? null : Number(v); }

            function matches(row) {
                // Ticket: the number as typed, with or without a leading "#".
                var t = text(ticket).replace(/^#/, '');
                if (t && row.getAttribute('data-ticket').indexOf(t) !== 0) return false;
                if (text(requester) && row.getAttribute('data-requester').indexOf(text(requester)) === -1) return false;
                if (text(item) && row.getAttribute('data-items').indexOf(text(item)) === -1) return false;
                if (status.value && row.getAttribute('data-status') !== status.value) return false;
                if (type.value && row.getAttribute('data-type') !== type.value) return false;
                if (department.value && row.getAttribute('data-department') !== department.value) return false;
                return true;
            }

            // Rows without a due date go last whichever way due-date sorts.
            function compare(a, b) {
                switch (sort.value) {
                    case 'submitted-desc': return num(b, 'data-submitted') - num(a, 'data-submitted');
                    case 'due-asc':
                    case 'due-desc':
                        var da = num(a, 'data-due'), db = num(b, 'data-due');
                        if (da === null && db === null) return 0;
                        if (da === null) return 1;
                        if (db === null) return -1;
                        return sort.value === 'due-asc' ? da - db : db - da;
                    case 'ticket-asc': return num(a, 'data-ticket') - num(b, 'data-ticket');
                    case 'ticket-desc': return num(b, 'data-ticket') - num(a, 'data-ticket');
                    case 'requester-asc': return a.getAttribute('data-requester').localeCompare(b.getAttribute('data-requester'));
                    default: return num(a, 'data-order') - num(b, 'data-order'); // as the server sent it: oldest first
                }
            }

            function apply() {
                var shown = 0;
                rows.slice().sort(compare).forEach(function (row) {
                    tbody.appendChild(row);
                    var show = matches(row);
                    row.classList.toggle('d-none', !show);
                    if (show) shown++;
                });
                count.textContent = 'Showing ' + shown + ' of ' + rows.length;
                noMatch.classList.toggle('d-none', shown > 0);
                table.classList.toggle('d-none', shown === 0);
            }

            function reset() {
                inputs.forEach(function (el) { el.value = el === sort ? 'submitted-asc' : ''; });
                apply();
            }

            inputs.forEach(function (el) {
                el.addEventListener('input', apply);
                el.addEventListener('change', apply);
            });
            document.getElementById('ipClear').addEventListener('click', reset);

            // "Filter" turns the panel on; turning it off clears everything,
            // so a hidden filter can never be quietly hiding rows.
            toggle.addEventListener('click', function () {
                var on = panel.classList.toggle('d-none') === false;
                toggle.setAttribute('aria-expanded', on ? 'true' : 'false');
                toggle.classList.toggle('active', on);
                toggle.textContent = on ? 'Hide filter' : 'Filter';
                if (on) {
                    apply();
                    ticket.focus();
                } else {
                    reset();
                }
            });
        })();
    </script>
}