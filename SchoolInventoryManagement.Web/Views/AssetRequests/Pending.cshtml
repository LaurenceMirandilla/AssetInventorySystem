@model List<SchoolInventoryManagement.BLL.DTOs.AssetRequestResponseDTO>
@using SchoolInventoryManagement.BLL.DTOs
@using SchoolInventoryManagement.DAL.Constants
@using SchoolInventoryManagement.DAL.Entities.Enums
@using SchoolInventoryManagement.Web.ViewModels
@{
    ViewData["Title"] = "Approvals";

    // Approved requests still out: In Transit or Assigned, until returned.
    // Explicit types: ViewBag is dynamic, and a var here would stay dynamic,
    // which breaks the lambdas and "out var" lookups below.
    List<AssetRequestResponseDTO> inProgress = (ViewBag.InProgress as List<AssetRequestResponseDTO>) ?? new List<AssetRequestResponseDTO>();
    Dictionary<int, string> categories = (ViewBag.ModelCategories as Dictionary<int, string>) ?? new Dictionary<int, string>();
    Dictionary<int, ModelStock> stock = (ViewBag.Stock as Dictionary<int, ModelStock>) ?? new Dictionary<int, ModelStock>();
    Dictionary<int, string> deptBranches = (ViewBag.DepartmentBranches as Dictionary<int, string>) ?? new Dictionary<int, string>();
    string BranchOf(AssetRequestResponseDTO r) => deptBranches.TryGetValue(r.DepartmentID, out var b) ? b : "";

    // Principals see the In progress list but cannot act on it: handing
    // over and recording returns is Officers' and Administrators' work.
    var canManageAssets = User.IsInRole(RoleNames.AssetOfficer) || User.IsInRole(RoleNames.Administrator);

    var now = DateTime.Now;
    var today = DateTime.Today;
    bool IsOverdue(AssetRequestResponseDTO r) =>
        r.RequestStatus == RequestStatus.Assigned && r.ReturnBy is not null && r.ReturnBy.Value < now;

    var overdue = inProgress.Where(IsOverdue).OrderBy(r => r.ReturnBy).ToList();
    var transit = inProgress.Where(r => r.RequestStatus == RequestStatus.InTransit).ToList();
    var outNow = inProgress.Where(r => r.RequestStatus != RequestStatus.InTransit && !IsOverdue(r))
        .OrderBy(r => r.ReturnBy ?? DateTime.MaxValue).ToList();
    var progressGroups = new[]
    {
        (Key: "late", Label: "Overdue", Items: overdue),
        (Key: "transit", Label: "Ready for pickup or delivery", Items: transit),
        (Key: "use", Label: "Out now", Items: outNow)
    };
    var progressOrdered = progressGroups.SelectMany(g => g.Items).ToList();
}

@functions {
    static string Initials(string name)
    {
        var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => p[0])).ToUpperInvariant();
        return initials.Length > 2 ? initials[..2] : initials;
    }

    static string Days(int n) => n == 1 ? "1 day" : $"{n} days";

    // "→ Library" for a transfer; nothing for a borrow.
    static string Where(AssetRequestResponseDTO r) =>
        r.RequestType == RequestType.Transfer && r.RequestedLocationName != null ? " → " + r.RequestedLocationName : "";

    static string Search(AssetRequestResponseDTO r) =>
        string.Join(" ", new[] { "#" + r.RequestID, r.RequestID.ToString(), r.RequestedByUser.FullName, r.DepartmentName,
            r.ItemsSummary, r.RequestedLocationName ?? "", r.RequestType.ToString() }
            .Concat(r.Units.Select(u => u.AssetCode))).ToLowerInvariant();

    // Short due note for the In progress list.
    static string DueNote(DateTime? due, DateTime today)
    {
        if (due is null) return "no due date";
        var d = (due.Value.Date - today).Days;
        return d < 0 ? $"{Days(-d)} late" : d == 0 ? "today" : d == 1 ? "tomorrow" : $"in {d} days";
    }
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="asset-detail-head mb-3 pb-0 border-0">
    <div>
        <h2 class="asset-detail-title">Approvals</h2>
        <div class="asset-detail-sub">@Model.Count request@(Model.Count == 1 ? "" : "s") awaiting a decision from you.</div>
    </div>
    @if (canManageAssets)
    {
        <div class="asset-detail-actions">
            <a asp-action="History" class="btn btn-outline-secondary">Request History</a>
        </div>
    }
</div>

<div class="page-tabs" role="tablist">
    <button type="button" class="active" role="tab" aria-selected="true" data-md-tab="tabAwaiting">
        Awaiting your decision <span class="history-tab-count">@Model.Count</span>
    </button>
    <button type="button" role="tab" aria-selected="false" data-md-tab="tabProgress">
        In progress <span class="history-tab-count">@inProgress.Count</span>
    </button>
</div>

@* ---- Awaiting your decision ---------------------------------------- *@
<section id="tabAwaiting" role="tabpanel">
    @if (!Model.Any())
    {
        <div class="sab-table-card">
            <div class="sab-empty">
                <div class="sab-empty-title">Nothing is waiting on you</div>
                <p>Requests appear here as soon as somebody submits one.</p>
            </div>
        </div>
    }
    else
    {
        <div class="sab-table-card myassets" data-md data-page-size="6">
            <aside class="myassets-list" aria-label="Requests awaiting a decision">
                <div class="md-toolbar">
                    <label class="asset-search">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                        <input type="text" data-md-search autocomplete="off" placeholder="Search requests..." aria-label="Search requests" />
                    </label>
                    <div class="dropdown">
                        <button type="button" class="asset-tool-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8.5V19l-4 2v-7.5z" /></svg>
                            Filters
                        </button>
                        <div class="dropdown-menu dropdown-menu-end md-filter-menu">
                            <label class="form-label">Type</label>
                            <select class="form-select form-select-sm mb-2" data-md-filter="type">
                                <option value="">Any</option>
                                <option value="borrow">Borrow</option>
                                <option value="transfer">Transfer</option>
                            </select>
                            <label class="form-label">Branch</label>
                            <div class="mb-2">
                            <select class="form-select form-select-sm" data-md-filter="branch" data-combobox>
                                <option value="">Any</option>
                                @foreach (var d in Model.Select(BranchOf).Where(d => !string.IsNullOrEmpty(d)).Distinct().OrderBy(d => d))
                                {
                                    <option value="@d.ToLowerInvariant()">@d</option>
                                }
                            </select>
                            </div>
                            <label class="form-label">Department</label>
                            <select class="form-select form-select-sm" data-md-filter="dept" data-combobox>
                                <option value="">Any</option>
                                @foreach (var d in Model.Select(r => r.DepartmentName).Where(d => !string.IsNullOrEmpty(d)).Distinct().OrderBy(d => d))
                                {
                                    <option value="@d.ToLowerInvariant()">@d</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="myassets-group" data-md-group>
                    <div class="myassets-group-label group-late">Oldest first · <span data-md-count>@Model.Count</span></div>
                    @foreach (var r in Model)
                    {
                        var waited = (today - r.RequestDate.Date).Days;
                        <button type="button" class="myassets-item" data-entry="a-@r.RequestID" data-search="@Search(r)"
                                data-type="@r.RequestType.ToString().ToLowerInvariant()"
                                data-dept="@(r.DepartmentName?.ToLowerInvariant() ?? "")" data-branch="@BranchOf(r).ToLowerInvariant()">
                            <span class="md-avatar">@Initials(r.RequestedByUser.FullName)</span>
                            <span class="myassets-item-main">
                                <span class="myassets-item-title">@r.RequestedByUser.FullName</span>
                                <span class="myassets-item-sub">@(r.ItemsSummary + Where(r))</span>
                                <span class="md-tags">
                                    <span class="md-tag @(r.RequestType == RequestType.Transfer ? "is-transfer" : "")">@r.RequestType</span>
                                    @r.DepartmentName
                                </span>
                            </span>
                            <span class="md-age @(waited >= 2 ? "is-late" : "")">@(waited == 0 ? "today" : Days(waited))</span>
                        </button>
                    }
                </div>
                <div class="myassets-nomatch" data-md-empty hidden>Nothing matches your search.</div>

                <div class="md-foot">
                    <span data-md-range></span>
                    <div data-md-pager></div>
                </div>
            </aside>

            <section class="myassets-detail">
                @foreach (var r in Model)
                {
                    var waited = (today - r.RequestDate.Date).Days;
                    var isBorrow = r.RequestType == RequestType.Borrow;
                    // The same role cannot decide it (the service refuses too).
                    var sameRole = User.IsInRole(r.RequestedByUser.RoleName);
                    var freeForRequest = r.Items.Sum(i => stock.TryGetValue(i.ModelID, out var s) ? s.Total : 0);

                    <article class="myassets-panel" data-panel="a-@r.RequestID" hidden>
                        <button type="button" class="myassets-back" data-back>&larr; All requests</button>

                        <div class="myassets-panel-head">
                            <div class="md-person">
                                <span class="md-avatar md-avatar-lg">@Initials(r.RequestedByUser.FullName)</span>
                                <div class="min-w-0">
                                    <div class="myassets-panel-meta">
                                        <span class="md-tag @(isBorrow ? "" : "is-transfer")">@r.RequestType</span>
                                        <span>Request #@r.RequestID · submitted @r.RequestDate.ToString("MMM d, h:mm tt")</span>
                                    </div>
                                    <h3 class="md-person-name">@r.RequestedByUser.FullName <small>· @r.RequestedByUser.RoleName · @r.DepartmentName</small></h3>
                                </div>
                            </div>
                            <div class="myassets-panel-actions">
                                <span class="md-wait @(waited >= 2 ? "" : "is-calm")">Waiting @(waited == 0 ? "since today" : Days(waited))</span>
                                <a asp-action="Details" asp-route-id="@r.RequestID" asp-route-from="approvals" class="btn btn-outline-secondary">View &rarr;</a>
                            </div>
                        </div>

                        <div class="myassets-stats">
                            <div><span>@(isBorrow ? "Pickup at" : "Move to")</span><strong>@(r.RequestedLocationName ?? "—")</strong></div>
                            <div>
                                <span>Needed</span>
                                <strong>@(r.NeededFrom?.ToString("MMM d") ?? "—")@(r.ReturnBy is not null ? " → " + r.ReturnBy.Value.ToString("MMM d") : "")</strong>
                            </div>
                            <div><span>Units</span><strong>@r.TotalQuantity</strong></div>
                            <div><span>Available now</span><strong class="@(freeForRequest >= r.TotalQuantity ? "text-success" : "text-danger")">@freeForRequest in stock</strong></div>
                        </div>

                        <h4 class="md-section-title">What they're asking for</h4>
                        <div class="req-items">
                            @foreach (var item in r.Items)
                            {
                                stock.TryGetValue(item.ModelID, out var s);
                                var free = s?.Total ?? 0;
                                var atPickup = s != null && r.RequestedLocationName != null && s.ByLocation.TryGetValue(r.RequestedLocationName, out var here) ? here : 0;
                                <div class="req-item">
                                    <span class="req-item-icon" aria-hidden="true">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 2 3 7v10l9 5 9-5V7z" /><path d="m3 7 9 5 9-5M12 12v10" /></svg>
                                    </span>
                                    <div class="min-w-0">
                                        <div class="req-item-name">@item.ModelName</div>
                                        <div class="req-item-meta @(free < item.Quantity ? "is-short" : "")">
                                            @(categories.TryGetValue(item.ModelID, out var cat) ? cat + " · " : "")@free available@(isBorrow && r.RequestedLocationName != null ? $", {atPickup} at the {r.RequestedLocationName}" : "")
                                        </div>
                                    </div>
                                    <span class="req-item-qty">×@item.Quantity</span>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(r.Reason))
                        {
                            <div class="req-note"><strong>Reason:</strong> @r.Reason</div>
                        }

                        @if (sameRole)
                        {
                            <div class="sab-callout sab-callout-warn mt-3">
                                <span class="sab-callout-label">Not yours to decide</span>
                                This request is from someone with your own role, so it has to go to an approver of a different role.
                            </div>
                        }
                        else
                        {
                            <div class="req-action">
                                <div>
                                    <div class="req-action-title">Your decision</div>
                                    <div class="req-action-note">Approving takes you to pick the units; rejecting asks for a reason.</div>
                                </div>
                                <div class="req-action-buttons">
                                    <a asp-action="Approve" asp-route-id="@r.RequestID" class="btn btn-primary">Approve &amp; pick units &rarr;</a>
                                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#reject-@r.RequestID">Reject</button>
                                </div>
                            </div>
                        }
                    </article>
                }
            </section>
        </div>
    }
</section>

@* Reject confirmations for the requests above, outside the list so a
   hidden panel cannot hide them. *@
@foreach (var r in Model)
{
    <partial name="_RejectRequestModal" model="r" />
}

@* ---- In progress ------------------------------------------------------ *@
<section id="tabProgress" role="tabpanel" hidden>
    @if (!inProgress.Any())
    {
        <div class="sab-table-card">
            <div class="sab-empty">
                <div class="sab-empty-title">Nothing out right now</div>
                <p>Approved requests appear here until their return is recorded.</p>
            </div>
        </div>
    }
    else
    {
        <div class="sab-table-card myassets" data-md data-page-size="6">
            <aside class="myassets-list" aria-label="Requests in progress">
                <div class="md-toolbar">
                    <label class="asset-search">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                        <input type="text" data-md-search autocomplete="off" placeholder="Ticket #, name or item..." aria-label="Search by ticket number, name or item" />
                    </label>
                    <div class="dropdown">
                        <button type="button" class="asset-tool-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8.5V19l-4 2v-7.5z" /></svg>
                            Filters
                        </button>
                        <div class="dropdown-menu dropdown-menu-end md-filter-menu">
                            <label class="form-label">Type</label>
                            <select class="form-select form-select-sm mb-2" data-md-filter="type">
                                <option value="">Any</option>
                                <option value="borrow">Borrow</option>
                                <option value="transfer">Transfer</option>
                            </select>
                            <label class="form-label">Stage</label>
                            <select class="form-select form-select-sm mb-2" data-md-filter="stage">
                                <option value="">Any</option>
                                <option value="deliver">Waiting for pickup or delivery</option>
                                <option value="return">Waiting for return</option>
                            </select>
                            <label class="form-label">Timing</label>
                            <select class="form-select form-select-sm mb-2" data-md-filter="timing">
                                <option value="">Any</option>
                                <option value="ontime">On time</option>
                                <option value="overdue">Overdue</option>
                            </select>
                            <label class="form-label">Department</label>
                            <select class="form-select form-select-sm" data-md-filter="dept" data-combobox>
                                <option value="">Any</option>
                                @foreach (var d in inProgress.Select(r => r.DepartmentName).Where(d => !string.IsNullOrEmpty(d)).Distinct().OrderBy(d => d))
                                {
                                    <option value="@d.ToLowerInvariant()">@d</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                @foreach (var g in progressGroups.Where(g => g.Items.Any()))
                {
                    <div class="myassets-group" data-md-group>
                        <div class="myassets-group-label group-@g.Key">@g.Label · <span data-md-count>@g.Items.Count</span></div>
                        @foreach (var r in g.Items)
                        {
                            var isBorrow = r.RequestType == RequestType.Borrow;
                            var late = g.Key == "late";
                            <button type="button" class="myassets-item" data-entry="p-@r.RequestID" data-search="@Search(r)"
                                    data-type="@r.RequestType.ToString().ToLowerInvariant()" data-dept="@(r.DepartmentName?.ToLowerInvariant() ?? "")"
                                    data-stage="@(g.Key == "transit" ? "deliver" : "return")" data-timing="@(late ? "overdue" : "ontime")">
                                <span class="md-avatar @(late ? "is-dark" : "")">@Initials(r.RequestedByUser.FullName)</span>
                                <span class="myassets-item-main">
                                    <span class="myassets-item-title">@r.RequestedByUser.FullName</span>
                                    <span class="myassets-item-sub">@(r.ItemsSummary + Where(r)) · @r.Units.Count unit@(r.Units.Count == 1 ? "" : "s")</span>
                                    <span class="md-tags">
                                        <span class="md-tag @(isBorrow ? "" : "is-transfer")">@r.RequestType</span>
                                        @if (g.Key == "transit")
                                        {
                                            @(isBorrow ? "pick up at " + (r.PickupLocationName ?? "—") : "to " + (r.RequestedLocationName ?? "—"))
                                        }
                                        else
                                        {
                                            @(r.ReturnBy is not null ? "due " + r.ReturnBy.Value.ToString("MMM d") : "no due date")
                                        }
                                    </span>
                                </span>
                                <span class="md-age @(late ? "is-late" : g.Key == "transit" ? "is-transit" : "is-soon")">
                                    @(g.Key == "transit" ? "In transit" : DueNote(r.ReturnBy, today))
                                </span>
                            </button>
                        }
                    </div>
                }
                <div class="myassets-nomatch" data-md-empty hidden>Nothing matches your search.</div>

                <div class="md-foot">
                    <span data-md-range></span>
                    <div data-md-pager></div>
                </div>
            </aside>

            <section class="myassets-detail">
                @foreach (var r in progressOrdered)
                {
                    var isBorrow = r.RequestType == RequestType.Borrow;
                    var late = IsOverdue(r);
                    var inTransit = r.RequestStatus == RequestStatus.InTransit;
                    var daysLate = late ? (today - r.ReturnBy!.Value.Date).Days : 0;
                    var unitsOverdue = r.Units.Count(u => u.AssetStatus == AssetStatus.Overdue);
                    var steps = new List<RequestStep>
                    {
                        new("Submitted", r.RequestDate.ToString("MMM d"), RequestStepState.Done),
                        new("Approved", r.ApprovalDate?.ToString("MMM d"), RequestStepState.Done),
                        new(isBorrow ? "Picked up" : "Delivered",
                            inTransit ? (isBorrow ? "at " + (r.PickupLocationName ?? "—") : "to " + (r.RequestedLocationName ?? "—")) : r.AssignedDate?.ToString("MMM d"),
                            inTransit ? RequestStepState.Current : RequestStepState.Done),
                        new("Returned", r.ReturnBy is not null ? "due " + r.ReturnBy.Value.ToString("MMM d") : null,
                            late ? RequestStepState.Late : inTransit ? RequestStepState.Todo : RequestStepState.Current)
                    };

                    <article class="myassets-panel" data-panel="p-@r.RequestID" hidden>
                        <button type="button" class="myassets-back" data-back>&larr; All requests</button>

                        <div class="myassets-panel-head">
                            <div class="md-person">
                                <span class="md-avatar md-avatar-lg @(late ? "is-dark" : "")">@Initials(r.RequestedByUser.FullName)</span>
                                <div class="min-w-0">
                                    <div class="myassets-panel-meta">
                                        <span class="md-tag @(isBorrow ? "" : "is-transfer")">@r.RequestType</span>
                                        <span>Request #@r.RequestID · submitted @r.RequestDate.ToString("MMM d, h:mm tt")</span>
                                    </div>
                                    <h3 class="md-person-name">@r.RequestedByUser.FullName <small>· @r.RequestedByUser.RoleName · @r.DepartmentName</small></h3>
                                </div>
                            </div>
                            <div class="myassets-panel-actions">
                                @if (late)
                                {
                                    <span class="asset-pill asset-status st-overdue">@(unitsOverdue > 0 ? unitsOverdue + " overdue" : "Overdue")</span>
                                }
                                else if (inTransit)
                                {
                                    <span class="asset-pill asset-status st-intransit">In transit</span>
                                }
                                else
                                {
                                    <span class="asset-pill asset-status st-assigned">Out</span>
                                }
                                <a asp-action="Details" asp-route-id="@r.RequestID" asp-route-from="approvals" class="btn btn-outline-secondary">View &rarr;</a>
                            </div>
                        </div>

                        <partial name="_RequestSteps" model="steps" />

                        <div class="myassets-stats">
                            <div>
                                <span>Where</span>
                                <strong>
                                    @if (isBorrow)
                                    {
                                        @(inTransit ? "Pick up at " + (r.PickupLocationName ?? "—") : "With requester")
                                    }
                                    else
                                    {
                                        @("→ " + (r.RequestedLocationName ?? "—"))
                                    }
                                </strong>
                            </div>
                            <div class="@(late ? "is-late" : "")">
                                <span>Due back</span>
                                <strong>@(r.ReturnBy?.ToString("MMM d") ?? "—")@(late ? $" · {Days(daysLate)} late" : "")</strong>
                            </div>
                            <div><span>Units out</span><strong>@r.UnitsOut of @r.Units.Count</strong></div>
                            <div><span>Approved by</span><strong>@(r.ApprovedByUser?.FullName ?? "—")</strong></div>
                        </div>

                        @if (r.Items.Count > 1)
                        {
                            <div class="myassets-chips">
                                @foreach (var item in r.Items)
                                {
                                    <span class="myassets-chip">@item.ModelName <strong>×@item.Quantity</strong></span>
                                }
                            </div>
                        }

                        @if (r.Units.Any())
                        {
                            <h4 class="md-section-title">Units on this request</h4>
                            <div class="myassets-units">
                                <table class="table myassets-table">
                                    <thead><tr><th>Code</th><th>Asset</th><th>Status</th></tr></thead>
                                    <tbody>
                                        @for (var i = 0; i < r.Units.Count; i++)
                                        {
                                            var u = r.Units[i];
                                            <tr hidden="@(i >= 3)" data-extra="@(i >= 3 ? "true" : null)">
                                                <td data-label="Code"><a asp-controller="Assets" asp-action="Details" asp-route-id="@u.AssetID" class="asset-code-chip">@u.AssetCode</a></td>
                                                <td data-label="Asset">@u.AssetName</td>
                                                <td data-label="Status">
                                                    @if (u.ReturnDate is not null)
                                                    {
                                                        <span class="asset-pill asset-status st-available">Returned @u.ReturnDate.Value.ToString("MMM d")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="asset-pill asset-status st-@u.AssetStatus.ToString().ToLowerInvariant()">@DisplayText.Humanize(u.AssetStatus.ToString())</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (r.Units.Count > 3)
                                {
                                    <button type="button" class="myassets-more" data-more>Show @(r.Units.Count - 3) more unit@(r.Units.Count - 3 == 1 ? "" : "s") &#9662;</button>
                                }
                            </div>
                        }

                        @if (canManageAssets)
                        {
                            <div class="req-action @(late ? "is-late" : "")">
                                <div>
                                    <div class="req-action-title">
                                        @if (late)
                                        {
                                            @(Days(daysLate) + " overdue")
                                        }
                                        else if (inTransit)
                                        {
                                            @(isBorrow ? "Waiting to be picked up" : "On its way")
                                        }
                                        else
                                        {
                                            @("Due back " + (r.ReturnBy?.ToString("MMM d") ?? "—"))
                                        }
                                    </div>
                                    <div class="req-action-note">
                                        @(inTransit ? "Not handed over yet: mark it done, or cancel to put the units back." : "Record the return when the units come back.")
                                    </div>
                                </div>
                                <div class="req-action-buttons">
                                    @if (inTransit)
                                    {
                                        <form asp-action="MarkAssigned" asp-route-id="@r.RequestID" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(r.RowVersion)" />
                                            <input type="hidden" name="fromApprovals" value="true" />
                                            <button type="submit" class="btn btn-primary">@(isBorrow ? "Picked up" : "Delivered")</button>
                                        </form>
                                        <a asp-action="Cancel" asp-route-id="@r.RequestID" class="btn btn-outline-danger">Cancel</a>
                                    }
                                    else if (r.UnitsOut > 0)
                                    {
                                        <a asp-action="RecordReturn" asp-route-id="@r.RequestID" class="btn btn-primary">Record return &rarr;</a>
                                    }
                                </div>
                            </div>
                        }
                    </article>
                }
            </section>
        </div>
    }
</section>
