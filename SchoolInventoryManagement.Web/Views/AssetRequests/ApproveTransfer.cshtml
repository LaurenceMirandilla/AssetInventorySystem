@model SchoolInventoryManagement.Web.ViewModels.ApproveTransferRequestViewModel
@{
    ViewData["Title"] = "Approve Transfer Request";
    var request = ViewBag.Request as SchoolInventoryManagement.BLL.DTOs.AssetRequestResponseDTO;
    var lines = ViewBag.Lines as List<SchoolInventoryManagement.Web.ViewModels.ApprovalLineChoice>
        ?? new List<SchoolInventoryManagement.Web.ViewModels.ApprovalLineChoice>();
}

<h2>Approve Transfer Request #@Model.RequestID</h2>

@if (request is not null)
{
    <p class="text-muted">
        @request.RequestedByUser.FullName (@request.RequestedByUser.RoleName)
        asked for <strong>@request.ItemsSummary</strong>
        to be moved to <strong>@request.RequestedLocationName</strong>.
    </p>
    @if (request.NeededFrom is not null)
    {
        <p class="text-muted">
            Needed from <strong>@request.NeededFrom.Value.ToString("MMM d, yyyy h:mm tt")</strong>
            @if (request.ReturnBy is not null)
            {
                <text>until <strong>@request.ReturnBy.Value.ToString("MMM d, yyyy h:mm tt")</strong></text>
            }
        </p>
    }
    @if (!string.IsNullOrWhiteSpace(request.Reason))
    {
        <p class="text-muted">Reason given: @request.Reason</p>
    }
}

<div class="alert alert-info">
    Tick the units to send — exactly the amount asked for on each line. Units
    already at the destination are not listed. Approving reserves them to the
    requester; the request is then <strong>In Transit</strong> and stays under
    Approvals until an Asset Officer or Administrator marks it delivered, and
    later records the return.
</div>

<form asp-action="ApproveTransfer" asp-route-id="@Model.RequestID" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="RequestID" />
    <input type="hidden" asp-for="RowVersionBase64" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <h5 class="mb-2">Units to send</h5>
    <partial name="_ApprovalUnitPicker" model="lines" />

    <div class="mb-3">
        <label asp-for="ConditionOnTransfer" class="form-label">
            Condition at hand-over <span class="text-muted">(optional)</span>
        </label>
        <select asp-for="ConditionOnTransfer"
                asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.ConditionStatus>()"
                class="form-select">
            <option value="">-- Leave unchanged --</option>
        </select>
        <div class="form-text">Leaving this blank keeps each unit's condition as recorded.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Remarks" class="form-label">Notes <span class="text-muted">(optional)</span></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Approve</button>
    <a asp-action="Details" asp-route-id="@Model.RequestID" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}