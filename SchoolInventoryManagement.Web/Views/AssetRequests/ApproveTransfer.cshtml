@model SchoolInventoryManagement.Web.ViewModels.ApproveTransferRequestViewModel
@{
    ViewData["Title"] = "Approve Transfer Request";
    var request = ViewBag.Request as SchoolInventoryManagement.BLL.DTOs.AssetRequestResponseDTO;
    var candidates = ViewBag.CandidateAssets as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

<h2>Approve Transfer Request #@Model.RequestID</h2>

@if (request is not null)
{
    <p class="text-muted">
        @request.RequestedByUser.FullName (@request.RequestedByUser.RoleName)
        asked for a <strong>@(request.ModelName ?? "unit")</strong>
        to be moved to <strong>@request.RequestedLocationName</strong>.
    </p>
    @if (request.NeededFrom is not null)
    {
        <p class="text-muted">
            Needed from <strong>@request.NeededFrom.Value.ToString("MMM d, yyyy h:mm tt")</strong>
            @if (request.ReturnBy is not null)
            {
                <text>until <strong>@request.ReturnBy.Value.ToString("MMM d, yyyy h:mm tt")</strong></text>
            }
        </p>
    }
    @if (!string.IsNullOrWhiteSpace(request.Reason))
    {
        <p class="text-muted">Reason given: @request.Reason</p>
    }
}

<div class="alert alert-info">
    Approving moves the unit and marks the request fulfilled in one step. If any
    part fails, none of it is saved. The unit must still be Available when you approve.
</div>

<form asp-action="ApproveTransfer" asp-route-id="@Model.RequestID" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="RequestID" />
    <input type="hidden" asp-for="RowVersionBase64" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (request?.AssetID is not null)
    {
        @* An older request that named its unit up front -- nothing to pick. *@
        <div class="mb-3">
            <div class="form-label">Unit to transfer</div>
            <div class="fw-semibold"><span class="sab-code">@request.AssetCode</span></div>
            <div class="form-text">This request was made before transfers asked for a model, so its unit is already set.</div>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label asp-for="AssetID" class="form-label">Unit to transfer</label>
            <select asp-for="AssetID" asp-items="candidates" class="form-select">
                <option value="">-- Select Unit --</option>
            </select>
            <div class="form-text">
                Only Available units of the requested model are listed, and none already at the destination.
            </div>
            <span asp-validation-for="AssetID" class="text-danger"></span>
        </div>
    }

    <div class="mb-3">
        <label asp-for="ConditionOnTransfer" class="form-label">
            Condition at hand-over <span class="text-muted">(optional)</span>
        </label>
        <select asp-for="ConditionOnTransfer"
                asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.ConditionStatus>()"
                class="form-select">
            <option value="">-- Leave unchanged --</option>
        </select>
        <div class="form-text">Leaving this blank keeps the condition already on record.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Remarks" class="form-label">Notes <span class="text-muted">(optional)</span></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Approve &amp; Transfer</button>
    <a asp-action="Details" asp-route-id="@Model.RequestID" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}