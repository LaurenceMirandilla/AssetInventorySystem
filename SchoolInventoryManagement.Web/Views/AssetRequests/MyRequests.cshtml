@model List<SchoolInventoryManagement.BLL.DTOs.AssetRequestResponseDTO>
@using SchoolInventoryManagement.BLL.DTOs
@using SchoolInventoryManagement.DAL.Entities.Enums
@using SchoolInventoryManagement.Web.ViewModels
@{
    ViewData["Title"] = "My Requests";
    // Explicit type: a var from ViewBag would stay dynamic and break the
    // "out var" lookups below.
    Dictionary<int, string> categories = (ViewBag.ModelCategories as Dictionary<int, string>) ?? new Dictionary<int, string>();
    var now = DateTime.Now;
    var today = DateTime.Today;

    bool IsLate(AssetRequestResponseDTO r) =>
        r.RequestStatus == RequestStatus.Assigned && r.ReturnBy is not null && r.ReturnBy.Value < now;

    var groups = new[]
    {
        (Key: "late", Label: "Waiting for approval", Items: Model.Where(r => r.RequestStatus == RequestStatus.Pending).ToList()),
        (Key: "transit", Label: "Ready to collect", Items: Model.Where(r => r.RequestStatus == RequestStatus.InTransit).ToList()),
        (Key: "use", Label: "With you", Items: Model.Where(r => r.RequestStatus == RequestStatus.Assigned).OrderBy(r => r.ReturnBy ?? DateTime.MaxValue).ToList()),
        (Key: "done", Label: "Done", Items: Model.Where(r => r.RequestStatus is not (RequestStatus.Pending or RequestStatus.InTransit or RequestStatus.Assigned)).ToList())
    };
    var ordered = groups.SelectMany(g => g.Items).ToList();
}

@functions {
    static string Days(int n) => n == 1 ? "1 day" : $"{n} days";

    static string Title(AssetRequestResponseDTO r) =>
        r.ItemsSummary + (r.RequestType == RequestType.Transfer && r.RequestedLocationName != null ? " → " + r.RequestedLocationName : "");

    static string When(AssetRequestResponseDTO r) =>
        r.NeededFrom is null ? "—" : r.NeededFrom.Value.ToString("MMM d") + (r.ReturnBy is not null ? " – " + r.ReturnBy.Value.ToString("MMM d") : "");

    static string Status(RequestStatus s) => s switch
    {
        RequestStatus.InTransit => "In transit",
        RequestStatus.Assigned => "With you",
        _ => DisplayText.Humanize(s.ToString())
    };
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="asset-detail-head">
    <div>
        <h2 class="asset-detail-title">My Requests</h2>
        <div class="asset-detail-sub">Your Borrow and Transfer requests. You can cancel a request while it is still pending.</div>
    </div>
    <div class="asset-detail-actions">
        <a asp-action="Create" class="btn btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            New Request
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="sab-table-card">
        <div class="sab-empty">
            <div class="sab-empty-title">No requests yet</div>
            <p>Borrow asks for models to use. Transfer asks for models to be moved to another location. Either way, staff pick the units.</p>
            <a asp-action="Create" class="btn btn-primary">+ New Request</a>
        </div>
    </div>
}
else
{
    <div class="sab-table-card myassets" data-md data-page-size="8">
        <aside class="myassets-list" aria-label="Your requests">
            <div class="md-toolbar">
                <label class="asset-search">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                    <input type="text" data-md-search autocomplete="off" placeholder="Search my requests..." aria-label="Search my requests" />
                </label>
                <div class="dropdown">
                    <button type="button" class="asset-tool-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8.5V19l-4 2v-7.5z" /></svg>
                        Filters
                    </button>
                    <div class="dropdown-menu dropdown-menu-end md-filter-menu">
                        <label class="form-label">Type</label>
                        <select class="form-select form-select-sm" data-md-filter="type">
                            <option value="">Any</option>
                            <option value="borrow">Borrow</option>
                            <option value="transfer">Transfer</option>
                        </select>
                    </div>
                </div>
            </div>

            @foreach (var g in groups.Where(g => g.Items.Any()))
            {
                <div class="myassets-group" data-md-group>
                    <div class="myassets-group-label group-@g.Key">@g.Label · <span data-md-count>@g.Items.Count</span></div>
                    @foreach (var r in g.Items)
                    {
                        var late = IsLate(r);
                        var units = r.Units.Count > 0 ? r.Units.Count : r.TotalQuantity;
                        var detail = r.RequestStatus switch
                        {
                            RequestStatus.InTransit => r.RequestType == RequestType.Borrow ? "pick up at " + (r.PickupLocationName ?? "—") : "on its way",
                            RequestStatus.Assigned => r.ReturnBy is not null ? "due " + r.ReturnBy.Value.ToString("MMM d") : "no due date",
                            _ => When(r)
                        };
                        var sub = $"{units} unit{(units == 1 ? "" : "s")} · {detail}";
                        var dueIn = r.ReturnBy is not null ? (r.ReturnBy.Value.Date - today).Days : 0;
                        string right;
                        if (late) { right = dueIn >= 0 ? "late today" : Days(-dueIn) + " late"; }
                        else if (r.RequestStatus == RequestStatus.Assigned && r.ReturnBy is not null)
                        { right = dueIn == 0 ? "due today" : dueIn == 1 ? "tomorrow" : $"in {dueIn} days"; }
                        else { right = Status(r.RequestStatus); }
                        var tone = late || r.RequestStatus is RequestStatus.Rejected ? "item-late"
                            : r.RequestStatus == RequestStatus.InTransit ? "item-transit" : "";
                        <button type="button" class="myassets-item @tone" data-entry="r-@r.RequestID"
                                data-type="@r.RequestType.ToString().ToLowerInvariant()"
                                data-search="@($"#{r.RequestID} {r.RequestID} {Title(r)} {r.RequestType} {Status(r.RequestStatus)}".ToLowerInvariant())">
                            <span class="myassets-badge">
                                <strong>#@r.RequestID</strong>
                                <small>@r.RequestType</small>
                            </span>
                            <span class="myassets-item-main">
                                <span class="myassets-item-title">@Title(r)</span>
                                <span class="myassets-item-sub">@sub</span>
                            </span>
                            <span class="myassets-item-due">@right</span>
                        </button>
                    }
                </div>
            }
            <div class="myassets-nomatch" data-md-empty hidden>Nothing matches your search.</div>

            <div class="md-foot">
                <span data-md-range></span>
                <div data-md-pager></div>
            </div>
        </aside>

        <section class="myassets-detail">
            @foreach (var r in ordered)
            {
                var isBorrow = r.RequestType == RequestType.Borrow;
                var late = IsLate(r);
                var st = r.RequestStatus;
                var stopped = st is RequestStatus.Rejected or RequestStatus.Cancelled;
                var handedOver = st is RequestStatus.Assigned or RequestStatus.Returned or RequestStatus.Fulfilled;
                var units = r.Units.Count > 0 ? r.Units.Count : r.TotalQuantity;
                var steps = new List<RequestStep>
                {
                    new("Submitted", r.RequestDate.ToString("MMM d"), RequestStepState.Done),
                    new(st == RequestStatus.Rejected ? "Rejected" : st == RequestStatus.Cancelled ? "Cancelled" : "Approval",
                        st == RequestStatus.Pending ? "waiting" : r.ApprovalDate?.ToString("MMM d"),
                        st == RequestStatus.Pending ? RequestStepState.Current : stopped ? RequestStepState.Stopped : RequestStepState.Done),
                    new(isBorrow ? "Pick up" : "Delivery",
                        handedOver ? r.AssignedDate?.ToString("MMM d") : isBorrow ? (r.PickupLocationName ?? r.RequestedLocationName) : r.RequestedLocationName,
                        handedOver ? RequestStepState.Done : st == RequestStatus.InTransit ? RequestStepState.Current : RequestStepState.Todo),
                    new("Return",
                        st == RequestStatus.Returned ? r.ReturnedDate?.ToString("MMM d") : r.ReturnBy is not null ? "by " + r.ReturnBy.Value.ToString("MMM d") : null,
                        st == RequestStatus.Returned ? RequestStepState.Done : late ? RequestStepState.Late : st == RequestStatus.Assigned ? RequestStepState.Current : RequestStepState.Todo)
                };
                var pillCss = late ? "st-overdue" : st switch
                {
                    RequestStatus.Pending => "st-disposed",
                    RequestStatus.InTransit => "st-intransit",
                    RequestStatus.Assigned => "st-assigned",
                    RequestStatus.Rejected => "st-overdue",
                    _ => "st-available"
                };

                <article class="myassets-panel" data-panel="r-@r.RequestID" hidden>
                    <button type="button" class="myassets-back" data-back>&larr; All my requests</button>

                    <div class="myassets-panel-head">
                        <div class="min-w-0">
                            <div class="myassets-panel-meta">
                                <span class="md-tag @(isBorrow ? "" : "is-transfer")">@r.RequestType</span>
                                <span>Request #@r.RequestID · submitted @r.RequestDate.ToString("MMM d, h:mm tt")</span>
                            </div>
                            <h3 class="myassets-panel-title">@Title(r)</h3>
                        </div>
                        <div class="myassets-panel-actions">
                            <span class="asset-pill asset-status @pillCss">@(late ? "Overdue" : Status(st))</span>
                            <a asp-action="Details" asp-route-id="@r.RequestID" asp-route-from="mine" class="btn btn-outline-secondary">View &rarr;</a>
                        </div>
                    </div>

                    <partial name="_RequestSteps" model="steps" />

                    <div class="myassets-stats">
                        <div><span>Type</span><strong>@r.RequestType</strong></div>
                        <div class="@(late ? "is-late" : "")"><span>When</span><strong>@When(r)</strong></div>
                        <div>
                            <span>@(isBorrow ? "Pick up at" : "Move to")</span>
                            <strong>@((isBorrow ? r.PickupLocationName ?? r.RequestedLocationName : r.RequestedLocationName) ?? "—")</strong>
                        </div>
                        <div><span>Units</span><strong>@units</strong></div>
                    </div>

                    <div class="req-items mt-3">
                        @foreach (var item in r.Items)
                        {
                            <div class="req-item">
                                <span class="req-item-icon" aria-hidden="true">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 2 3 7v10l9 5 9-5V7z" /><path d="m3 7 9 5 9-5M12 12v10" /></svg>
                                </span>
                                <div class="min-w-0">
                                    <div class="req-item-name">@item.ModelName</div>
                                    @if (categories.TryGetValue(item.ModelID, out var cat))
                                    {
                                        <div class="req-item-meta">@cat</div>
                                    }
                                </div>
                                <span class="req-item-qty">×@item.Quantity</span>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(r.Reason))
                    {
                        <div class="req-note"><strong>Reason:</strong> @r.Reason</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(r.Remarks))
                    {
                        <div class="req-note"><strong>@(st == RequestStatus.Rejected ? "Why it was rejected" : "Staff remarks"):</strong> @r.Remarks</div>
                    }

                    @if (st == RequestStatus.Pending)
                    {
                        <div class="req-action">
                            <div class="req-action-note">You can cancel this while it is still pending.</div>
                            <div class="req-action-buttons">
                                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancel-@r.RequestID">Cancel request</button>
                            </div>
                        </div>
                    }
                    else if (st == RequestStatus.InTransit)
                    {
                        <div class="req-action">
                            <div>
                                <div class="req-action-title">@(isBorrow ? "Ready for you" : "On its way")</div>
                                <div class="req-action-note">
                                    @(isBorrow ? "Collect it from the Asset Officer at " + (r.PickupLocationName ?? "the pickup location") + "." : "It is being moved to " + (r.RequestedLocationName ?? "the new location") + ".")
                                </div>
                            </div>
                        </div>
                    }
                    else if (late)
                    {
                        <div class="req-action is-late">
                            <div>
                                <div class="req-action-title">@Days((today - r.ReturnBy!.Value.Date).Days) late</div>
                                <div class="req-action-note">Bring @(units == 1 ? "it" : "these") to the Asset Officer so the return can be recorded.</div>
                            </div>
                        </div>
                    }
                </article>
            }
        </section>
    </div>

    @* One confirmation per pending request. Outside the list so a hidden
       panel cannot hide it; it posts to the same Cancel action the old
       page did (a failed post falls back to that page with the error). *@
    @foreach (var r in Model.Where(r => r.RequestStatus == RequestStatus.Pending))
    {
        var isBorrow = r.RequestType == RequestType.Borrow;
        var total = r.TotalQuantity;
        <div class="modal fade" id="cancel-@r.RequestID" tabindex="-1" aria-labelledby="cancelTitle-@r.RequestID" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable cancel-dialog">
                <form asp-action="Cancel" asp-route-id="@r.RequestID" method="post" class="modal-content cancel-modal">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="RequestID" value="@r.RequestID" />
                    <input type="hidden" name="RowVersionBase64" value="@Convert.ToBase64String(r.RowVersion)" />

                    <div class="cancel-head">
                        <span class="cancel-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="m9 9 6 6M15 9l-6 6" /></svg>
                        </span>
                        <div class="flex-grow-1 min-w-0">
                            <h3 class="cancel-title" id="cancelTitle-@r.RequestID">Cancel request #@r.RequestID?</h3>
                            <div class="cancel-meta">
                                <span class="md-tag @(isBorrow ? "" : "is-transfer")">@r.RequestType</span>
                                <span>@Title(r) · submitted @r.RequestDate.ToString("MMM d")</span>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body cancel-body">
                        <div class="cancel-facts">
                            <div><span>When</span><strong>@When(r)</strong></div>
                            <div><span>@(isBorrow ? "Pick up at" : "Move to")</span><strong>@((isBorrow ? r.PickupLocationName ?? r.RequestedLocationName : r.RequestedLocationName) ?? "—")</strong></div>
                            <div><span>Status</span><strong>Pending</strong></div>
                        </div>

                        <div class="cancel-label">
                            <span>Items on this request</span>
                            <span class="text-muted fw-normal">@r.Items.Count model@(r.Items.Count == 1 ? "" : "s")@(r.Items.Count > 4 ? " · scroll for all" : "")</span>
                        </div>
                        <div class="cancel-items">
                            @foreach (var item in r.Items)
                            {
                                var abbr = string.Concat(item.ModelName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
                                <div class="cancel-item">
                                    <span class="cancel-item-abbr">@abbr</span>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="req-item-name">@item.ModelName</div>
                                        @if (categories.TryGetValue(item.ModelID, out var cat))
                                        {
                                            <div class="req-item-meta">@cat</div>
                                        }
                                    </div>
                                    <span class="req-item-qty">×@item.Quantity</span>
                                </div>
                            }
                        </div>
                        <div class="cancel-total"><span>Total</span><strong>@total unit@(total == 1 ? "" : "s")</strong></div>

                        <label class="cancel-label" for="cancelReason-@r.RequestID">
                            <span>Reason</span>
                            <span class="text-muted fw-normal">required · approvers will see it</span>
                        </label>
                        <textarea name="Reason" id="cancelReason-@r.RequestID" class="form-control" rows="3" maxlength="500" required
                                  placeholder="e.g. The orientation was moved online."></textarea>
                    </div>

                    <div class="cancel-foot">
                        <span class="text-muted small">This can't be undone.</span>
                        <div class="d-flex" style="gap:8px;">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep request</button>
                            <button type="submit" class="btn btn-danger">Yes, cancel request</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
}
