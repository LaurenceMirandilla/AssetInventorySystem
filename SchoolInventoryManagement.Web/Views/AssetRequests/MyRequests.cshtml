@model List<SchoolInventoryManagement.BLL.DTOs.AssetRequestResponseDTO>
@{
    ViewData["Title"] = "My Requests";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="sab-page-head">
    <div>
        <h2>My Requests</h2>
        <p class="sab-page-sub">
            You can cancel a request while it is still pending. Only you can —
            staff reject rather than cancel on your behalf.
        </p>
    </div>
    <div class="sab-page-actions">
        <a asp-action="Create" class="btn btn-primary">+ New Request</a>
    </div>
</div>

@if (Model.Any())
{
    <div class="sab-table-card">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Type</th>
                    <th>What</th>
                    <th>When</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>@request.RequestID</td>
                        <td><span class="status-pill status-@request.RequestType.ToString().ToLowerInvariant()">@request.RequestType</span></td>
                        <td>
                            @(request.ModelName ?? "—")
                            @if (request.RequestType == SchoolInventoryManagement.DAL.Entities.Enums.RequestType.Transfer)
                            {
                                <text> &rarr; @request.RequestedLocationName</text>
                            }
                        </td>
                        <td class="small">
                            @if (request.NeededFrom is not null)
                            {
                                @request.NeededFrom.Value.ToString("MMM d")
                                @if (request.ReturnBy is not null)
                                {
                                    <text> &ndash; @request.ReturnBy.Value.ToString("MMM d")</text>
                                }
                            }
                            else
                            {
                                <span class="text-muted">&mdash;</span>
                            }
                        </td>
                        <td>@request.RequestDate.ToString("MMM d, yyyy")</td>
                        <td><span class="status-pill status-@request.RequestStatus.ToString().ToLowerInvariant()">@request.RequestStatus</span></td>
                        <td><a asp-action="Details" asp-route-id="@request.RequestID">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card">
        <div class="sab-empty">
            <div class="sab-empty-title">No requests yet</div>
            <p>Borrow asks for a model to use. Transfer asks for a model to be moved to another location. Either way, staff pick the unit.</p>
            <a asp-action="Create" class="btn btn-primary">+ New Request</a>
        </div>
    </div>
}