@model SchoolInventoryManagement.Web.ViewModels.CreateAssetRequestViewModel
@{
    ViewData["Title"] = "New Request";
}

<h2>New Request</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="RequestType" class="form-label">Request Type</label>
        <select asp-for="RequestType" id="requestType"
                asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.RequestType>()"
                class="form-select"></select>
        <div class="form-text">
            <strong>Borrow</strong> — ask for a model; staff pick the actual unit when they approve.<br />
            <strong>Transfer</strong> — move a specific unit that already exists to another location.
        </div>
    </div>

    <div id="borrowFields">
        <div class="mb-3">
            <label asp-for="ModelID" class="form-label">Model</label>
            <select asp-for="ModelID" asp-items="ViewBag.Models" class="form-select">
                <option value="">-- Select Model --</option>
            </select>
            <span asp-validation-for="ModelID" class="text-danger"></span>
        </div>
    </div>

    <div id="transferFields">
        <div class="mb-3">
            <label asp-for="AssetID" class="form-label">Asset</label>
            <select asp-for="AssetID" asp-items="ViewBag.Assets" class="form-select">
                <option value="">-- Select Asset --</option>
            </select>
            <span asp-validation-for="AssetID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="RequestedLocationID" class="form-label">Destination Location</label>
            <select asp-for="RequestedLocationID" asp-items="ViewBag.Locations" class="form-select">
                <option value="">-- Select Location --</option>
            </select>
            <span asp-validation-for="RequestedLocationID" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Reason" class="form-label">Reason <span class="text-muted">(optional)</span></label>
        <textarea asp-for="Reason" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Submit Request</button>
    <a asp-action="MyRequests" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Only ever show the half of the form that matches the request type.
        // The controller clears the hidden half server-side too, so a stale
        // value can never reach the service even if this script never runs.
        (function () {
            var typeSelect = document.getElementById('requestType');
            var borrow = document.getElementById('borrowFields');
            var transfer = document.getElementById('transferFields');

            // Html.GetEnumSelectList renders the enum's numeric value, so
            // match on that rather than the name — both are accepted here
            // so the toggle survives either rendering.
            var borrowValues = ['@((int)SchoolInventoryManagement.DAL.Entities.Enums.RequestType.Borrow)', 'Borrow'];

            function sync() {
                var isBorrow = borrowValues.indexOf(typeSelect.value) !== -1;
                borrow.hidden = !isBorrow;
                transfer.hidden = isBorrow;
            }

            typeSelect.addEventListener('change', sync);
            sync();
        })();
    </script>
}
