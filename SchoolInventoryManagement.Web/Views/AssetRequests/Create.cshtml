@model SchoolInventoryManagement.Web.ViewModels.CreateAssetRequestViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "New Request";

    // Grouped by category, with models that have nothing on the shelf
    // disabled (greyed out). Rendered by hand rather than with asp-items
    // because every row needs its own selected value.
    var modelItems = (List<SelectListItem>)ViewBag.Models;
    var modelGroups = modelItems.GroupBy(m => m.Group?.Name ?? "").ToList();

    // Always at least one row, even after a post that removed them all.
    var rows = Model.ModelIDs.Count > 0 ? Model.ModelIDs : new List<int?> { null };
}

<h2>New Request</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="RequestType" class="form-label">Request Type</label>
        <select asp-for="RequestType" id="requestType"
                asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.RequestType>()"
                class="form-select"></select>
        <div class="form-text">
            <strong>Borrow</strong> — ask for a model to use; staff pick the actual unit when they approve.<br />
            <strong>Transfer</strong> — ask for a model to be moved to another location; staff pick the unit that goes.
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Items</label>

        <div id="modelRows">
            @foreach (var selectedId in rows)
            {
                <div class="input-group mb-2 model-row">
                    <select name="ModelIDs" class="form-select">
                        <option value="">-- Select Model --</option>
                        @foreach (var group in modelGroups)
                        {
                            <optgroup label="@group.Key">
                                @foreach (var item in group)
                                {
                                    <option value="@item.Value"
                                            disabled="@item.Disabled"
                                            selected="@(item.Value == selectedId?.ToString())">@item.Text</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <button type="button" class="btn btn-outline-danger remove-row" title="Remove this item">&times;</button>
                </div>
            }
        </div>

        <button type="button" id="addModelRow" class="btn btn-outline-primary btn-sm">+ Add another item</button>
        <span asp-validation-for="ModelIDs" class="text-danger d-block"></span>

        @* Greyed-out entries have no units on the shelf right now, so they
           cannot be requested. The link covers the other dead end: the
           thing needed is not in the catalogue at all. *@
        <div class="form-text">
            Each item becomes its own request. Need two of the same? Add it twice.
            Greyed-out models have no units available right now.
            Not on the list?
            <a asp-controller="NewItemRequests" asp-action="Create">Request a new item</a>
        </div>
    </div>

    <div id="transferFields">
        <div class="mb-3">
            <label asp-for="RequestedLocationID" class="form-label">Destination Location</label>
            <select asp-for="RequestedLocationID" asp-items="ViewBag.Locations" class="form-select">
                <option value="">-- Select Location --</option>
            </select>
            <span asp-validation-for="RequestedLocationID" class="text-danger"></span>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="NeededFrom" class="form-label">When do you need it?</label>
            <input asp-for="NeededFrom" id="neededFrom" type="datetime-local" class="form-control" />
            <span asp-validation-for="NeededFrom" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ReturnBy" class="form-label">
                <span id="returnByLabel">When will you return it?</span>
            </label>
            <input asp-for="ReturnBy" id="returnBy" type="datetime-local" class="form-control" />
            <span asp-validation-for="ReturnBy" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Reason" class="form-label">Reason <span class="text-muted">(optional)</span></label>
        <textarea asp-for="Reason" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Submit Request</button>
    <a asp-action="MyRequests" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            // Destination only applies to Transfer. The controller clears it
            // for a Borrow server-side too, so a stale value never reaches
            // the service even if this script never runs.
            var typeSelect = document.getElementById('requestType');
            var transfer = document.getElementById('transferFields');
            var returnByLabel = document.getElementById('returnByLabel');

            // Html.GetEnumSelectList renders the enum's numeric value, so
            // match on that rather than the name — both are accepted here
            // so the toggle survives either rendering.
            var borrowValues = ['@((int)SchoolInventoryManagement.DAL.Entities.Enums.RequestType.Borrow)', 'Borrow'];

            function syncType() {
                var isBorrow = borrowValues.indexOf(typeSelect.value) !== -1;
                transfer.hidden = isBorrow;
                returnByLabel.textContent = isBorrow
                    ? 'When will you return it?'
                    : 'When should it come back?';
            }

            typeSelect.addEventListener('change', syncType);
            syncType();

            // Dates: nothing before today, and the return picker cannot be
            // set earlier than the start. The service enforces both anyway.
            var neededFrom = document.getElementById('neededFrom');
            var returnBy = document.getElementById('returnBy');

            function pad(n) { return String(n).padStart(2, '0'); }
            var today = new Date();
            neededFrom.min = today.getFullYear() + '-' + pad(today.getMonth() + 1) + '-' + pad(today.getDate()) + 'T00:00';

            function syncReturnMin() {
                returnBy.min = neededFrom.value || neededFrom.min;
                if (returnBy.value && neededFrom.value && returnBy.value <= neededFrom.value) {
                    returnBy.value = '';
                }
            }

            neededFrom.addEventListener('change', syncReturnMin);
            syncReturnMin();

            // "+ Add another item": copy the first row with nothing chosen.
            // Every row posts as ModelIDs, which binds to the list. The x
            // removes a row; the last one is only cleared, so there is
            // always somewhere to pick a model.
            var rowsBox = document.getElementById('modelRows');
            var maxRows = 20; // the service refuses more than this anyway

            function syncRemoveButtons() {
                var rowsNow = rowsBox.querySelectorAll('.model-row');
                rowsNow.forEach(function (row) {
                    row.querySelector('.remove-row').hidden = rowsNow.length === 1;
                });
                document.getElementById('addModelRow').disabled = rowsNow.length >= maxRows;
            }

            document.getElementById('addModelRow').addEventListener('click', function () {
                var copy = rowsBox.querySelector('.model-row').cloneNode(true);
                copy.querySelector('select').value = '';
                rowsBox.appendChild(copy);
                syncRemoveButtons();
                copy.querySelector('select').focus();
            });

            rowsBox.addEventListener('click', function (e) {
                var button = e.target.closest('.remove-row');
                if (!button) return;
                var rowsNow = rowsBox.querySelectorAll('.model-row');
                var row = button.closest('.model-row');
                if (rowsNow.length > 1) {
                    row.remove();
                } else {
                    row.querySelector('select').value = '';
                }
                syncRemoveButtons();
            });

            syncRemoveButtons();
        })();
    </script>
}