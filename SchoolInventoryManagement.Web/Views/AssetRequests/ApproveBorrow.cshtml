@model SchoolInventoryManagement.Web.ViewModels.ApproveBorrowRequestViewModel
@{
    ViewData["Title"] = "Approve Borrow Request";
    var request = ViewBag.Request as SchoolInventoryManagement.BLL.DTOs.AssetRequestResponseDTO;
    var lines = ViewBag.Lines as List<SchoolInventoryManagement.Web.ViewModels.ApprovalLineChoice>
        ?? new List<SchoolInventoryManagement.Web.ViewModels.ApprovalLineChoice>();
}

<h2>Approve Borrow Request #@Model.RequestID</h2>

@if (request is not null)
{
    <p class="text-muted">
        @request.RequestedByUser.FullName (@request.RequestedByUser.RoleName)
        asked for <strong>@request.ItemsSummary</strong>.
    </p>
    @if (request.NeededFrom is not null)
    {
        <p class="text-muted">
            Needed from <strong>@request.NeededFrom.Value.ToString("MMM d, yyyy h:mm tt")</strong>
            @if (request.ReturnBy is not null)
            {
                <text>until <strong>@request.ReturnBy.Value.ToString("MMM d, yyyy h:mm tt")</strong></text>
            }
        </p>
    }
    @if (!string.IsNullOrWhiteSpace(request.Reason))
    {
        <p class="text-muted">Reason given: @request.Reason</p>
    }
}

<div class="alert alert-info">
    Tick the units to hand over — exactly the amount asked for on each line.
    Approving reserves them to the requester and sets them aside at the pickup
    location. The request is then <strong>In Transit</strong> and stays under
    Approvals until an Asset Officer or Administrator marks it collected, and
    later records the return. If any part of the approval fails, none of it is saved.
</div>

<form asp-action="ApproveBorrow" asp-route-id="@Model.RequestID" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="RequestID" />
    <input type="hidden" asp-for="RowVersionBase64" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <h5 class="mb-2">Units to hand over</h5>
    <partial name="_ApprovalUnitPicker" model="lines" />

    <div class="mb-3">
        <label asp-for="ConditionOnAssignment" class="form-label">Condition at hand-over</label>
        <select asp-for="ConditionOnAssignment"
                asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.ConditionStatus>()"
                class="form-select"></select>
    </div>

    @if (request?.RequestedLocationID is not null)
    {
        @* The requester named where they want to collect the units, so there
           is nothing to choose here -- the controller uses their location
           and their own department. *@
        <div class="mb-3">
            <div class="form-label">Department the units go to</div>
            <div class="fw-semibold">@request.DepartmentName</div>
            <div class="form-text">The requester's own department, since they chose the pickup location.</div>
        </div>
        <div class="mb-3">
            <div class="form-label">Pickup location</div>
            <div class="fw-semibold">@request.RequestedLocationName</div>
            <div class="form-text">Chosen by the requester. They are told this when you approve.</div>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label asp-for="DepartmentID" class="form-label">Department the units go to</label>
            <select asp-for="DepartmentID" asp-items="ViewBag.Departments" class="form-select">
                <option value="">-- Select Department --</option>
            </select>
            <div class="form-text">Pre-filled from the requester's own department.</div>
            <span asp-validation-for="DepartmentID" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PickupLocationID" class="form-label">Pickup location</label>
            <select asp-for="PickupLocationID" asp-items="ViewBag.PickupLocations" class="form-select">
                <option value="">-- Select Location --</option>
            </select>
            <div class="form-text">The requester left this to you. They are told where to collect the units when you approve.</div>
            <span asp-validation-for="PickupLocationID" class="text-danger"></span>
        </div>
    }

    <div class="mb-3">
        <label asp-for="Remarks" class="form-label">Remarks <span class="text-muted">(optional)</span></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Approve</button>
    <a asp-action="Details" asp-route-id="@Model.RequestID" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}