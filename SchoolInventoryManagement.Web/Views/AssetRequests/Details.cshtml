@model SchoolInventoryManagement.BLL.DTOs.AssetRequestResponseDTO
@using System.Text.RegularExpressions
@using SchoolInventoryManagement.BLL.DTOs
@using SchoolInventoryManagement.DAL.Constants
@using SchoolInventoryManagement.DAL.Entities.Enums
@inject SchoolInventoryManagement.Web.Helpers.AuditText AuditText
@{
    ViewData["Title"] = $"Request #{Model.RequestID}";

    var isApprover = User.IsInRole(RoleNames.AssetOfficer)
        || User.IsInRole(RoleNames.Administrator)
        || User.IsInRole(RoleNames.Principal);

    // Handing over and recording returns is narrower than approving:
    // Officers and Administrators only. The controller and service check it
    // too; this only decides which buttons show.
    var canManageAssets = User.IsInRole(RoleNames.AssetOfficer)
        || User.IsInRole(RoleNames.Administrator);

    var currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
    var isMine = Model.RequestedByUser.UserID == currentUserId;
    var isPending = Model.RequestStatus == RequestStatus.Pending;
    var isInTransit = Model.RequestStatus == RequestStatus.InTransit;
    var isAssigned = Model.RequestStatus == RequestStatus.Assigned;
    var isCancelled = Model.RequestStatus == RequestStatus.Cancelled;
    var isRejected = Model.RequestStatus == RequestStatus.Rejected;
    var isBorrow = Model.RequestType == RequestType.Borrow;
    var overdue = isAssigned && Model.ReturnBy < DateTime.Now;

    // A Transfer with no return date moves the units for good.
    var isPermanent = !isBorrow && Model.ReturnBy is null;

    // Pending: the requester can withdraw it. In Transit: an Officer or
    // Administrator can call it off before pickup or delivery. Both ask
    // for a reason first (AssetRequests/Cancel).
    var canCancel = (isPending && isMine) || (isInTransit && canManageAssets);

    // The list it was opened from: breadcrumb, back button, and the
    // sidebar item kept lit (see AssetRequestsController.Details).
    var section = ViewData["NavSection"] as string ?? (isMine ? "mine" : "approvals");
    var (backLabel, backAction) = section switch
    {
        "approvals" => ("Approvals", "Pending"),
        "history" => ("Request History", "History"),
        _ => ("My Requests", "MyRequests")
    };

    // Borrow: where the units are (or will be) collected. The approver's
    // pickup point once approved; before that, the requester's preference.
    var where = isBorrow ? Model.PickupLocationName ?? Model.RequestedLocationName : Model.RequestedLocationName;

    var statusLine = Model.RequestStatus switch
    {
        RequestStatus.Pending => "Waiting for an approver",
        RequestStatus.InTransit => isBorrow
            ? $"Approved · {Model.UnitsOut} unit{(Model.UnitsOut == 1 ? "" : "s")} waiting to be collected at {Model.PickupLocationName ?? "the pickup point"}"
            : $"Approved · {Model.UnitsOut} unit{(Model.UnitsOut == 1 ? "" : "s")} on the way to {Model.RequestedLocationName}",
        RequestStatus.Assigned => overdue
            ? $"Overdue · {Model.UnitsOut} unit{(Model.UnitsOut == 1 ? "" : "s")} still out, due back {Model.ReturnBy:MMM d}"
            : $"{(isBorrow ? "With the requester" : "Delivered")} · due back {Model.ReturnBy:MMM d}",
        RequestStatus.Returned => "Everything has come back",
        RequestStatus.Fulfilled when isPermanent => $"Delivered to {Model.RequestedLocationName} for good",
        RequestStatus.Rejected => "Rejected",
        RequestStatus.Cancelled => "Cancelled",
        _ => DisplayText.Humanize(Model.RequestStatus.ToString())
    };
    var statusCss = overdue || isRejected ? "is-red" : isPending || isCancelled ? "is-gray" : isInTransit ? "is-teal" : "is-green";

    var categories = ViewBag.ModelCategories as Dictionary<int, string>;
    var history = ViewBag.AuditHistory as List<AuditReportRowDTO>;
}

@functions {
    // A history entry's headline, from the raw audit text (the line under
    // it is the readable version from AuditText).
    static string Headline(AuditReportRowDTO row, AssetRequestResponseDTO r)
    {
        var raw = row.Description ?? "";
        var isBorrow = r.RequestType == RequestType.Borrow;
        switch (row.ActionPerformed)
        {
            case "AssetRequest Created":
                return $"Submitted the {r.RequestType.ToString().ToLowerInvariant()} request";
            case "AssetRequestItem Created":
                var m = Regex.Match(raw, @"Model: '([^']*)'; Quantity: '(\d+)'");
                return m.Success ? $"Added {m.Groups[1].Value} ×{m.Groups[2].Value}" : "Added an item";
            case "AssetAssignment Created":
                return $"Set aside {row.TargetAssetCode ?? "a unit"} for {r.RequestedByUser.FullName}";
            case "AssetAssignment Updated":
                // A permanent Transfer closes its assignments on delivery:
                // that is a hand-over, not a return.
                var handedOver = !isBorrow && r.ReturnBy is null;
                return raw.Contains("ReturnDate")
                    ? $"{(handedOver ? "Handed over" : "Returned")} {row.TargetAssetCode ?? "a unit"}"
                    : $"Updated {row.TargetAssetCode ?? "a unit"}";
            case "AssetRequest Updated":
                var s = Regex.Match(raw, @"RequestStatus: '\w*' -> '(\w+)'");
                if (!s.Success) return "Updated the request";
                return s.Groups[1].Value switch
                {
                    "Approved" => "Approved",
                    "InTransit" => isBorrow ? "Sent for pickup — now In transit" : "Sent — now In transit",
                    "Assigned" => isBorrow ? "Picked up" : "Delivered",
                    "Returned" => "Everything returned",
                    "Fulfilled" => "Delivered for good",
                    "Rejected" => "Rejected",
                    "Cancelled" => "Cancelled",
                    var other => DisplayText.Humanize(other)
                };
            default:
                return row.ActionPerformed;
        }
    }

    static string Kind(string action)
    {
        var last = action.Split(' ').LastOrDefault() ?? action;
        return last is "Created" or "Updated" or "Deleted" ? last : "Event";
    }
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="asset-detail-head">
    <div>
        <nav class="asset-crumbs" aria-label="Breadcrumb">
            <a asp-action="@backAction">@backLabel</a>
            <span aria-hidden="true">&rsaquo;</span>
            <span>#@Model.RequestID</span>
        </nav>
        <h2 class="asset-detail-title">@Model.RequestType request #@Model.RequestID</h2>
    </div>
</div>

<div class="asset-card rq-summary mb-3">
    <div class="rq-summary-top">
        <div class="rq-summary-pills">
            <span class="md-tag @(isBorrow ? "" : "is-transfer")">@Model.RequestType</span>
            <span class="asset-pill asset-status md-pill @(overdue ? "st-overdue" : isRejected ? "st-overdue" : isPending || isCancelled ? "st-disposed" : isInTransit ? "st-intransit" : "st-available")">@(overdue ? "Overdue" : DisplayText.Humanize(Model.RequestStatus.ToString()))</span>
            <span class="rq-status-line @statusCss">@statusLine</span>
        </div>
        <div class="rq-requester">
            <strong>@Model.RequestedByUser.FullName</strong>
            <span>· @Model.RequestedByUser.RoleName · @Model.DepartmentName</span>
        </div>
    </div>
    <dl class="rq-grid">
        <div><dt>@(isBorrow ? "Pickup location" : "Destination")</dt><dd>@(where ?? "Chosen when approved")</dd></div>
        <div><dt>Needed from</dt><dd>@(Model.NeededFrom?.ToString("MMM d, yyyy · h:mm tt") ?? "—")</dd></div>
        <div class="@(overdue ? "is-late" : "")"><dt>@(isBorrow ? "Return by" : "Comes back by")</dt><dd>@(isPermanent ? "Never · permanent" : Model.ReturnBy?.ToString("MMM d, yyyy · h:mm tt") ?? "—")</dd></div>
        <div><dt>Reason</dt><dd class="@(string.IsNullOrWhiteSpace(Model.Reason) ? "is-empty" : "")">@(string.IsNullOrWhiteSpace(Model.Reason) ? "None given" : Model.Reason)</dd></div>
    </dl>
    <dl class="rq-grid">
        <div><dt>Decided by</dt><dd class="@(Model.ApprovedByUser is null ? "is-empty" : "")">@(Model.ApprovedByUser?.FullName ?? "Not yet")</dd></div>
        <div><dt>Decided on</dt><dd class="@(Model.ApprovalDate is null ? "is-empty" : "")">@(Model.ApprovalDate?.ToString("MMM d, yyyy · h:mm tt") ?? "Not yet")</dd></div>
        <div><dt>@(isBorrow ? "Collected on" : "Delivered on")</dt><dd class="@(Model.AssignedDate is null ? "is-empty" : "")">@(Model.AssignedDate?.ToString("MMM d, yyyy · h:mm tt") ?? "Not yet")</dd></div>
        <div><dt>Returned on</dt><dd class="@(Model.ReturnedDate is null ? "is-empty" : "")">@(Model.ReturnedDate?.ToString("MMM d, yyyy · h:mm tt") ?? "Not yet")</dd></div>
    </dl>
    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <div class="rq-remarks @(isRejected || isCancelled ? "is-red" : "")">
            <span>@(isCancelled ? "Reason for cancelling" : isRejected ? "Reason for rejection" : "Remarks")</span>
            @Model.Remarks
        </div>
    }
</div>

@* ---- Items requested ---- *@
<div class="asset-card mb-3" data-pager data-page-size="6" data-noun="@(Model.Items.Count == 1 ? "model" : "models") · @Model.TotalQuantity unit@(Model.TotalQuantity == 1 ? "" : "s") in all">
    <div class="rq-card-head">
        <h3>Items requested</h3>
        <span>@Model.Items.Count model@(Model.Items.Count == 1 ? "" : "s") · @Model.TotalQuantity unit@(Model.TotalQuantity == 1 ? "" : "s")</span>
    </div>
    @if (Model.Items.Any())
    {
        <div class="rq-items">
            @foreach (var item in Model.Items)
            {
                var units = Model.Units.Where(u => u.ModelID == item.ModelID).ToList();
                var note = isPending ? "waiting for approval"
                    : isRejected ? "not approved"
                    : isCancelled ? "cancelled"
                    : units.Count == 0 ? "no units yet"
                    : units.All(u => u.ReturnDate != null) ? "returned"
                    : isInTransit ? (isBorrow ? "not collected yet" : "on the way")
                    : $"{units.Count(u => u.ReturnDate == null)} out";
                <div class="rq-item" data-pager-item>
                    <div class="min-w-0">
                        <div class="req-item-name fw-semibold">@item.ModelName</div>
                        @if (categories != null && categories.TryGetValue(item.ModelID, out var cat))
                        {
                            <div class="req-item-meta">@cat</div>
                        }
                    </div>
                    <div class="rq-item-qty">
                        <span>×@item.Quantity</span>
                        <small>@note</small>
                    </div>
                </div>
            }
        </div>
        <div class="rq-card-foot">
            <span data-pager-range></span>
            <div class="d-flex align-items-center" style="gap:8px;">
                <span class="text-muted">Show</span>
                <select class="form-select form-select-sm rq-size" data-pager-size aria-label="Items per page">
                    <option value="6" selected>6</option>
                    <option value="12">12</option>
                    <option value="24">24</option>
                </select>
                <span class="text-muted">per page</span>
                <div class="d-flex" style="gap:6px;" data-pager-buttons></div>
            </div>
        </div>
    }
    else
    {
        <div class="p-3">@Model.ItemsSummary</div>
    }
</div>

@* ---- Units handed out (from approval onwards) ---- *@
@if (Model.Units.Any())
{
    var waiting = Model.Units.Count(u => u.ReturnDate == null && isInTransit);
    var outNow = Model.Units.Count(u => u.ReturnDate == null && !isInTransit);
    var back = Model.Units.Count(u => u.ReturnDate != null);
    <div class="asset-card mb-3">
        <div class="rq-card-head">
            <h3>Units handed out
                @if (waiting > 0)
                {
                    <span class="rq-badge is-teal">@waiting waiting for @(isBorrow ? "pickup" : "delivery")</span>
                }
                @if (outNow > 0)
                {
                    <span class="rq-badge @(overdue ? "is-red" : "is-green")">@outNow out</span>
                }
                @if (back > 0)
                {
                    <span class="rq-badge is-gray">@back @(isCancelled ? "reservation cancelled" : "returned")</span>
                }
            </h3>
        </div>
        <div class="rq-units">
            @foreach (var unit in Model.Units)
            {
                <div class="rq-unit">
                    <a asp-controller="Assets" asp-action="Details" asp-route-id="@unit.AssetID" class="asset-code-chip">@unit.AssetCode</a>
                    <span class="rq-unit-name">@unit.AssetName</span>
                    @if (unit.ReturnDate is not null && isCancelled)
                    {
                        <span class="asset-pill asset-status md-pill st-disposed" title="@unit.ReturnDate.Value.ToString("MMM d, yyyy h:mm tt")">Cancelled</span>
                    }
                    else if (unit.ReturnDate is not null)
                    {
                        <span class="asset-pill asset-status md-pill st-available" title="@unit.ReturnDate.Value.ToString("MMM d, yyyy h:mm tt")">Returned</span>
                    }
                    else
                    {
                        <span class="asset-pill asset-status md-pill st-@unit.AssetStatus.ToString().ToLowerInvariant()">@DisplayText.Humanize(unit.AssetStatus.ToString())</span>
                    }
                </div>
            }
        </div>
    </div>
}

@* ---- History (only for the roles that can read the audit trail) ---- *@
@if (history != null)
{
    <div class="asset-card mb-3" data-pager data-page-size="10" data-noun="entr@(history.Count == 1 ? "y" : "ies")">
        <div class="rq-card-head">
            <h3>History</h3>
            <span>@history.Count entr@(history.Count == 1 ? "y" : "ies") · newest first</span>
        </div>
        @if (history.Any())
        {
            <div class="rq-history">
                <div class="rq-history-row rq-history-head" aria-hidden="true">
                    <span>When</span><span>By</span><span>What happened</span>
                </div>
                @foreach (var row in history)
                {
                    var kind = Kind(row.ActionPerformed);
                    <div class="rq-history-row" data-pager-item>
                        <span class="rq-when">@row.LogDateTime.ToString("MMM d · h:mm tt")</span>
                        <span class="rq-by">@row.UserName<small>@row.UserRole</small></span>
                        <span class="rq-what">
                            <span class="rq-what-title"><span class="rq-kind is-@kind.ToLowerInvariant()">@kind</span> @Headline(row, Model)</span>
                            @if (!string.IsNullOrWhiteSpace(row.Description))
                            {
                                <small>@(await AuditText.FormatAsync(row.Description))</small>
                            }
                        </span>
                    </div>
                }
            </div>
            <div class="rq-card-foot">
                <span data-pager-range></span>
                <div class="d-flex align-items-center" style="gap:8px;">
                    <span class="text-muted">Show</span>
                    <select class="form-select form-select-sm rq-size" data-pager-size aria-label="Entries per page">
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                    <span class="text-muted">per page</span>
                    <div class="d-flex" style="gap:6px;" data-pager-buttons></div>
                </div>
            </div>
        }
        else
        {
            <div class="sab-empty"><p class="mb-0">No recorded changes yet.</p></div>
        }
    </div>
}

@* ---- Actions ---- *@
<div class="register-footer rq-footer">
    <a asp-action="@backAction" class="btn btn-outline-secondary rq-back">&larr; @backLabel</a>
    <div class="d-flex flex-wrap" style="gap:8px;">
        @if (canCancel && isPending)
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancel-@Model.RequestID">Cancel request</button>
        }
        else if (canCancel)
        {
            @* In Transit: the Cancel page asks where each unit goes back. *@
            <a asp-action="Cancel" asp-route-id="@Model.RequestID" class="btn btn-outline-danger">Cancel request</a>
        }
        @if (isPending && isApprover)
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#reject-@Model.RequestID">Reject</button>
            <a asp-action="Approve" asp-route-id="@Model.RequestID" class="btn btn-primary">Approve</a>
        }
        @if (isInTransit && canManageAssets)
        {
            <form asp-action="MarkAssigned" asp-route-id="@Model.RequestID" method="post" class="d-inline"
                  onsubmit="return confirm('@(isBorrow ? "Confirm the requester has collected all the units?" : "Confirm all the units have arrived at the destination?")');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(Model.RowVersion)" />
                <button type="submit" class="btn btn-primary">@(isBorrow ? "Mark as picked up" : "Mark as delivered")</button>
            </form>
        }
        @* Only what was picked up or delivered can come back. Before that,
           the request is cancelled instead. *@
        @if (isAssigned && canManageAssets && Model.UnitsOut > 0)
        {
            <a asp-action="RecordReturn" asp-route-id="@Model.RequestID" class="btn btn-primary">Record return</a>
        }
    </div>
</div>

@* The Reject confirmation, outside the page's other forms. *@
@if (isPending)
{
    <partial name="_RejectRequestModal" model="Model" />
}
@if (canCancel && isPending)
{
    <partial name="_CancelRequestModal" model="Model" />
}
