@model SchoolInventoryManagement.BLL.DTOs.CreateLocationDTO
@{
    ViewData["Title"] = "New Location";
}

<h2>New Location</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="BranchID" class="form-label">Branch</label>
        <select asp-for="BranchID" asp-items="ViewBag.Branches" class="form-select">
            <option value="">-- Select Branch --</option>
        </select>
        <span asp-validation-for="BranchID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LocationName" class="form-label">Location Name</label>
        <input asp-for="LocationName" class="form-control" placeholder="e.g. Room 204, IT Storage" />
        <span asp-validation-for="LocationName" class="text-danger"></span>
    </div>

    <div class="mb-3" style="max-width:320px;">
        <label asp-for="LocationCode" class="form-label"></label>
        <input asp-for="LocationCode" id="locationCode" class="form-control text-uppercase" maxlength="3"
               placeholder="e.g. LIB or 204" autocomplete="off" />
        <span asp-validation-for="LocationCode" class="text-danger"></span>
        <div class="form-text">
            Exactly 3 letters or digits, unique within the branch. Barcodes made for assets here look like
            <span class="sab-code">M-<span id="codeExample">LIB</span>-CHR-0001</span>.
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description <span class="text-muted">(optional)</span></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_LocationCodeScript" />
}