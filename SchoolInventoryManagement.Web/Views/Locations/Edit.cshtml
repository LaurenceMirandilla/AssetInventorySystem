@model SchoolInventoryManagement.BLL.DTOs.UpdateLocationDTO
@{
    ViewData["Title"] = "Edit Location";
}

<h2>Edit Location</h2>

<form asp-action="Edit" asp-route-id="@ViewBag.LocationID" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="BranchID" class="form-label">Branch</label>
        <select asp-for="BranchID" asp-items="ViewBag.Branches" class="form-select">
            <option value="">-- Select Branch --</option>
        </select>
        <span asp-validation-for="BranchID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LocationName" class="form-label">Location Name</label>
        <input asp-for="LocationName" class="form-control" />
        <span asp-validation-for="LocationName" class="text-danger"></span>
    </div>

    <div class="mb-3" style="max-width:320px;">
        <label asp-for="LocationCode" class="form-label"></label>
        @if (ViewBag.CodeLocked == true)
        {
            <input asp-for="LocationCode" class="form-control" readonly />
            <div class="form-text">Locked while assets are in this location. Move them out to change it.</div>
        }
        else
        {
            <input asp-for="LocationCode" id="locationCode" class="form-control text-uppercase" maxlength="3" autocomplete="off" />
            <div class="form-text">
                Exactly 3 letters or digits, unique within the branch. Barcodes made for assets here look like
                <span class="sab-code">M-<span id="codeExample">LIB</span>-CHR-0001</span>.
            </div>
        }
        <span asp-validation-for="LocationCode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description <span class="text-muted">(optional)</span></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@if (ViewBag.AuditHistory is List<SchoolInventoryManagement.BLL.DTOs.AuditReportRowDTO> history)
{
    <partial name="_AuditHistory" model="history" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_LocationCodeScript" />
}