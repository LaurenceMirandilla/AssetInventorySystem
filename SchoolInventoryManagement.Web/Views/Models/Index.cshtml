@model List<SchoolInventoryManagement.BLL.DTOs.ModelDTO>
@using SchoolInventoryManagement.Web.Helpers
@{
    ViewData["Title"] = "Models";
    var usage = ViewBag.Usage as Dictionary<int, LookupUsage.ModelUsage> ?? new();
    var categories = ViewBag.CategoryList as List<SchoolInventoryManagement.BLL.DTOs.CategoryDTO> ?? new();
    var groups = Model.GroupBy(m => m.CategoryName).OrderBy(g => g.Key).ToList();
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="asset-detail-head mb-3 pb-0 border-0">
    <div>
        <h2 class="asset-detail-title">Models</h2>
        <div class="asset-detail-sub">@Model.Count model@(Model.Count == 1 ? "" : "s") across @groups.Count categor@(groups.Count == 1 ? "y" : "ies")</div>
    </div>
    <div class="asset-detail-actions">
        <a asp-action="Create" class="btn btn-primary">+ New model</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="sab-table-card">
        <div class="sab-empty">
            <div class="sab-empty-title">No models yet</div>
            <p>A model is a kind of item, like "Dutton Metal Folding Chair". Units are registered under it.</p>
            <a asp-action="Create" class="btn btn-primary">+ New model</a>
        </div>
    </div>
}
else
{
    <div class="sab-table-card myassets lk" data-md data-page-size="10" data-noun="models">
        <aside class="myassets-list" aria-label="Models">
            <div class="md-toolbar">
                <label class="asset-search">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                    <input type="text" data-md-search autocomplete="off" placeholder="Search models..." aria-label="Search models" />
                </label>
                <div class="dropdown">
                    <button type="button" class="asset-tool-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8.5V19l-4 2v-7.5z" /></svg>
                        Filters
                    </button>
                    <div class="dropdown-menu dropdown-menu-end md-filter-menu">
                        <label class="form-label">Category</label>
                        <select class="form-select form-select-sm" data-md-filter="cat" data-combobox>
                            <option value="">All categories</option>
                            @foreach (var c in Model.GroupBy(m => m.CategoryID).Select(g => (Id: g.Key, Name: g.First().CategoryName, Count: g.Count())).OrderBy(c => c.Name))
                            {
                                <option value="@c.Id">@c.Name (@c.Count)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            @foreach (var g in groups)
            {
                <div class="myassets-group" data-md-group>
                    <div class="myassets-group-label">@g.Key · <span data-md-count>@g.Count()</span></div>
                    @foreach (var m in g.OrderBy(m => m.ModelName))
                    {
                        var u = usage.GetValueOrDefault(m.ModelID);
                        <button type="button" class="myassets-item" data-entry="m-@m.ModelID" data-cat="@m.CategoryID"
                                data-search="@($"{m.ModelName} {m.CategoryName} {m.Description}".ToLowerInvariant())">
                            <span class="myassets-item-main">
                                <span class="myassets-item-title">@m.ModelName</span>
                                <span class="myassets-item-sub">@m.CategoryName</span>
                            </span>
                            <span class="lk-count">@(u?.Units ?? m.AssetCount)</span>
                        </button>
                    }
                </div>
            }
            <div class="myassets-nomatch" data-md-empty hidden>No model matches.</div>
            <div class="md-foot"><span data-md-range></span><div data-md-pager></div></div>
        </aside>

        <section class="myassets-detail">
            @foreach (var m in Model)
            {
                var u = usage.GetValueOrDefault(m.ModelID);
                var formId = "edit-m-" + m.ModelID;
                var units = u?.Units ?? m.AssetCount;
                <article class="myassets-panel" data-panel="m-@m.ModelID" hidden>
                    <button type="button" class="myassets-back" data-back>&larr; All models</button>
                    <h3 class="myassets-panel-title mt-0">@m.ModelName</h3>
                    <div class="lk-sub">@m.CategoryName · @units unit@(units == 1 ? "" : "s")</div>

                    <div class="myassets-stats lk-stats-4">
                        <div>
                            <span>Units</span><strong>@units</strong>
                            <a asp-controller="Assets" asp-action="Index" asp-route-modelId="@m.ModelID" class="lk-link">View assets &rarr;</a>
                        </div>
                        <div><span>Available</span><strong>@(u?.Available ?? m.AvailableCount)</strong></div>
                        <div><span>Out now</span><strong>@(u?.OutNow ?? 0)</strong></div>
                        <div><span>Open requests</span><strong>@(u?.OpenRequests ?? 0)</strong></div>
                    </div>

                    <div class="asset-card register-step mt-3">
                        <div class="register-step-head">
                            <div class="register-step-title flex-grow-1">Details</div>
                            <span class="nr-head-note">edit and save</span>
                        </div>
                        <form asp-action="Edit" asp-route-id="@m.ModelID" method="post" id="@formId" class="register-step-body">
                            @Html.AntiForgeryToken()
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-name">Name</label>
                                    <input id="@formId-name" name="ModelName" value="@m.ModelName" class="form-control" maxlength="150" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="@formId-cat">Category</label>
                                    <select id="@formId-cat" name="CategoryID" class="form-select" required>
                                        @foreach (var c in categories)
                                        {
                                            <option value="@c.CategoryID" selected="@(c.CategoryID == m.CategoryID)">@c.CategoryName</option>
                                        }
                                    </select>
                                    <div class="form-text">New units use the category code prefix.</div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="@formId-desc">Description <span class="register-optional">optional</span></label>
                                    <textarea id="@formId-desc" name="Description" class="form-control" rows="2" maxlength="500">@m.Description</textarea>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="lk-foot">
                        <form asp-action="Delete" asp-route-id="@m.ModelID" method="post" onsubmit="return confirm('Delete @m.ModelName?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger" disabled="@(u?.Blocked is not null)">Delete</button>
                        </form>
                        <span class="lk-why">@(u?.Blocked ?? "Nothing uses it yet.")</span>
                        <div class="lk-foot-actions">
                            <button type="reset" form="@formId" class="btn btn-outline-secondary">Discard changes</button>
                            <button type="submit" form="@formId" class="btn btn-primary">Save changes</button>
                        </div>
                    </div>
                </article>
            }
        </section>
    </div>
}
