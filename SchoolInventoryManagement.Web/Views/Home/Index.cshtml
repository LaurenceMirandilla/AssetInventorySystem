@model SchoolInventoryManagement.Web.ViewModels.HomeDashboardViewModel
@{
    ViewData["Title"] = "Home";
}

@if (!Model.IsReportsViewer)
{
    @* The personal half of the dashboard. Same tiles, cards and type scale
       as the inventory half below -- only the figures differ, because these
       roles are scoped to their own records. *@
    <h2 class="mb-0">Good morning, @Model.DisplayName</h2>
    <p class="text-muted mb-3">@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>

    <div class="report-tiles">
        <a asp-controller="Assets" asp-action="MyAssets" class="report-tile text-decoration-none">
            <span class="report-tile-value">@Model.AssetsInMyCare</span>
            <span class="report-tile-label">Assets in my care</span>
            <span class="report-tile-note">signed out to you right now</span>
        </a>
        <a asp-controller="AssetRequests" asp-action="MyRequests" class="report-tile text-decoration-none">
            <span class="report-tile-value">@Model.MyOpenRequestCount</span>
            <span class="report-tile-label">Open requests</span>
            <span class="report-tile-note">pending or approved</span>
        </a>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">My recent requests</h5>
                        <a asp-controller="AssetRequests" asp-action="MyRequests" class="small">View all</a>
                    </div>

                    @if (Model.MyRecentRequests.Any())
                    {
                        @foreach (var request in Model.MyRecentRequests)
                        {
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div>
                                    <div class="fw-semibold">
                                        @request.ItemsSummary
                                        @if (request.RequestType == SchoolInventoryManagement.DAL.Entities.Enums.RequestType.Transfer)
                                        {
                                            <text> &rarr; @request.RequestedLocationName</text>
                                        }
                                    </div>
                                    <div class="text-muted small">
                                        <span class="status-pill status-@request.RequestType.ToString().ToLowerInvariant()">@request.RequestType</span>
                                        <span class="ms-1">@request.RequestDate.ToString("MMM d, yyyy")</span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center" style="gap:12px;">
                                    <span class="status-pill status-@request.RequestStatus.ToString().ToLowerInvariant()">@DisplayText.Humanize(request.RequestStatus.ToString())</span>
                                    <a asp-controller="AssetRequests" asp-action="Details" asp-route-id="@request.RequestID" class="small">View</a>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">You haven't submitted any requests yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="mb-1">Need something?</h5>
                    <p class="text-muted small">
                        <strong>Borrow</strong> asks for models and how many of each;
                        staff pick the units. <strong>Transfer</strong> asks for them to
                        be moved to another location. Either way an approver decides.
                    </p>
                    <a asp-controller="AssetRequests" asp-action="Create" class="btn btn-primary w-100">+ New Request</a>
                    <a asp-controller="Assets" asp-action="MyAssets" class="btn btn-outline-secondary w-100 mt-2">See what I'm holding</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h2 class="mb-0">Good morning, @Model.DisplayName</h2>
    <p class="text-muted mb-3">@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>

    <div class="report-tiles">
        <div class="report-tile">
            <span class="report-tile-value">@Model.TotalAssets</span>
            <span class="report-tile-label">Registered assets</span>
        </div>
        <div class="report-tile">
            <span class="report-tile-value">@Model.CurrentlyIssued</span>
            <span class="report-tile-label">Currently issued</span>
        </div>
        <div class="report-tile">
            <span class="report-tile-value">@Model.UnderMaintenanceCount</span>
            <span class="report-tile-label">Under maintenance</span>
        </div>
        <div class="report-tile">
            <span class="report-tile-value">@Model.ValueInService.ToString("C0")</span>
            <span class="report-tile-label">Value in service</span>
            <span class="report-tile-note">excludes disposed units</span>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">Needs your attention</h5>
                        <a asp-controller="AssetRequests" asp-action="Pending" class="small">View all</a>
                    </div>

                    @if (Model.PendingRequestCount > 0)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div>
                                <div class="fw-semibold">Requests awaiting your decision</div>
                                <div class="text-muted small">@Model.PendingRequestCount pending</div>
                            </div>
                            <a asp-controller="AssetRequests" asp-action="Pending" class="btn btn-sm btn-outline-secondary">Review</a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Nothing is waiting on you right now.</p>
                    }

                    @* The mockup also shows "assets out 90+ days", "in maintenance
                       since <date>" and "missing serial number" rows. Those
                       aren't computed anywhere in IReportService yet — happy to
                       add the queries for them next rather than show fake counts. *@
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="mb-3">Assets by category</h5>

                    @{
                        var maxCount = Model.ByCategory.Any() ? Model.ByCategory.Max(c => c.Count) : 1;
                    }

                    @foreach (var row in Model.ByCategory)
                    {
                        var pct = maxCount == 0 ? 0 : (int)Math.Round(100.0 * row.Count / maxCount);
                        <div class="d-flex align-items-center mb-2" style="gap:10px;">
                            <span class="text-muted small" style="width:110px; flex-shrink:0;">@row.Label</span>
                            <div style="flex:1 1 auto; background:var(--sab-bg); border-radius:4px; height:10px;">
                                <div style="width:@(pct)%; background:var(--sab-green); height:10px; border-radius:4px;"></div>
                            </div>
                            <span class="fw-semibold small" style="width:32px; text-align:right;">@row.Count</span>
                        </div>
                    }

                    @if (!Model.ByCategory.Any())
                    {
                        <p class="text-muted mb-0">No assets registered yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="mb-3">Recent activity</h5>

                    @if (Model.RecentActivity.Any())
                    {
                        @foreach (var entry in Model.RecentActivity)
                        {
                            <div class="d-flex mb-3" style="gap:10px;">
                                <span class="sab-avatar" style="width:28px;height:28px;font-size:0.68rem;">
                                    @string.Concat(entry.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => p[0])).ToUpperInvariant()
                                </span>
                                <div>
                                    <div class="small">
                                        <strong>@entry.UserName</strong> — @entry.ActionPerformed
                                        @if (!string.IsNullOrWhiteSpace(entry.TargetAssetCode))
                                        {
                                            <code>@entry.TargetAssetCode</code>
                                        }
                                    </div>
                                    <div class="text-muted small">@entry.LogDateTime.ToString("MMM d, h:mm tt")</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No recent activity.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}