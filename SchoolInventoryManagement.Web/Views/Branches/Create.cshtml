@model SchoolInventoryManagement.BLL.DTOs.CreateBranchDTO
@{
    ViewData["Title"] = "New Branch";
}

<h2>New Branch</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="BranchName" class="form-label"></label>
        <input asp-for="BranchName" class="form-control" />
        <span asp-validation-for="BranchName" class="text-danger"></span>
    </div>

    <div class="mb-3" style="max-width:320px;">
        <label asp-for="BranchCode" class="form-label"></label>
        <input asp-for="BranchCode" class="form-control text-uppercase" maxlength="1" placeholder="e.g. M" autocomplete="off" />
        <span asp-validation-for="BranchCode" class="text-danger"></span>
        <div class="form-text">One letter, unique. Starts every barcode made in this branch: <span class="sab-code">M-LIB-CHR-0001</span>.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label">Address <span class="text-muted">(optional)</span></label>
        <textarea asp-for="Address" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="ContactInfo" class="form-label">Contact Info <span class="text-muted">(optional)</span></label>
        <input asp-for="ContactInfo" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
