@using SchoolInventoryManagement.BLL.Services
@* Reset password, as a dialog over the Users list or Edit user. One
   dialog, filled in from the button that opened it (data-reset-url,
   -name, -username, -role, -version). Posts to Users/ResetPassword; if
   that fails (rules not met, or the account changed meanwhile), the full
   Reset password page shows why. They choose their own at next sign-in. *@
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered cancel-dialog">
        <form method="post" class="modal-content cancel-modal" id="resetPasswordForm" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="RowVersionBase64" id="resetVersion" />

            <div class="cancel-head">
                <div class="flex-grow-1 min-w-0">
                    <h3 class="cancel-title" id="resetPasswordTitle">Reset password</h3>
                    <div class="cancel-meta" id="resetWho"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body cancel-body">
                <label class="form-label" for="resetNew">New password</label>
                <div class="d-flex mb-3" style="gap:8px;">
                    <div class="input-icon flex-grow-1">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                        <input type="text" name="NewPassword" id="resetNew" class="form-control" autocomplete="new-password" spellcheck="false"
                               required minlength="@PasswordPolicy.MinLength" />
                    </div>
                    <button type="button" class="btn btn-outline-secondary" id="resetGenerate">Generate</button>
                </div>

                <label class="form-label" for="resetConfirm">Confirm new password</label>
                <div class="input-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                    <input type="text" name="ConfirmPassword" id="resetConfirm" class="form-control" autocomplete="new-password" spellcheck="false" required />
                </div>
                <div class="pw-match" id="resetMatch" hidden></div>
                <div class="text-danger small mt-1" id="resetError" hidden></div>

                <div class="state-note mt-3 mb-0">
                    Their old password stops working right away. Give them the new one in person; they'll choose their own the next time they sign in.
                </div>
            </div>

            <div class="cancel-foot justify-content-end">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Go back</button>
                <button type="submit" class="btn btn-primary">Reset password</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var modal = document.getElementById('resetPasswordModal');
        if (!modal) return;
        var form = document.getElementById('resetPasswordForm');
        var pw = document.getElementById('resetNew');
        var again = document.getElementById('resetConfirm');
        var match = document.getElementById('resetMatch');
        var error = document.getElementById('resetError');

        // Easy to read out and type: Tq7-mango-42.
        var words = ['mango', 'river', 'cedar', 'pearl', 'lotus', 'amber', 'maple', 'coral', 'tiger', 'olive', 'plaza', 'sunny'];
        function pick(s) { return s[Math.floor(Math.random() * s.length)]; }
        document.getElementById('resetGenerate').addEventListener('click', function () {
            var p = pick('ABCDEFGHJKLMNPQRSTUVWXYZ') + pick('abcdefghjkmnpqrstuvwxyz') + pick('23456789') + '-' +
                pick(words) + '-' + (10 + Math.floor(Math.random() * 90));
            pw.value = p;
            again.value = p;
            sync();
        });

        function sync() {
            error.hidden = true;
            if (!again.value) { match.hidden = true; return; }
            var same = again.value === pw.value;
            match.hidden = false;
            match.className = 'pw-match ' + (same ? 'is-met' : 'is-unmet');
            match.textContent = same ? 'Matches' : 'Doesn’t match yet';
        }
        pw.addEventListener('input', sync);
        again.addEventListener('input', sync);

        modal.addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget;
            if (!b) return;
            form.action = b.getAttribute('data-reset-url');
            document.getElementById('resetVersion').value = b.getAttribute('data-reset-version');
            document.getElementById('resetWho').textContent = b.getAttribute('data-reset-role') + ' · ' + b.getAttribute('data-reset-username');
            document.getElementById('resetPasswordTitle').textContent = 'Reset password for ' + b.getAttribute('data-reset-name') + '?';
            form.reset();
            match.hidden = true;
            error.hidden = true;
        });
        modal.addEventListener('shown.bs.modal', function () { pw.focus(); });

        // The same rules the server checks, said before posting.
        form.addEventListener('submit', function (e) {
            var problem = pw.value.length < 8 ? 'Use at least 8 characters.'
                : !/[0-9]/.test(pw.value) ? 'Include at least one number.'
                : pw.value !== again.value ? 'The two passwords don’t match.' : '';
            if (problem) {
                e.preventDefault();
                error.textContent = problem;
                error.hidden = false;
            }
        });
    });
</script>
