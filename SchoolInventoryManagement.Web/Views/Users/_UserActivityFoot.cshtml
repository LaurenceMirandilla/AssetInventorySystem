@* The pager row under each of the Users page's activity tabs. *@
<div class="history-foot">
    <span data-pager-range></span>
    <div class="d-flex align-items-center flex-wrap" style="gap:8px;">
        <span class="text-muted">Show</span>
        <select class="form-select form-select-sm rq-size" data-pager-size aria-label="Rows per page">
            <option value="10" selected>10</option>
            <option value="20">20</option>
            <option value="50">50</option>
        </select>
        <span class="text-muted">per page</span>
        <div class="d-flex flex-wrap" style="gap:6px;" data-pager-buttons></div>
    </div>
</div>
