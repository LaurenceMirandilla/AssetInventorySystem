@model SchoolInventoryManagement.Web.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    // Signed in on a starting password: this is the only page open to them.
    var mustChange = ViewBag.MustChange is bool must && must;
}

@* The rules (8+ characters, a number, not the current password) are
   checked on the server: the view model's attributes, the controller and
   UserService (PasswordPolicy). The checklist and meter below only show
   them as you type. *@

@functions {
    // Lock icon at the start of each box.
    static Microsoft.AspNetCore.Html.HtmlString Lock() => new(
        "<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\" /><path d=\"M8 11V7a4 4 0 0 1 8 0v4\" /></svg>");
}

<form asp-action="ChangePassword" method="post" class="register-form page-fill" id="changePasswordForm" novalidate>
    @Html.AntiForgeryToken()

    <div class="asset-detail-head">
        <div>
            <nav class="asset-crumbs" aria-label="Breadcrumb">
                <span class="asset-crumb-root">Account</span>
                <span aria-hidden="true">&rsaquo;</span>
                <span>Change password</span>
            </nav>
            <h2 class="asset-detail-title">Change password</h2>
            <div class="asset-detail-sub">For your own account. You stay signed in after changing it.</div>
            @if (mustChange)
            {
                <div class="sab-callout sab-callout-warn mt-3">
                    <span class="sab-callout-label">Choose your own password to continue</span>
                    You signed in with a starting password. Type it as your current password, then pick a new one.
                    The rest of the app opens once it's changed.
                </div>
            }
        </div>
    </div>

    <div class="asset-card pw-card">
        <div class="asset-card-title">Your password</div>
        <div class="register-step-body">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <div class="input-icon">
                    @Lock()
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" id="currentPassword" />
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small d-block"></span>
            </div>

            <div class="mb-2">
                <label asp-for="NewPassword" class="form-label"></label>
                <div class="input-icon">
                    @Lock()
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" id="newPassword"
                           aria-describedby="pwRules" />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small d-block"></span>
            </div>

            @* Strength: four bars. Display only. *@
            <div class="pw-meter" id="pwMeter" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
            </div>
            <ul class="pw-rules" id="pwRules" aria-live="polite">
                <li data-rule="length">At least 8 characters</li>
                <li data-rule="number">Has a number</li>
                <li data-rule="different">Different from your current password</li>
            </ul>

            <div class="mb-1">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <div class="input-icon">
                    @Lock()
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" id="confirmPassword" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small d-block"></span>
            </div>
            <div class="pw-match" id="pwMatch" aria-live="polite" hidden></div>
        </div>
    </div>

    <div class="register-footer">
        <div class="d-flex ms-auto" style="gap:8px;">
            @if (mustChange)
            {
                <button type="submit" form="signOutForm" class="btn btn-outline-secondary">Sign out</button>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            }
            <button type="submit" class="btn btn-primary">Change password</button>
        </div>
    </div>
</form>

@* Outside the password form: "Sign out" posts this one. *@
<form asp-controller="Account" asp-action="Logout" method="post" id="signOutForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            var current = document.getElementById('currentPassword');
            var next = document.getElementById('newPassword');
            var confirm = document.getElementById('confirmPassword');
            var bars = document.querySelectorAll('#pwMeter span');
            var meter = document.getElementById('pwMeter');
            var match = document.getElementById('pwMatch');

            function rule(name, ok, active) {
                var li = document.querySelector('#pwRules [data-rule="' + name + '"]');
                li.classList.toggle('is-met', ok);
                li.classList.toggle('is-unmet', active && !ok);
            }

            function update() {
                var pw = next.value;
                var typed = pw.length > 0;
                var length = pw.length >= 8;
                var number = /[0-9]/.test(pw);
                var different = typed && pw !== current.value;

                rule('length', length, typed);
                rule('number', number, typed);
                rule('different', different, typed);

                // One bar each: long enough, a number, upper and lower case,
                // and a symbol or 12+ characters.
                var score = !typed ? 0
                    : (length ? 1 : 0) + (number ? 1 : 0)
                      + (/[a-z]/.test(pw) && /[A-Z]/.test(pw) ? 1 : 0)
                      + (/[^A-Za-z0-9]/.test(pw) || pw.length >= 12 ? 1 : 0);
                if (typed && score === 0) score = 1;
                meter.className = 'pw-meter' + (score ? ' is-' + (score <= 1 ? 'weak' : score === 2 ? 'fair' : 'good') : '');
                bars.forEach(function (bar, i) { bar.classList.toggle('is-on', i < score); });

                if (!confirm.value) {
                    match.hidden = true;
                } else {
                    var same = confirm.value === pw;
                    match.hidden = false;
                    match.className = 'pw-match ' + (same ? 'is-met' : 'is-unmet');
                    match.textContent = same ? 'Matches' : 'Doesn’t match yet';
                }
            }

            [current, next, confirm].forEach(function (input) { input.addEventListener('input', update); });
            update();
        })();
    </script>
}
