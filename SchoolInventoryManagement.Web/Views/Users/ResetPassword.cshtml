@model SchoolInventoryManagement.Web.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h2 class="mb-1">Reset Password</h2>
        <p class="text-muted">
            @Model.UserFullName &mdash; @Model.Username
        </p>

        <div class="alert alert-warning">
            You are setting this password on someone else's behalf. Hand it to
            them directly. They'll be asked to choose their own the next time they
            sign in, since this is a password you know and they didn't choose.
        </div>

        <form asp-action="ResetPassword" asp-route-id="@Model.UserID" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="RowVersionBase64" />

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least 8 characters, with a number.</div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Reset Password</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
