@* Shared by Create and Edit: keeps the category code upper-case, three
   letters only, and shows what asset codes will look like. The service
   checks the same rules. *@
<script>
    (function () {
        var input = document.getElementById('codePrefix');
        var example = document.getElementById('codeExample');
        if (!input || !example) return;

        function sync() {
            var clean = input.value.toUpperCase().replace(/[^A-Z]/g, '').slice(0, 3);
            if (clean !== input.value) input.value = clean;
            example.textContent = (clean || 'CHR') + '-0001';
        }

        input.addEventListener('input', sync);
        sync();
    })();
</script>