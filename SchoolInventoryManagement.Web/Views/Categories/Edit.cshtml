@model SchoolInventoryManagement.BLL.DTOs.UpdateCategoryDTO
@using SchoolInventoryManagement.Web.Helpers
@inject LookupUsage Usage
@{
    ViewData["Title"] = "Edit Category";
    var recordId = (int)ViewBag.CategoryID;
    var usage = (await Usage.CategoriesAsync()).GetValueOrDefault(recordId);
}

<form asp-action="Edit" asp-route-id="@recordId" method="post" class="register-form page-fill" id="lkForm">
    @Html.AntiForgeryToken()

    <div class="asset-detail-head">
        <div>
            <nav class="asset-crumbs" aria-label="Breadcrumb">
                <a asp-action="Index">Categories</a>
                <span aria-hidden="true">&rsaquo;</span>
                <a href="@Url.Action("Index")#c-@recordId">@Model.CategoryName</a>
                <span aria-hidden="true">&rsaquo;</span>
                <span>Edit</span>
            </nav>
            <h2 class="asset-detail-title">Edit category</h2>
            <div class="asset-detail-sub">Groups models. Its code prefix starts every asset code in it.</div>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3 align-items-start">
        <div class="col-lg-8">
            <div class="asset-card register-step">
                <div class="register-step-head"><div class="register-step-title">Details</div></div>
                <div class="register-step-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CategoryName" class="form-label">Name</label>
                            <input asp-for="CategoryName" class="form-control" maxlength="100" placeholder="e.g. Whiteboards" />
                            <span asp-validation-for="CategoryName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CodePrefix" class="form-label">Code prefix</label>
                            <input asp-for="CodePrefix" class="form-control text-uppercase" id="codePrefix" maxlength="3" autocomplete="off" placeholder="e.g. WBD" />
                            <div class="form-text">Exactly 3 letters. Must be unique.</div>
                            <span asp-validation-for="CodePrefix" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Description <span class="register-optional">optional</span></label>
                            <textarea asp-for="Description" class="form-control" rows="3" maxlength="255" placeholder="e.g. Magnetic and dry-erase boards for classrooms."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="asset-card register-step lk-side">
                <div class="register-step-head"><div class="register-step-title">Asset codes</div></div>
                <div class="register-step-body">
                    <div class="lk-code-box">
                        <div class="lk-code-label">New assets will be</div>
                        <div class="lk-code-big" id="codeExample">@(usage?.NextCode ?? "")</div>
                    </div>
                    <p class="lk-side-note">Changing the prefix only affects new assets; codes already on labels stay as they are.</p>
                    <a href="@Url.Action("Index", "Models")" class="lk-link">View its models &rarr;</a>
                </div>
            </div>
        </div>
    </div>

    <div class="register-footer">
        <div class="d-flex align-items-center flex-wrap" style="gap:10px;">
            <button type="submit" form="lkDelete" class="btn btn-outline-danger" disabled="@(usage?.Blocked is not null)">Delete</button>
            <span class="lk-why">@(usage?.Blocked ?? "Nothing uses it yet.")</span>
        </div>
        <div class="d-flex ms-auto" style="gap:8px;">
            <a href="@Url.Action("Index")#c-@recordId" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </div>
</form>

@* Outside the edit form: a form can't hold another. *@
<form asp-action="Delete" asp-route-id="@recordId" method="post" id="lkDelete" onsubmit="return confirm('Delete this category? This can\'t be undone.');">
    @Html.AntiForgeryToken()
</form>

@if (ViewBag.AuditHistory is List<SchoolInventoryManagement.BLL.DTOs.AuditReportRowDTO> history)
{
    <partial name="_AuditHistory" model="history" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Prefix: upper case, 3 letters; the example code follows it.
        (function () {
            var input = document.getElementById('codePrefix');
            var example = document.getElementById('codeExample');
            var fixedExample = true;
            if (!input) return;
            function sync() {
                var clean = input.value.toUpperCase().replace(/[^A-Z]/g, '').slice(0, 3);
                if (clean !== input.value) input.value = clean;
                if (!fixedExample && example) example.textContent = (clean || 'WBD') + '-0001';
            }
            input.addEventListener('input', sync);
            sync();
        })();
    </script>
}
