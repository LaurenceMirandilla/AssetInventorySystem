@model SchoolInventoryManagement.Web.ViewModels.TransferAssetViewModel
@{
    ViewData["Title"] = "Transfer Asset";
}

<h2>Transfer Asset</h2>
<p class="text-muted">
    @ViewBag.AssetCode — @ViewBag.AssetName
    (currently at @(ViewBag.CurrentLocationName ?? "no recorded location"))
</p>

<form asp-action="Transfer" asp-route-id="@Model.AssetID" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="AssetID" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="DestinationLocationID" class="form-label">Move to</label>
        <select asp-for="DestinationLocationID" asp-items="ViewBag.Locations" class="form-select">
            <option value="">-- Select Location --</option>
        </select>
        <span asp-validation-for="DestinationLocationID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ReasonForTransfer" class="form-label">Reason for transfer</label>
        <textarea asp-for="ReasonForTransfer" class="form-control"></textarea>
        <span asp-validation-for="ReasonForTransfer" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConditionOnTransfer" class="form-label">
            Condition at transfer <span class="text-muted">(optional)</span>
        </label>
        <select asp-for="ConditionOnTransfer"
                asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.ConditionStatus>()"
                class="form-select">
            <option value="">-- Leave unchanged --</option>
        </select>
        <div class="form-text">Leaving this blank keeps the condition already on record.</div>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Notes <span class="text-muted">(optional)</span></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Confirm Transfer</button>
    <a asp-controller="Assets" asp-action="Details" asp-route-id="@Model.AssetID" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
