@model SchoolInventoryManagement.BLL.DTOs.CreateSupplyDTO
@using SchoolInventoryManagement.Web.Helpers
@using SchoolInventoryManagement.Web.ViewModels
@using SchoolInventoryManagement.DAL.Entities.Enums
@{
    ViewData["Title"] = "New Supply";
    var categories = ViewBag.SupplyCategories as List<SupplyOption> ?? new();
    var locations = ViewBag.Locations as List<SupplyLocationOption> ?? new();
    var units = ViewBag.Units as List<string> ?? new();
    var commonUnits = new[] { "piece", "box", "ream", "bottle", "pack", "roll", "set", "gallon" };
    var departments = ViewBag.Departments as List<SupplyDepartmentOption> ?? new();
    // Opened from an arrived new-item request: a supply new to the school.
    var fromRequest = ViewBag.FromRequest as SupplyFromRequest;
}

<form asp-action="Create" method="post" class="register-form page-fill" id="supplyForm">
    @Html.AntiForgeryToken()
    @Html.FormTicket()
    <input type="hidden" asp-for="NewItemRequestItemID" />

    <div class="asset-detail-head">
        <div>
            <nav class="asset-crumbs" aria-label="Breadcrumb">
                <a asp-controller="Assets" asp-action="Index">Items</a>
                <span aria-hidden="true">&rsaquo;</span>
                <a asp-action="Index">Supplies</a>
                <span aria-hidden="true">&rsaquo;</span>
                <span>New supply</span>
            </nav>
            <h2 class="asset-detail-title">New supply</h2>
            <div class="asset-detail-sub">Something that gets used up. It is counted by quantity, so it has no code, serial number or holder.</div>
        </div>
    </div>

    @if (fromRequest is not null)
    {
        <div class="sab-callout mb-3">
            <span class="sab-callout-label">New-item request #@fromRequest.RequestId</span>
            Filled in from the request. The opening quantity is what arrived: it goes into the Property Department's stock, and is handed to the @fromRequest.DepartmentName when the request is marked delivered.
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (!categories.Any())
    {
        <div class="alert alert-warning">
            There are no supply categories yet. <a asp-controller="Categories" asp-action="Create" asp-route-kind="@CategoryKind.Supply">Add one first</a>, for example "Office supplies".
        </div>
    }

    <div class="row g-3 align-items-start">
        <div class="col-lg-8">
            <div class="asset-card register-step mb-3">
                <div class="register-step-head"><div class="register-step-title">What it is</div></div>
                <div class="register-step-body">
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="SupplyName" class="form-label">Name</label>
                            <input asp-for="SupplyName" class="form-control" id="supplyName" maxlength="150" autocomplete="off" placeholder="e.g. Masking tape, 1 inch" />
                            <span asp-validation-for="SupplyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="CategoryID" class="form-label">Category</label>
                            <select asp-for="CategoryID" class="form-select">
                                <option value="">Pick a category</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryID" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Unit" class="form-label">Counted per</label>
                            <input asp-for="Unit" class="form-control" id="supplyUnit" maxlength="30" autocomplete="off" list="unitList" placeholder="e.g. box" />
                            <datalist id="unitList">
                                @foreach (var u in units.Concat(commonUnits).Distinct(StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="@u"></option>
                                }
                            </datalist>
                            <div class="form-text">The unit people ask for it in.</div>
                            <span asp-validation-for="Unit" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="UnitPrice" class="form-label">Price paid per unit <span class="register-optional">optional</span></label>
                            <div class="input-group">
                                <span class="input-group-text">&#8369;</span>
                                <input asp-for="UnitPrice" class="form-control" id="supplyPrice" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00" />
                            </div>
                            <div class="form-text">What the opening quantity cost each. Later deliveries have their own price; the supply shows the average.</div>
                            <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Description <span class="register-optional">optional</span></label>
                            <textarea asp-for="Description" class="form-control" rows="2" maxlength="255" placeholder="Brand or size notes."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="asset-card register-step">
                <div class="register-step-head"><div class="register-step-title">Stock</div></div>
                <div class="register-step-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="OpeningQuantity" class="form-label">Opening quantity</label>
                            <input asp-for="OpeningQuantity" class="form-control" id="supplyQty" type="number" min="0" step="1" inputmode="numeric" />
                            <div class="form-text">How many are on the shelf right now.</div>
                            <span asp-validation-for="OpeningQuantity" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="LocationID" class="form-label">Kept in</label>
                            <select asp-for="LocationID" class="form-select" id="supplyLocation">
                                <option value="">Pick a location</option>
                                @foreach (var g in locations.GroupBy(l => l.BranchName))
                                {
                                    <optgroup label="@g.Key">
                                        @foreach (var l in g)
                                        {
                                            <option value="@l.Id" data-branch="@l.BranchId">@l.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <div class="form-text">The storage room.</div>
                            <span asp-validation-for="LocationID" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="LowStockLevel" class="form-label">Low-stock level, per branch</label>
                            <input asp-for="LowStockLevel" class="form-control" id="supplyLow" type="number" min="0" step="1" inputmode="numeric" />
                            <div class="form-text">At or below this it reads "Running low". 0 turns the warning off.</div>
                            <span asp-validation-for="LowStockLevel" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="DepartmentID" class="form-label">Belongs to</label>
                            <select asp-for="DepartmentID" class="form-select" id="supplyDepartment" disabled="@(fromRequest is not null)">
                                <option value="">Property Department (in stock, can be requested)</option>
                                @foreach (var g in fromRequest is null ? departments.GroupBy(d => d.BranchName) : Enumerable.Empty<IGrouping<string, SupplyDepartmentOption>>())
                                {
                                    <optgroup label="@g.Key">
                                        @foreach (var d in g)
                                        {
                                            <option value="@d.Id" data-branch="@d.BranchId">@d.Name (its own, not requested)</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <div class="form-text">Supplies are requested from the Property Department. Pick another department only for stock it keeps for itself, in a room of its branch.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="asset-card register-step lk-side">
                <div class="register-step-head"><div class="register-step-title">How it will appear</div></div>
                <div class="register-step-body">
                    <div class="lk-code-box">
                        <div class="lk-code-label" id="pvName">New supply</div>
                        <div class="lk-code-big" id="pvQty">0</div>
                    </div>
                    <p class="lk-side-note mb-2"><span class="asset-pill asset-status st-overdue" id="pvStatus">Out of stock</span></p>
                    <p class="lk-side-note" id="pvWhere">Pick where it is kept.</p>
                    <p class="lk-side-note" id="pvValue" hidden></p>
                </div>
            </div>
        </div>
    </div>

    <div class="register-footer">
        <div class="d-flex ms-auto" style="gap:8px;">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary" disabled="@(!categories.Any())">Save supply</button>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // The preview card follows what is typed.
        (function () {
            var el = function (id) { return document.getElementById(id); };
            var name = el('supplyName'), unit = el('supplyUnit'), qty = el('supplyQty'),
                low = el('supplyLow'), price = el('supplyPrice'), where = el('supplyLocation');

            // Belongs to: only departments of the room's branch.
            var dept = el('supplyDepartment');
            function followRoom() {
                var opt = where.options[where.selectedIndex];
                var branch = opt ? opt.getAttribute('data-branch') : null;
                Array.from(dept.querySelectorAll('option[data-branch]')).forEach(function (o) {
                    o.hidden = o.disabled = !branch || o.getAttribute('data-branch') !== branch;
                });
                Array.from(dept.querySelectorAll('optgroup')).forEach(function (g) {
                    g.hidden = !Array.from(g.children).some(function (o) { return !o.hidden; });
                });
                if (dept.selectedOptions[0] && dept.selectedOptions[0].disabled) dept.value = '';
            }
            where.addEventListener('change', followRoom);
            followRoom();
            // Same rule as SupplyText.Unit: 1 box, 6 boxes, 42 reams.
            function plural(u, q) {
                if (q === 1) return u;
                var l = u.toLowerCase();
                if (/s$/.test(l) && !/ss$/.test(l)) return u;
                if (/(x|ch|sh|ss)$/.test(l)) return u + 'es';
                return u + 's';
            }
            function sync() {
                var q = Math.max(0, parseInt(qty.value, 10) || 0);
                var l = Math.max(0, parseInt(low.value, 10) || 0);
                var u = (unit.value || '').trim();
                el('pvName').textContent = (name.value || '').trim() || 'New supply';
                el('pvQty').textContent = q + (u ? ' ' + plural(u, q) : '');
                var status = el('pvStatus');
                var out = q <= 0, running = !out && l > 0 && q <= l;
                status.textContent = out ? 'Out of stock' : running ? 'Running low' : 'In stock';
                status.className = 'asset-pill asset-status ' + (out ? 'st-overdue' : running ? 'st-low' : 'st-available');
                var opt = where.options[where.selectedIndex];
                el('pvWhere').textContent = where.value ? 'Kept in ' + opt.textContent.trim() : 'Pick where it is kept.';
                var p = parseFloat(price.value);
                var value = el('pvValue');
                if (!isNaN(p) && p > 0 && q > 0) {
                    value.hidden = false;
                    value.textContent = 'Stock value \u20B1 ' + (p * q).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                } else {
                    value.hidden = true;
                }
            }
            [name, unit, qty, low, price, where].forEach(function (i) {
                i.addEventListener('input', sync);
                i.addEventListener('change', sync);
            });
            sync();
        })();
    </script>
}
