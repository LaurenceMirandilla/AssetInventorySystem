@model SchoolInventoryManagement.Web.ViewModels.DepartmentRoomsPicker
@*
    The department's rooms (Scripts/029). Every department needs at least
    one; a room belongs to one department only, so rooms another department
    has are shown but cannot be picked. Only the rooms of the branch picked
    in the same form are shown (site.js, [data-rooms-picker]). The main room
    is where the department's supplies and purchases are delivered.
*@
<div class="dept-rooms" data-rooms-picker data-dept="@Model.DepartmentID">
    <div class="form-label mb-1">Rooms <span class="text-danger" aria-hidden="true">*</span></div>
    <div class="form-text mt-0 mb-2">The rooms that are this department's. A room belongs to one department only.</div>
    <div class="dept-rooms-list" role="group" aria-label="Rooms">
        @foreach (var r in Model.Rooms)
        {
            var mine = Model.Selected.Contains(r.LocationID);
            var other = r.OwnerID is int o && o != Model.DepartmentID && !mine;
            var id = $"{Model.Prefix}-room-{r.LocationID}";
            <label class="dept-room @(other ? "is-taken" : "")" for="@id" data-branch="@r.BranchID">
                <input type="checkbox" id="@id" name="LocationIDs" value="@r.LocationID" checked="@mine" disabled="@other" data-name="@r.Name" />
                <span>@r.Name</span>
                @if (other)
                {
                    <small>· @r.OwnerName</small>
                }
            </label>
        }
    </div>
    <div class="dept-rooms-none form-text text-danger" hidden>This branch has no rooms yet. Add one under Locations first.</div>
    <div class="mt-3">
        <label class="form-label" for="@Model.Prefix-main">Main room <span class="register-optional">supplies and purchases are delivered here</span></label>
        <select class="form-select" id="@Model.Prefix-main" name="MainLocationID" data-main-room>
            @foreach (var r in Model.Rooms)
            {
                <option value="@r.LocationID" data-branch="@r.BranchID" selected="@(r.LocationID == Model.MainID)">@r.Name</option>
            }
        </select>
    </div>
</div>
