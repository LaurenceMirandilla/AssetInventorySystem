@model ErrorViewModel
@{
    ViewData["Title"] = Model.StatusCode == 404 ? "Page not found" : "Error";

    // Same label the sidebar gives the first link for this role.
    var signedIn = User.Identity?.IsAuthenticated == true;
    var homeLabel = User.IsInRole("Asset Officer") || User.IsInRole("Administrator") || User.IsInRole("Principal")
        ? "Dashboard" : "Home";
}

@* 404s and other status codes arrive here through
   UseStatusCodePagesWithReExecute; a crash on a page arrives through
   ExceptionHandlingMiddleware as a 500. *@
<div class="state-page">
    <div class="state-code" aria-hidden="true">@Model.StatusCode</div>
    <h2 class="state-title">@Model.Heading</h2>
    <p class="state-text">@Model.Detail</p>

    @if (Model.ShowRequestId)
    {
        <p class="state-ref"><code class="state-code-chip">@Model.RequestId</code></p>
    }

    <div class="state-actions">
        <button type="button" class="btn btn-outline-secondary" onclick="history.back()">&larr; Go back</button>
        @if (signedIn)
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to @homeLabel</a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Sign in</a>
        }
    </div>
</div>
