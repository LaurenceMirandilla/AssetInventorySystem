@model ErrorViewModel
@{
    ViewData["Title"] = Model.StatusCode == 404 ? "Page not found" : "Error";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body text-center py-5">
                <div class="text-muted" style="font-size:2.6rem; font-weight:700; line-height:1;">
                    @Model.StatusCode
                </div>
                <h2 class="mt-3 mb-2">@Model.Heading</h2>
                <p class="text-muted mb-4">@Model.Detail</p>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
                    <a asp-controller="Assets" asp-action="Index" class="btn btn-outline-secondary">Browse assets</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Sign in</a>
                }

                @if (Model.ShowRequestId)
                {
                    <p class="text-muted small mt-4 mb-0">
                        Quote this reference if you report it:
                        <code>@Model.RequestId</code>
                    </p>
                }
            </div>
        </div>
    </div>
</div>
