@model string
@* Borrowing's pages as tabs (the sidebar has one Borrowing link): your own
   borrows and returns, and the finished ones. Property's borrow approvals
   are under Approvals (_ApprovalsNav). *@
<ul class="nav nav-tabs mb-3" aria-label="Borrowing">
    <li class="nav-item">
        <a class="nav-link @(Model == "mine" ? "active" : "")" aria-current="@(Model == "mine" ? "page" : null)"
           asp-controller="AssetRequests" asp-action="MyRequests">My borrowing</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model == "history" ? "active" : "")" aria-current="@(Model == "history" ? "page" : null)"
           asp-controller="AssetRequests" asp-action="History">History</a>
    </li>
</ul>
