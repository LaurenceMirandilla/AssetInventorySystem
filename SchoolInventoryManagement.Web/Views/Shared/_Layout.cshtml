@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ste. Anne De Beaupre School</title>
    <link rel="icon" href="~/images/favicon.ico" sizes="any" />
    <link rel="icon" href="~/images/favicon.png" type="image/png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var isApprover = User.IsInRole("Asset Officer") || User.IsInRole("Administrator") || User.IsInRole("Principal");
    var isUserManager = User.IsInRole("Administrator") || User.IsInRole("Principal");
    var isAssetManager = User.IsInRole("Asset Officer") || User.IsInRole("Administrator");
    var roleName = User.FindFirst(ClaimTypes.Role)?.Value;
    var displayName = User.Identity?.Name ?? "";
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Select(p => p[0])).ToUpperInvariant();
    if (initials.Length > 2) initials = initials[..2];

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    Func<string[], bool> isActive = controllers =>
        controllers.Any(c => string.Equals(c, currentController, StringComparison.OrdinalIgnoreCase));

    // My Requests and Approvals are both AssetRequestsController, so the
    // controller name alone cannot tell them apart -- it lit both up at once.
    // Split on the action instead: the approver screens are Approvals,
    // everything else in the controller is the requester's own view.
    var approvalActions = new[] { "Pending", "Approve", "ApproveBorrow", "ApproveTransfer", "Reject" };
    var inRequests = isActive(new[] { "AssetRequests" });
    var onApprovals = inRequests
        && approvalActions.Contains(currentAction, StringComparer.OrdinalIgnoreCase);

    // Line icons matching the mockup's sidebar. 18x18, currentColor, so the
    // .sab-nav-link active and hover colours carry straight through.
    Func<string, string> navIcon = name =>
    {
        const string open = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">";
        var body = name switch
        {
            "dashboard" => "<rect x='3' y='3' width='7' height='7' rx='1.5'/><rect x='14' y='3' width='7' height='7' rx='1.5'/><rect x='3' y='14' width='7' height='7' rx='1.5'/><rect x='14' y='14' width='7' height='7' rx='1.5'/>",
            "assets"    => "<path d='M12 2 3 7v10l9 5 9-5V7z'/><path d='M3 7l9 5 9-5'/><path d='M12 12v10'/>",
            "myassets"  => "<path d='M3 7h18v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/><path d='M3 7l2-4h14l2 4'/><path d='M9 12h6'/>",
            "requests"  => "<path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/><path d='M14 2v6h6'/><path d='M9 14l2 2 4-4'/>",
            "approvals" => "<path d='M9 11l3 3 7-7'/><path d='M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11'/>",
            "reports"   => "<path d='M3 3v18h18'/><path d='M7 15l4-5 3 3 5-7'/>",
            "categories"=> "<path d='M20.6 13.4 12 22l-9-9V3h10z'/><circle cx='7.5' cy='7.5' r='1.4'/>",
            "models"    => "<path d='M12 2 2 7l10 5 10-5z'/><path d='M2 17l10 5 10-5'/><path d='M2 12l10 5 10-5'/>",
            "locations" => "<path d='M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z'/><circle cx='12' cy='10' r='3'/>",
            "users"     => "<path d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M22 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/>",
            "branches"  => "<path d='M3 21h18'/><path d='M5 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16'/><path d='M15 9h2a2 2 0 0 1 2 2v10'/><path d='M9 7h2M9 11h2M9 15h2'/>",
            "departments"=> "<rect x='9' y='2' width='6' height='5' rx='1'/><rect x='2' y='16' width='6' height='5' rx='1'/><rect x='16' y='16' width='6' height='5' rx='1'/><path d='M12 7v5M5 16v-2h14v2'/>",
            "bell"      => "<path d='M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9'/><path d='M13.7 21a2 2 0 0 1-3.4 0'/>",
            _ => ""
        };
        return open + body.Replace('\'', '"') + "</svg>";
    };
}
<div class="sab-shell">

    @if (isAuthed)
    {
        <aside class="sab-sidebar">
            <a class="sab-brand" asp-controller="Home" asp-action="Index">
                <img class="sab-brand-logo" src="~/images/logo-mark.png" alt="" aria-hidden="true" />
                <span class="sab-brand-text">
                    <span class="sab-brand-name d-block">Ste. Anne De Beaupre</span>
                    <span class="sab-brand-sub">Inventory</span>
                </span>
            </a>

            <ul class="sab-nav">
                <li class="sab-nav-item">
                    <a class="sab-nav-link @(isActive(new[]{"Home"}) ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <span class="sab-nav-label">@Html.Raw(navIcon("dashboard"))@(isApprover || isAssetManager ? "Dashboard" : "Home")</span>
                    </a>
                </li>
                <li class="sab-nav-item">
                    <a class="sab-nav-link @(isActive(new[]{"Assets"}) && currentAction != "MyAssets" ? "active" : "")"
                       asp-controller="Assets" asp-action="Index">
                        <span class="sab-nav-label">@Html.Raw(navIcon("assets"))@(isAssetManager ? "Assets" : "Browse assets")</span>
                    </a>
                </li>
                <li class="sab-nav-item">
                    <a class="sab-nav-link @(isActive(new[]{"Assets"}) && currentAction == "MyAssets" ? "active" : "")"
                       asp-controller="Assets" asp-action="MyAssets">
                        <span class="sab-nav-label">@Html.Raw(navIcon("myassets"))My Assets</span>
                    </a>
                </li>
                <li class="sab-nav-item">
                    <a class="sab-nav-link @(inRequests && !onApprovals ? "active" : "")" asp-controller="AssetRequests" asp-action="MyRequests">
                        <span class="sab-nav-label">@Html.Raw(navIcon("requests"))My Requests</span>
                    </a>
                </li>

                @if (isApprover)
                {
                    <li class="sab-nav-heading">Approvals</li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(onApprovals ? "active" : "")" asp-controller="AssetRequests" asp-action="Pending">
                            <span class="sab-nav-label">@Html.Raw(navIcon("approvals"))Approvals</span>
                        </a>
                    </li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Reports"}) ? "active" : "")" asp-controller="Reports" asp-action="Index">
                            <span class="sab-nav-label">@Html.Raw(navIcon("reports"))Reports</span>
                        </a>
                    </li>
                }

                @if (isAssetManager)
                {
                    <li class="sab-nav-heading">Catalog</li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Categories"}) ? "active" : "")" asp-controller="Categories" asp-action="Index">
                            <span class="sab-nav-label">@Html.Raw(navIcon("categories"))Categories</span>
                        </a>
                    </li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Models"}) ? "active" : "")" asp-controller="Models" asp-action="Index">
                            <span class="sab-nav-label">@Html.Raw(navIcon("models"))Models</span>
                        </a>
                    </li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Locations"}) ? "active" : "")" asp-controller="Locations" asp-action="Index">
                            <span class="sab-nav-label">@Html.Raw(navIcon("locations"))Locations</span>
                        </a>
                    </li>
                }

                @if (isUserManager)
                {
                    <li class="sab-nav-heading">Organization</li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Users"}) ? "active" : "")" asp-controller="Users" asp-action="Index">
                            <span class="sab-nav-label">@Html.Raw(navIcon("users"))Users</span>
                        </a>
                    </li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Branches"}) ? "active" : "")" asp-controller="Branches" asp-action="Index">
                            <span class="sab-nav-label">@Html.Raw(navIcon("branches"))Branches</span>
                        </a>
                    </li>
                    <li class="sab-nav-item">
                        <a class="sab-nav-link @(isActive(new[]{"Departments"}) ? "active" : "")" asp-controller="Departments" asp-action="Index">
                            <span class="sab-nav-label">@Html.Raw(navIcon("departments"))Departments</span>
                        </a>
                    </li>
                }

                <li class="sab-nav-heading">&nbsp;</li>
                <li class="sab-nav-item">
                    <a class="sab-nav-link @(isActive(new[]{"Notifications"}) ? "active" : "")" asp-controller="Notifications" asp-action="Index">
                        <span class="sab-nav-label">@Html.Raw(navIcon("bell"))Notifications</span>
                    </a>
                </li>
            </ul>

            <a class="sab-sidebar-cta" asp-controller="AssetRequests" asp-action="Create">
                <span>+</span> New Request
            </a>
        </aside>
    }

    <div class="sab-main">
        <header class="sab-topbar">
            <span class="sab-topbar-title">Ste. Anne De Beaupre School</span>

            @if (isAuthed)
            {
                <div class="sab-search sab-search-wrap">
                    <span class="sab-search-icon">&#128269;</span>
                    <form asp-controller="Assets" asp-action="Index" method="get">
                        <input type="text" name="keyword" placeholder="Search assets, codes, serials&hellip;" />
                    </form>
                </div>
            }

            <div class="sab-topbar-right">
                @if (isAuthed)
                {
                    <a class="sab-bell" asp-controller="Notifications" asp-action="Index" title="Notifications">
                        @await Component.InvokeAsync("NotificationBell")
                    </a>

                    <div class="sab-user dropdown">
                        <a href="#" class="sab-user d-flex align-items-center text-decoration-none" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="sab-user-text d-none d-sm-block">
                                <span class="sab-user-name d-block">@displayName</span>
                                <span class="sab-user-role">@roleName</span>
                            </span>
                            <span class="sab-avatar">@initials</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Users" asp-action="ChangePassword">Change Password</a></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                }
            </div>
        </header>

        <main class="sab-content">
            @if (TempData["StatusMessage"] != null)
            {
                <div class="alert alert-success">@TempData["StatusMessage"]</div>
            }
            @RenderBody()
        </main>

        <footer class="border-top footer text-muted py-3 px-4">
            @* No Privacy link here or in the sidebar: HomeController.Privacy is
               [Authorize(Roles = Administrator)], so for every other role the
               link only ever landed on Access Denied. The page itself is
               unchanged and still reachable at /Home/Privacy. *@
            &copy; 2026 - Ste. Anne De Beaupre School
        </footer>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
