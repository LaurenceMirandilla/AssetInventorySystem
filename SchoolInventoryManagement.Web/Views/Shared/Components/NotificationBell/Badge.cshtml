@model int
@* A count pill after a sidebar label. Nothing when zero. *@
@* Always drawn (hidden at zero) so the live updates can fill it in.
   LiveKey says which count it is: unread notifications, or approvals. *@
<span class="sab-nav-badge" data-live-badge="@(ViewData["LiveKey"] as string ?? "unread")" hidden="@(Model <= 0)">@(Model > 99 ? "99+" : Model.ToString())</span>
