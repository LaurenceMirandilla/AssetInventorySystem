@model string
@inject SchoolInventoryManagement.BLL.Interfaces.ISupplyRequestService SupplyRequests
@{
    var open = await SupplyRequests.CountOpenAsync();
}
@* Approvals: asset requests (borrow and transfer) or supply requests. *@
@* Borrow and transfer requests are the Property Department's: the
   Principal only approves supplies here. *@
<nav class="sab-seg mb-3" aria-label="Kind of request">
    @if (User.IsInRole("Property Officer") || User.IsInRole("Administrator"))
    {
        <a asp-controller="AssetRequests" asp-action="Pending" class="@(Model == "Assets" ? "active" : "")"
           aria-current="@(Model == "Assets" ? "page" : null)">Borrow</a>
    }
    @* Older supply requests (before requisitions, Scripts/031): shown while
       some are still on their way. *@
    @if (open > 0 || Model == "Supplies")
    {
        <a asp-controller="SupplyRequests" asp-action="Pending" class="@(Model == "Supplies" ? "active" : "")"
           aria-current="@(Model == "Supplies" ? "page" : null)">Older supply requests@(open > 0 ? " · " + open : "")</a>
    }
</nav>
