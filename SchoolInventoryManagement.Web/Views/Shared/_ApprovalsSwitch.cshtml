@model string
@inject SchoolInventoryManagement.BLL.Interfaces.ISupplyRequestService SupplyRequests
@{
    var open = await SupplyRequests.CountOpenAsync();
}
@* Requisition > Consumables: the older supply requests (before requisitions,
   Scripts/031), while some are still on their way. *@
@if (open > 0 || Model == "Supplies")
{
    if (Model == "Supplies")
    {
        <a asp-controller="NewItemRequests" asp-action="Pending" asp-route-kind="Supply" class="btn btn-outline-secondary btn-sm mb-3">&larr; Consumable requisitions</a>
    }
    else
    {
        <a asp-controller="SupplyRequests" asp-action="Pending" class="btn btn-outline-secondary btn-sm">Older supply requests · @open</a>
    }
}
