@model SchoolInventoryManagement.BLL.DTOs.LoginDTO
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ste. Anne De Beaupre School</title>
    <link rel="icon" href="~/images/favicon.ico" sizes="any" />
    <link rel="icon" href="~/images/favicon.png" type="image/png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            html, body { height: 100%; }
            .login-shell {
                display: flex;
                min-height: 100vh;
            }
            .login-panel {
                flex: 1 1 50%;
                background: linear-gradient(160deg, var(--sab-green) 0%, var(--sab-green-darker) 100%);
                color: #fff;
                padding: 56px;
                display: flex;
                flex-direction: column;
                position: relative;
                overflow: hidden;
            }
            .login-panel::before {
                content: "";
                position: absolute;
                right: -120px;
                bottom: -120px;
                width: 420px;
                height: 420px;
                border-radius: 50%;
                border: 1px solid rgba(255,255,255,0.12);
            }
            .login-panel::after {
                content: "";
                position: absolute;
                right: -60px;
                bottom: -60px;
                width: 260px;
                height: 260px;
                border-radius: 50%;
                border: 1px solid rgba(255,255,255,0.12);
            }
            .login-mark {
                width: 108px;
                height: 108px;
                object-fit: contain;
                margin-bottom: 34px;
                position: relative;
                z-index: 1;
            }

            .login-title {
                font-size: 1.6rem;
                font-weight: 700;
                line-height: 1.25;
                margin-bottom: 8px;
            }
            .login-subtitle {
                font-size: 0.72rem;
                font-weight: 700;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: rgba(255,255,255,0.75);
                margin-bottom: 20px;
            }
            .login-rule {
                width: 36px;
                height: 3px;
                background: rgba(255,255,255,0.5);
                border-radius: 2px;
                margin-bottom: 20px;
            }
            .login-blurb {
                font-size: 0.94rem;
                line-height: 1.55;
                color: rgba(255,255,255,0.85);
                max-width: 320px;
            }
            .login-footnote {
                margin-top: auto;
                font-size: 0.78rem;
                color: rgba(255,255,255,0.55);
                position: relative;
                z-index: 1;
            }
            .login-form-side {
                flex: 1 1 50%;
                background: var(--sab-surface);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px;
            }
            .login-form-wrap { width: 100%; max-width: 360px; }
            .login-form-wrap h1 {
                font-size: 1.3rem;
                font-weight: 700;
                margin-bottom: 4px;
            }
            .login-form-wrap .lead-text {
                color: var(--sab-text-muted);
                font-size: 0.88rem;
                margin-bottom: 28px;
            }
            .password-wrap { position: relative; }
            .password-wrap .toggle-visibility {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: var(--sab-text-muted);
                cursor: pointer;
            }
            .login-help {
                text-align: center;
                font-size: 0.76rem;
                color: var(--sab-text-faint);
                margin: 20px 0 10px;
                position: relative;
            }
            .login-help::before, .login-help::after {
                content: "";
                position: absolute;
                top: 50%;
                width: 30%;
                border-top: 1px solid var(--sab-border);
            }
            .login-help::before { left: 0; }
            .login-help::after { right: 0; }
            .login-note {
                text-align: center;
                font-size: 0.82rem;
                color: var(--sab-text-muted);
                line-height: 1.5;
            }
    </style>
</head>
<body>
    <div class="login-shell">
        <div class="login-panel">
            <img src="~/images/logo-mark.png" alt="Ste. Anne De Beaupré School crest" class="login-mark" />
            <div class="login-title">Ste. Anne De<br />Beaupre School</div>
            <div class="login-subtitle">Inventory System</div>
            <div class="login-rule"></div>
            <p class="login-blurb">
                Every projector, laptop and desk on campus — who holds it,
                where it sits, and what condition it came back in.
            </p>
            <div class="login-footnote">Authorized access only. Accounts are issued by the IT office.</div>
        </div>

        <div class="login-form-side">
            <div class="login-form-wrap">
                <h1>Sign in</h1>
                <p class="lead-text">Use the school email address your account was created with.</p>

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email" class="form-control" autocomplete="username"
                               placeholder="name@steannedebeaupre.edu.ph" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="password-wrap">
                            <input asp-for="Password" id="passwordInput" class="form-control"
                                   autocomplete="current-password" />
                            <button type="button" class="toggle-visibility" onclick="togglePassword()" aria-label="Show password">
                                &#128065;
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="keepSignedIn" />
                            <label class="form-check-label" for="keepSignedIn" style="font-size:0.85rem;">
                                Keep me signed in
                            </label>
                        </div>
                        <span class="text-muted" style="font-size:0.85rem;">Forgot password?</span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
                        Sign in <span>&rarr;</span>
                    </button>
                </form>

                <div class="login-help">NEED HELP</div>
                <p class="login-note">
                    Forgotten passwords are reset by an Administrator or the Principal
                    — contact the IT office rather than creating a second account.
                </p>
            </div>
        </div>
    </div>

    <script>
            function togglePassword() {
                const input = document.getElementById('passwordInput');
                input.type = input.type === 'password' ? 'text' : 'password';
            }
    </script>
</body>
</html>