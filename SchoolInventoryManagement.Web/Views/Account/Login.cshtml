@model SchoolInventoryManagement.BLL.DTOs.LoginDTO
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ste. Anne De Beaupre School</title>
    <link rel="icon" href="~/images/favicon.ico" sizes="any" />
    <link rel="icon" href="~/images/favicon.png" type="image/png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Sign-in page: deep green backdrop with the crest as a faint
           watermark, the school name on top, and a white card with a gold
           top edge. Falls back to the system font when offline. */
        :root {
            --login-gold: #d4b13a;
            --login-ink: #1f5f2a;
            --login-bg-center: #2a7a35;
            --login-bg-edge: #0f3d17;
        }

        html, body { min-height: 100%; }
        body {
            margin: 0;
            background: radial-gradient(ellipse at 50% 40%, var(--login-bg-center) 0%, #1c5e27 45%, var(--login-bg-edge) 100%);
            background-attachment: fixed;
            font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            overflow-x: hidden;
        }

        .login-page {
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
        }

        /* The crest, huge and faint, behind everything. */
        .login-watermark {
            position: fixed;
            left: 50%;
            top: 50%;
            width: min(680px, 92vw);
            transform: translate(-50%, -50%);
            opacity: 0.14;
            pointer-events: none;
            user-select: none;
            z-index: 0;
        }

        .login-brand,
        .login-card { position: relative; z-index: 1; }

        .login-brand { text-align: center; margin-bottom: 32px; }
        .login-crest {
            width: 96px;
            height: auto;
            display: block;
            margin: 0 auto 18px;
            filter: drop-shadow(0 4px 10px rgba(0,0,0,0.25));
        }
        .login-school {
            color: #fff;
            font-size: clamp(1.6rem, 4.5vw, 2.5rem);
            font-weight: 800;
            letter-spacing: -0.02em;
            line-height: 1.15;
            margin: 0 0 14px;
            text-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }
        .login-system {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            color: var(--login-gold);
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.24em;
            text-transform: uppercase;
        }
        .login-system::before,
        .login-system::after {
            content: "";
            width: 32px;
            height: 2px;
            background: var(--login-gold);
            border-radius: 2px;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: #f7f9f7;
            border-top: 6px solid var(--login-gold);
            border-radius: 18px;
            box-shadow: 0 24px 60px rgba(0,0,0,0.35);
            padding: 34px 36px 28px;
        }
        .login-card h1 {
            text-align: center;
            color: var(--login-ink);
            font-size: 1.65rem;
            font-weight: 800;
            margin: 0 0 6px;
        }
        .login-lead {
            text-align: center;
            color: #5b6660;
            font-size: 0.9rem;
            line-height: 1.4;
            margin: 0 0 24px;
        }

        .login-card .form-label {
            font-size: 0.84rem;
            font-weight: 600;
            color: #2d3a32;
            margin-bottom: 6px;
        }
        .login-card .form-control {
            height: 48px;
            border-radius: 10px;
            border-color: #d9e1dc;
            background: #fff;
            font-size: 0.95rem;
        }
        .login-card .form-control:focus {
            border-color: var(--login-ink);
            box-shadow: 0 0 0 3px rgba(31,95,42,0.15);
        }

        .password-wrap { position: relative; }
        .password-wrap .form-control { padding-right: 48px; }
        .toggle-visibility {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: none;
            border: none;
            border-radius: 8px;
            color: #5b6660;
            cursor: pointer;
        }
        .toggle-visibility:hover { color: var(--login-ink); background: rgba(31,95,42,0.06); }

        .login-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 6px 0 22px;
        }
        .login-options .form-check { margin: 0; display: flex; align-items: center; gap: 10px; padding-left: 0; }
        .login-options .form-check-input {
            float: none;
            margin: 0;
            width: 18px;
            height: 18px;
        }
        .login-options .form-check-input:checked { background-color: var(--login-ink); border-color: var(--login-ink); }
        .login-options .form-check-label { font-size: 0.9rem; color: #2d3a32; }
        .login-forgot { font-size: 0.85rem; color: #5b6660; text-decoration: none; white-space: nowrap; }
        .login-forgot:hover { color: var(--login-ink); text-decoration: underline; }

        .login-submit {
            width: 100%;
            height: 50px;
            border: none;
            border-radius: 10px;
            background: var(--login-ink);
            color: #fff;
            font-weight: 700;
            font-size: 1rem;
            transition: background 0.15s;
        }
        .login-submit:hover { background: #174a20; }
        .login-submit:focus-visible { outline: 3px solid var(--login-gold); outline-offset: 2px; }

        .login-note {
            text-align: center;
            font-size: 0.78rem;
            line-height: 1.55;
            color: #5b6660;
            margin: 22px 0 0;
            border-radius: 8px;
            transition: background 0.3s;
        }
        /* "Forgot password?" jumps here and highlights it. */
        .login-note:target { background: #fff6d6; padding: 8px; }

        @@media (max-width: 480px) {
            .login-card { padding: 28px 20px 22px; }
            .login-options { flex-wrap: wrap; }
        }
    </style>
</head>
<body>
    <img src="~/images/logo.png" alt="" aria-hidden="true" class="login-watermark" />

    <main class="login-page">
        <div class="login-brand">
            <img src="~/images/logo.png" alt="Ste. Anne De Beaupré School crest" class="login-crest" />
            <h2 class="login-school">Ste. Anne De Beaupre School</h2>
            <div class="login-system">Inventory System</div>
        </div>

        <div class="login-card">
            <h1>Welcome back</h1>
            <p class="login-lead">Sign in with the school email your account was created with.</p>

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" autocomplete="username"
                           placeholder="name@steannedebeaupre.edu.ph" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="password-wrap">
                        <input asp-for="Password" id="passwordInput" class="form-control"
                               autocomplete="current-password" />
                        <button type="button" class="toggle-visibility" id="togglePassword"
                                aria-label="Show password" aria-pressed="false">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="login-options">
                    <div class="form-check">
                        <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Keep me signed in</label>
                    </div>
                    <a href="#loginHelp" class="login-forgot">Forgot password?</a>
                </div>

                <button type="submit" class="login-submit">Sign in</button>
            </form>

            <p class="login-note" id="loginHelp">
                Forgotten passwords are reset by an Administrator or the Principal.
                Contact the IT office rather than creating a second account.
            </p>
        </div>
    </main>

    <script>
        (function () {
            var input = document.getElementById('passwordInput');
            var button = document.getElementById('togglePassword');
            button.addEventListener('click', function () {
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                button.setAttribute('aria-pressed', show ? 'true' : 'false');
                button.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            });
        })();
    </script>
</body>
</html>
