@model SchoolInventoryManagement.BLL.DTOs.InventorySummaryDTO
@using SchoolInventoryManagement.BLL.DTOs
@{
    ViewData["Title"] = "Reports";

    var tiles = new[]
    {
        (Label: "Assets in service", Value: Model.InServiceAssets.ToString(), Note: $"{Model.TotalAssets} on record", Icon: "<path d=\"M12 2 3 7v10l9 5 9-5V7z\"/>", Css: "is-solid"),
        (Label: "Total value", Value: DisplayText.Peso(Model.TotalValue), Note: "in service only", Icon: "<path d=\"M8 4v16M8 4h5a4 4 0 0 1 0 8H8M5 8h11M5 11h11\"/>", Css: "is-solid"),
        (Label: "Available", Value: Model.AvailableCount.ToString(), Note: "ready to issue", Icon: "<path d=\"m5 12 5 5 9-10\"/>", Css: ""),
        (Label: "Assigned out", Value: Model.AssignedCount.ToString(), Note: $"with people · {Model.AwaitingHandoverCount} more ready for pickup / on its way", Icon: "<path d=\"M5 12h14M13 6l6 6-6 6\"/>", Css: "is-teal"),
        (Label: "Pending requests", Value: Model.PendingRequestCount.ToString(), Note: "awaiting a decision", Icon: "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/>", Css: "is-gray"),
        (Label: "Under maintenance", Value: Model.UnderMaintenanceCount.ToString(), Note: $"{Model.DamagedCount} in damaged condition", Icon: "<path d=\"M14 6a4 4 0 0 0-5 5l-5 5 3 3 5-5a4 4 0 0 0 5-5l-2 2-3-3z\"/>", Css: "is-gray"),
        (Label: "Disposed", Value: Model.DisposedCount.ToString(), Note: "excluded from value", Icon: "<path d=\"M4 7h16M6 7l1 13h10l1-13M9 7V4h6v3\"/>", Css: "is-gray is-muted"),
        (Label: "Active users", Value: Model.ActiveUserCount.ToString(), Note: "can sign in", Icon: "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4 4-6 8-6s8 2 8 6\"/>", Css: "")
    };
}

@functions {
    // Bar length against the largest row in the same breakdown.
    static string Width(CountByLabelDTO row, IEnumerable<CountByLabelDTO> rows)
    {
        var max = rows.Select(r => r.Count).DefaultIfEmpty(0).Max();
        var pct = max == 0 ? 0 : Math.Max(row.Count > 0 ? 2 : 0, row.Count * 100.0 / max);
        return pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    static string Label(string raw) => raw == "UnderMaintenance" ? "Maintenance"
        : raw == "InTransit" ? DisplayText.InTransitLabel(null) : DisplayText.Humanize(raw);

    // A shade per row for the plain breakdowns, darkest first.
    static string Shade(int i) => i switch { 0 => "bar-1", 1 => "bar-2", 2 => "bar-3", _ => "bar-4" };
}

<div class="asset-detail-head mb-3 pb-0 border-0">
    <div>
        <h2 class="asset-detail-title">Reports</h2>
        <div class="asset-detail-sub">Inventory summary as of @PhilippineTime.Today.ToString("MMM d, yyyy") · disposed units are left out of totals.</div>
    </div>
    <div class="asset-detail-actions">
        <a asp-action="ExportSummary" class="btn btn-primary">&darr; Export CSV</a>
    </div>
</div>

@await Html.PartialAsync("_ReportsNav")

<div class="kpi-grid">
    @foreach (var t in tiles)
    {
        <div class="kpi @t.Css">
            <div class="kpi-label">
                <span class="kpi-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(t.Icon)</svg></span>
                @t.Label
            </div>
            <div class="kpi-value">@t.Value</div>
            <div class="kpi-note">@t.Note</div>
        </div>
    }
</div>

<div class="asset-card breakdown mb-3">
    <div class="breakdown-head"><h3>By status</h3><span>count · value</span></div>
    @foreach (var row in Model.ByStatus)
    {
        var key = row.Label.ToLowerInvariant();
        <div class="breakdown-row has-link">
            <span class="breakdown-label"><span class="asset-pill asset-status st-@key">@Label(row.Label)</span></span>
            <span class="breakdown-bar"><span class="bar-@key" style="width:@Width(row, Model.ByStatus)"></span></span>
            <span class="breakdown-count">@row.Count</span>
            <span class="breakdown-value">@DisplayText.Peso(row.TotalValue)</span>
            <a class="breakdown-link" asp-controller="Assets" asp-action="Index" asp-route-status="@row.Label"
               asp-route-includeDisposed="@(row.Label == "Disposed" ? "true" : null)">View assets &rarr;</a>
        </div>
    }
</div>

@{
    var sections = new[]
    {
        (Title: "By condition", Rows: Model.ByCondition, Condition: true),
        (Title: "By category", Rows: Model.ByCategory, Condition: false),
        (Title: "By branch", Rows: Model.ByBranch, Condition: false),
        (Title: "By department", Rows: Model.ByDepartment, Condition: false)
    };
}
<div class="breakdown-grid">
    @foreach (var s in sections)
    {
        <div class="asset-card breakdown">
            <div class="breakdown-head"><h3>@s.Title</h3><span>count · value</span></div>
            @if (!s.Rows.Any())
            {
                <div class="text-muted small">Nothing on record.</div>
            }
            @for (var i = 0; i < s.Rows.Count; i++)
            {
                var row = s.Rows[i];
                var barCss = s.Condition ? "cond-bar-" + row.Label.ToLowerInvariant() : Shade(i);
                <div class="breakdown-row">
                    <span class="breakdown-label">@(s.Condition ? DisplayText.Humanize(row.Label) : row.Label)</span>
                    <span class="breakdown-bar"><span class="@barCss" style="width:@Width(row, s.Rows)"></span></span>
                    <span class="breakdown-count">@row.Count</span>
                    <span class="breakdown-value">@DisplayText.Peso(row.TotalValue)</span>
                </div>
            }
        </div>
    }
</div>
