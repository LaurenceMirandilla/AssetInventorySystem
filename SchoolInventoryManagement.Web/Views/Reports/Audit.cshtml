@model List<SchoolInventoryManagement.BLL.DTOs.AuditReportRowDTO>
@{
    ViewData["Title"] = "Audit Trail";
}

<div class="row g-3 sab-reports-grid">
    <div class="col-lg-3">
        @await Html.PartialAsync("_ReportsNav")
    </div>
    <div class="col-lg-9">
        <div class="sab-page-head">
            <div>
                <h2>Audit Trail</h2>
                <p class="sab-page-sub">
                    Written automatically by the save interceptor whenever an asset, request,
                    assignment, movement, disposal, user, category or model changes. Newest first.
                </p>
            </div>
            <div class="sab-page-actions">
            <a asp-action="ExportAudit"
               asp-route-fromDate="@Context.Request.Query["fromDate"]"
               asp-route-toDate="@Context.Request.Query["toDate"]"
               asp-route-userId="@Context.Request.Query["userId"]"
               asp-route-action="@Context.Request.Query["action"]"
               class="btn btn-primary">Export CSV</a>
            </div>
        </div>

        <div class="sab-filter-card">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label">From</label>
                    <input type="date" name="fromDate" class="form-control"
                           value="@(ViewBag.FromDate is DateTime f ? f.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-auto">
                    <label class="form-label">To</label>
                    <input type="date" name="toDate" class="form-control"
                           value="@(ViewBag.ToDate is DateTime t ? t.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-auto">
                    <label class="form-label">User</label>
                    @Html.DropDownList("userId", (IEnumerable<SelectListItem>)ViewBag.Users,
                         "All users", new { @class = "form-select" })
                </div>
                <div class="col-auto">
                    <label class="form-label">Action contains</label>
                    <input type="text" name="action" class="form-control"
                           placeholder="e.g. Disposed" value="@ViewBag.Action" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Max rows</label>
                    <input type="number" name="maxRows" class="form-control" min="1" max="2000"
                           value="@ViewBag.MaxRows" />
                </div>
                <div class="col-auto align-self-end">
                    <button type="submit" class="btn btn-secondary">Apply</button>
                    <a asp-action="Audit" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>

        @if (ViewBag.WasTruncated == true)
        {
            <div class="alert alert-warning">
                This view hit its row limit, so older entries are not shown. Narrow the
                date range, or use Export CSV — it returns up to 2000 rows.
            </div>
        }

        <div class="sab-table-card">
            <div class="sab-table-head">
                <h5>Audit entries</h5>
                <span class="sab-table-count">@Model.Count entr@(Model.Count == 1 ? "y" : "ies") shown.</span>
            </div>
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Action</th>
                        <th>Asset</th>
                        <th>Details</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td>@row.LogDateTime.ToString("MMM d, yyyy h:mm tt")</td>
                            <td>@row.UserName</td>
                            <td>@row.UserRole</td>
                            <td>@row.ActionPerformed</td>
                            <td>
                                @if (row.TargetAssetID.HasValue)
                                {
                                    <a asp-controller="Assets" asp-action="Details" asp-route-id="@row.TargetAssetID">@row.TargetAssetCode</a>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                            <td class="small">@(row.Description ?? "—")</td>
                            <td class="small text-muted">@(row.IPAddress ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="sab-empty"><p class="mb-0">No audit entries match these filters.</p></div>
            }
        </div>

    </div>
</div>
