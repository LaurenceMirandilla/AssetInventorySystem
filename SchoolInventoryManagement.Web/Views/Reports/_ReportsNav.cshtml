@{
    // Which report is on screen. All five live on ReportsController, so the
    // action name alone identifies the active row.
    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    Func<string, string> navClass = action =>
        string.Equals(action, current, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<div class="card">
    <div class="card-body">
        <h5 class="mb-2" style="font-size:1rem;">Reports</h5>
        <ul class="sab-subnav">
            <li><a class="@navClass("Index")" asp-action="Index">Inventory summary</a></li>
            <li><a class="@navClass("Assignments")" asp-action="Assignments">Borrowed items</a></li>
            <li><a class="@navClass("Disposals")" asp-action="Disposals">Disposals</a></li>
            <li><a class="@navClass("Requests")" asp-action="Requests">Request activity</a></li>
            <li><a class="@navClass("Audit")" asp-action="Audit">Audit trail</a></li>
        </ul>
    </div>
</div>
