@model List<SchoolInventoryManagement.BLL.DTOs.NotificationResponseDTO>
@{
    ViewData["Title"] = "Notifications";
    var unreadOnly = ViewData["UnreadOnly"] as bool? ?? false;
    var hasUnread = Model.Any(n => !n.IsRead);
    var unreadCount = Model.Count(n => !n.IsRead);
}
@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success">@TempData["StatusMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="sab-page-head">
    <div>
        <h2>Notifications</h2>
        <p class="sab-page-sub">
            @(unreadCount == 0 ? "Nothing unread." : $"{unreadCount} unread.")
        </p>
    </div>
    @if (hasUnread)
    {
        <div class="sab-page-actions">
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary">Mark all as read</button>
            </form>
        </div>
    }
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(unreadOnly ? "" : "active")"
           asp-action="Index" asp-route-unreadOnly="false">All</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(unreadOnly ? "active" : "")"
           asp-action="Index" asp-route-unreadOnly="true">Unread@(unreadCount > 0 ? $" · {unreadCount}" : "")</a>
    </li>
</ul>

@if (!Model.Any())
{
    <div class="card">
        <div class="sab-empty">
            <div class="sab-empty-title">@(unreadOnly ? "Nothing unread" : "No notifications yet")</div>
            <p>You are told when a request you made is decided, and when something is issued to or returned by you.</p>
        </div>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var notification in Model)
        {
            <div class="list-group-item @(notification.IsRead ? "" : "list-group-item-light border-start border-4 border-primary")">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="me-3">
                        <div class="@(notification.IsRead ? "text-muted" : "fw-semibold")">
                            @notification.Message
                        </div>
                        <small class="text-muted">@notification.CreatedAt.ToString("g")</small>
                    </div>

                    <div class="text-nowrap">
                        @* One click both follows the link and clears the
                           notification, so the list does not fill up with
                           things the user has already acted on. *@
                        @if (!string.IsNullOrWhiteSpace(notification.ActionURL))
                        {
                            <form asp-action="MarkRead" asp-route-id="@notification.NotificationID"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@notification.ActionURL" />
                                <button type="submit" class="btn btn-link p-0">View</button>
                            </form>
                        }

                        @if (!notification.IsRead)
                        {
                            <form asp-action="MarkRead" asp-route-id="@notification.NotificationID"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link text-muted p-0 ms-2">Mark read</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <p class="text-muted mt-3 small">
        Opening a notification marks it read in the same click. Approvals raise
        one notification for the whole outcome, not one per step.
    </p>
}
