@model SchoolInventoryManagement.Web.ViewModels.AssetBulkCreateViewModel
@{
    ViewData["Title"] = "Bulk Register Assets";
    var modelChoices = (List<SchoolInventoryManagement.Web.ViewModels.ModelCodeOption>)ViewBag.ModelChoices;
    ViewData["SelectedModelId"] = Model.ModelID;
}

<nav class="mb-2" style="font-size:0.85rem;">
    <a asp-action="Index" class="text-muted">Assets</a>
    <span class="text-muted mx-1">&rsaquo;</span>
    <span>Bulk register</span>
</nav>

<div class="sab-page-head">
    <div>
        <h2>Bulk Register Assets</h2>
        <p class="sab-page-sub">
            Register many units of the same model at once. Codes come from the model's
            category and are numbered for you; everything else is shared by every unit.
            Nothing is saved unless every unit can be — a problem with one cancels the whole batch.
        </p>
    </div>
</div>

<form asp-action="BulkCreate" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-lg-8">

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="mb-3">What and how many</h5>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <partial name="_ModelPicker" model="modelChoices" view-data="ViewData" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Quantity" class="form-label"></label>
                            <input asp-for="Quantity" id="quantity" type="number" min="1" max="200" class="form-control" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="mb-3">Name</h5>

                    <label asp-for="BaseName" class="form-label"></label>
                    <input asp-for="BaseName" id="baseName" class="form-control" placeholder="e.g. Monobloc Chair" />
                    <span asp-validation-for="BaseName" class="text-danger"></span>
                    <div class="form-text">Each unit is named "Name - Unit N", N being the number in its code.</div>

                    <div id="preview" class="mt-3 p-3" style="background:var(--sab-bg); border-radius:var(--sab-radius-sm);">
                        <div class="text-muted small mb-1">Will create</div>
                        <div id="previewBody" class="small">Pick a model and enter a name to see the codes.</div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="mb-1">Serial numbers <span class="text-muted small fw-normal">(optional)</span></h5>
                    <p class="text-muted small mb-2">
                        One per line, in the same order as the codes above — paste a column
                        straight from a spreadsheet. Leave empty to add them later.
                    </p>
                    <textarea asp-for="SerialNumbers" id="serialNumbers" class="form-control" rows="6"
                              style="font-family:var(--bs-font-monospace);"></textarea>
                    <div id="serialCount" class="form-text"></div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="mb-3">Shared by every unit</h5>

                    <div class="mb-3">
                        <label asp-for="BranchID" class="form-label"></label>
                        <select asp-for="BranchID" id="branchSelect" asp-items="ViewBag.Branches" class="form-select">
                            <option value="">-- Select Branch --</option>
                        </select>
                        <span asp-validation-for="BranchID" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CurrentLocationID" class="form-label"></label>
                        <select asp-for="CurrentLocationID" id="locationSelect" class="form-select">
                            <option value="">-- Pick a branch first --</option>
                            @foreach (var loc in (List<SchoolInventoryManagement.BLL.DTOs.LocationDTO>)ViewBag.LocationsByBranch)
                            {
                                <option value="@loc.LocationID" data-branch="@loc.BranchID"
                                        selected="@(loc.LocationID == Model.CurrentLocationID)">@loc.LocationName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DepartmentID" class="form-label"></label>
                        <select asp-for="DepartmentID" id="departmentSelect" class="form-select">
                            <option value="">-- Pick a branch first --</option>
                            @foreach (var dept in (List<SchoolInventoryManagement.BLL.DTOs.DepartmentDTO>)ViewBag.DepartmentsByBranch)
                            {
                                <option value="@dept.DepartmentID" data-branch="@dept.BranchID"
                                        selected="@(dept.DepartmentID == Model.DepartmentID)">@dept.DepartmentName</option>
                            }
                        </select>
                        <span asp-validation-for="DepartmentID" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Condition" class="form-label"></label>
                        <select asp-for="Condition"
                                asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.ConditionStatus>()"
                                class="form-select"></select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AcquisitionDate" class="form-label"></label>
                        <input asp-for="AcquisitionDate" type="date" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="AcquisitionCost" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input asp-for="AcquisitionCost" type="number" step="0.01" min="0" placeholder="0.00" class="form-control" />
                        </div>
                        <span asp-validation-for="AcquisitionCost" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WarrantyInformation" class="form-label"></label>
                        <input asp-for="WarrantyInformation" class="form-control" placeholder="e.g. 1 year, until Mar 2027" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="WarrantyFile" class="form-label">Warranty photo or file <span class="text-muted">(optional)</span></label>
                        <input asp-for="WarrantyFile" type="file" accept="@SchoolInventoryManagement.Web.Helpers.FileUploads.DocumentAccept"
                               data-max-bytes="@SchoolInventoryManagement.Web.Helpers.FileUploads.MaxBytes" class="form-control" />
                        <div class="form-text">Warranty card or receipt, photo or PDF, max @SchoolInventoryManagement.Web.Helpers.FileUploads.MaxMegabytes MB. Linked to every unit.</div>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="mb-2">QR labels</h5>
                    <input asp-for="CreateQr" type="checkbox" id="createQr" class="btn-check" autocomplete="off" />
                    <label for="createQr" id="createQrLabel" class="btn btn-outline-primary w-100">Add QR</label>
                    <div class="form-text">Click to make a QR code for every unit in the batch. Left off, none are made; you can add one later from each asset's page.</div>
                </div>
            </div>
        </div>
    </div>

    <button type="submit" id="submitBtn" class="btn btn-primary">Register assets</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

<partial name="_QuickAddModel" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            var quantity = document.getElementById('quantity');
            var baseName = document.getElementById('baseName');
            var serials = document.getElementById('serialNumbers');
            var previewBody = document.getElementById('previewBody');
            var serialCount = document.getElementById('serialCount');
            var submitBtn = document.getElementById('submitBtn');
            var maxNumber = @SchoolInventoryManagement.BLL.Services.AssetCodes.MaxNumber;

            // The picked model's code prefix and next free number, from the
            // model search box.
            var picked = null;
            var autoName = '';

            // Mirrors AssetService: {prefix}-{number:D4}, "{name} - Unit {number}".
            function pad(n) {
                var s = String(n);
                while (s.length < 4) s = '0' + s;
                return s;
            }

            function escapeHtml(text) {
                var div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function update() {
                var qty = parseInt(quantity.value, 10) || 0;
                var n = baseName.value.trim();

                if (!picked || qty < 1 || !n) {
                    previewBody.textContent = 'Pick a model and enter a name to see the codes.';
                } else {
                    var first = picked.next;
                    var last = first + qty - 1;
                    if (last > maxNumber) {
                        var left = Math.max(0, maxNumber - first + 1);
                        previewBody.innerHTML = '<span class="text-danger">Only ' + left + ' code' + (left === 1 ? '' : 's')
                            + ' left for ' + escapeHtml(picked.prefix) + '. Register fewer, or give the category a new prefix.</span>';
                    } else {
                        var firstLine = '<code>' + escapeHtml(picked.prefix + '-' + pad(first)) + '</code> ' + escapeHtml(n + ' - Unit ' + first);
                        if (qty === 1) {
                            previewBody.innerHTML = firstLine;
                        } else {
                            var lastLine = '<code>' + escapeHtml(picked.prefix + '-' + pad(last)) + '</code> ' + escapeHtml(n + ' - Unit ' + last);
                            previewBody.innerHTML = firstLine
                                + '<div class="text-muted">&vellip; ' + (qty - 2 > 0 ? (qty - 2) + ' more' : '') + '</div>'
                                + lastLine;
                        }
                    }
                }

                var lines = serials.value.split('\n').filter(function (l) { return l.trim().length > 0; }).length;
                if (lines === 0) {
                    serialCount.textContent = '';
                    serialCount.className = 'form-text';
                } else if (lines === qty) {
                    serialCount.textContent = lines + ' of ' + qty + ' — matches.';
                    serialCount.className = 'form-text text-success';
                } else {
                    serialCount.textContent = lines + ' of ' + qty + ' — needs exactly one per asset.';
                    serialCount.className = 'form-text text-danger';
                }

                submitBtn.textContent = qty > 0
                    ? 'Register ' + qty + ' asset' + (qty === 1 ? '' : 's')
                    : 'Register assets';
            }

            document.addEventListener('model-picked', function (e) {
                picked = e.detail;
                // Start the name off as the model's name if nothing is typed.
                if (picked && (!baseName.value.trim() || baseName.value === autoName)) {
                    baseName.value = picked.name;
                    autoName = picked.name;
                }
                update();
            });

            [quantity, baseName, serials].forEach(function (el) {
                el.addEventListener('input', update);
            });
            update();

            // ---- Add QR toggle ------------------------------------------
            // The label says what will happen, so "on" isn't just a color.
            var createQr = document.getElementById('createQr');
            var createQrLabel = document.getElementById('createQrLabel');
            function syncQr() {
                createQrLabel.textContent = createQr.checked ? '✓ QR for every unit' : 'Add QR';
            }
            createQr.addEventListener('change', syncQr);
            syncQr(); // a failed post keeps the choice

            // ---- Location and department follow branch -----------------
            // Each list only ever holds the chosen branch's entries, and
            // stays locked until a branch is picked. Options are rebuilt
            // rather than hidden, because some browsers ignore "hidden" on
            // <option>.
            var branchSelect = document.getElementById('branchSelect');
            if (!branchSelect) return;

            function followBranch(select, emptyText) {
                if (!select) return;

                var all = Array.from(select.options)
                    .filter(function (o) { return o.value; })
                    .map(function (o) {
                        return { value: o.value, text: o.text, branch: o.getAttribute('data-branch') };
                    });
                var selected = select.value;

                function rebuild() {
                    var branchId = branchSelect.value;
                    select.innerHTML = '';

                    var placeholder = document.createElement('option');
                    placeholder.value = '';
                    placeholder.text = branchId ? emptyText : '-- Pick a branch first --';
                    select.appendChild(placeholder);

                    all
                        .filter(function (x) { return x.branch === branchId; })
                        .forEach(function (x) {
                            var opt = document.createElement('option');
                            opt.value = x.value;
                            opt.text = x.text;
                            if (x.value === selected) opt.selected = true;
                            select.appendChild(opt);
                        });

                    select.disabled = !branchId;
                }

                branchSelect.addEventListener('change', function () {
                    selected = ''; // a new branch means its own entries
                    rebuild();
                });
                select.addEventListener('change', function () {
                    selected = select.value;
                });

                rebuild(); // on load too, so an edit or a failed post shows the right list
            }

            followBranch(document.getElementById('locationSelect'), '-- None --');
            followBranch(document.getElementById('departmentSelect'), '-- Select Department --');
        })();
    </script>
}