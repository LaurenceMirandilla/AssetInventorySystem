@model SchoolInventoryManagement.Web.ViewModels.AssetBulkCreateViewModel
@using SchoolInventoryManagement.Web.Helpers
@{
    ViewData["Title"] = "Bulk Register Assets";
    var modelChoices = (List<SchoolInventoryManagement.Web.ViewModels.ModelCodeOption>)ViewBag.ModelChoices;
    ViewData["SelectedModelId"] = Model.ModelID;
}

<div class="asset-detail-head">
    <div>
        <nav class="asset-crumbs" aria-label="Breadcrumb">
            <a asp-action="Index">Assets</a>
            <span aria-hidden="true">&rsaquo;</span>
            <span>Bulk register</span>
        </nav>
        <h2 class="asset-detail-title">Bulk register assets</h2>
        <div class="asset-detail-sub">
            Register many units of the same model at once. Codes come from the model's category and are numbered for you;
            everything else is shared by every unit.
        </div>
    </div>
    <div class="asset-detail-actions">
        <a asp-action="Create" class="btn btn-outline-secondary">Register just one instead</a>
    </div>
</div>

<form asp-action="BulkCreate" method="post" enctype="multipart/form-data" class="register-form">
    @Html.AntiForgeryToken()
    @Html.FormTicket()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-lg-8">

            <div class="asset-card register-step mb-3">
                <div class="register-step-head">
                    <span class="register-step-num">1</span>
                    <div>
                        <div class="register-step-title">What and how many</div>
                        <div class="register-step-sub">One model per batch, up to 200 units.</div>
                    </div>
                </div>
                <div class="register-step-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <partial name="_ModelPicker" model="modelChoices" view-data="ViewData" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Quantity" class="form-label">Quantity</label>
                            <div class="qty-stepper">
                                <button type="button" class="qty-btn" data-step="-1" aria-label="One fewer">&minus;</button>
                                <input asp-for="Quantity" id="quantity" type="number" min="1" max="200" class="form-control" />
                                <button type="button" class="qty-btn" data-step="1" aria-label="One more">+</button>
                            </div>
                            <div class="form-text">1 to 200</div>
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="asset-card register-step mb-3">
                <div class="register-step-head">
                    <span class="register-step-num">2</span>
                    <div>
                        <div class="register-step-title">Name</div>
                        <div class="register-step-sub">Each unit is named "Name - Unit N", N being the number in its code.</div>
                    </div>
                </div>
                <div class="register-step-body">
                    <label asp-for="BaseName" class="form-label">Base name</label>
                    <input asp-for="BaseName" id="baseName" class="form-control" placeholder="e.g. Monobloc Chair" />
                    <span asp-validation-for="BaseName" class="text-danger"></span>

                    <div class="bulk-preview mt-3">
                        <div class="bulk-preview-head" id="previewHead">Pick a model and enter a name to see the codes.</div>
                        <div id="previewBody"></div>
                    </div>
                </div>
            </div>

            <div class="asset-card register-step mb-3">
                <div class="register-step-head">
                    <span class="register-step-num">3</span>
                    <div class="flex-grow-1">
                        <div class="register-step-title">Serial numbers <span class="register-optional fw-normal">(optional)</span></div>
                        <div class="register-step-sub">One per line, in the same order as the codes — paste a column straight from a spreadsheet.</div>
                    </div>
                    <span id="serialCount" class="bulk-serial-count d-none"></span>
                </div>
                <div class="register-step-body">
                    @* The codes run down the left so each line visibly belongs
                       to one unit; the gutter scrolls with the box. *@
                    <div class="bulk-serials">
                        <div class="bulk-serials-gutter" id="serialGutter" aria-hidden="true"></div>
                        <textarea asp-for="SerialNumbers" id="serialNumbers" rows="6" spellcheck="false" wrap="off"
                                  aria-label="Serial numbers, one per line"></textarea>
                    </div>
                    <div class="form-text">Lines line up with the codes on the left. Blank ones can be added later from each asset's page.</div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">
            <div class="bulk-summary mb-3">
                <div class="bulk-summary-label">This batch</div>
                <div class="bulk-summary-stats">
                    <div><strong id="sumUnits">0</strong><span>units</span></div>
                    <div><strong id="sumCost" class="is-empty">Not set</strong><span>total cost</span></div>
                    <div><strong id="sumSerials">0</strong><span>serials</span></div>
                </div>
                <div class="bulk-summary-note">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" /><path d="m9 12 2 2 4-4" /></svg>
                    All or nothing — if one unit can't be saved, none are.
                </div>
            </div>

            <div class="asset-card register-step mb-3">
                <div class="register-step-head">
                    <span class="register-step-num">4</span>
                    <div>
                        <div class="register-step-title">Shared by every unit</div>
                        <div class="register-step-sub" id="sharedSub">Set once, applied to all of them.</div>
                    </div>
                </div>
                <div class="register-step-body">
                    <div class="mb-3">
                        <label asp-for="BranchID" class="form-label">Branch</label>
                        <select asp-for="BranchID" id="branchSelect" asp-items="ViewBag.Branches" class="form-select">
                            <option value="">Select a branch</option>
                        </select>
                        <span asp-validation-for="BranchID" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CurrentLocationID" class="form-label">Location <span class="register-optional">(optional)</span></label>
                        <select asp-for="CurrentLocationID" id="locationSelect" class="form-select">
                            <option value="">-- Pick a branch first --</option>
                            @foreach (var loc in (List<SchoolInventoryManagement.BLL.DTOs.LocationDTO>)ViewBag.LocationsByBranch)
                            {
                                <option value="@loc.LocationID" data-branch="@loc.BranchID" data-code="@loc.LocationCode"
                                        selected="@(loc.LocationID == Model.CurrentLocationID)">@loc.LocationName (@loc.LocationCode)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DepartmentID" class="form-label">Department</label>
                        <select asp-for="DepartmentID" id="departmentSelect" class="form-select">
                            <option value="">-- Pick a branch first --</option>
                            @foreach (var dept in (List<SchoolInventoryManagement.BLL.DTOs.DepartmentDTO>)ViewBag.DepartmentsByBranch)
                            {
                                <option value="@dept.DepartmentID" data-branch="@dept.BranchID"
                                        selected="@(dept.DepartmentID == Model.DepartmentID)">@dept.DepartmentName</option>
                            }
                        </select>
                        <span asp-validation-for="DepartmentID" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-label">Condition</div>
                        <partial name="_ConditionChips" model="Model.Condition" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="AcquisitionDate" class="form-label">Acquired on <span class="register-optional">(optional)</span></label>
                            <input asp-for="AcquisitionDate" type="date" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label asp-for="AcquisitionCost" class="form-label">Cost each <span class="register-optional">(optional)</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₱</span>
                                <input asp-for="AcquisitionCost" id="unitCost" type="number" step="0.01" min="0" placeholder="0.00" class="form-control" />
                            </div>
                            <span asp-validation-for="AcquisitionCost" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WarrantyInformation" class="form-label">Warranty <span class="register-optional">(optional)</span></label>
                        <input asp-for="WarrantyInformation" class="form-control" placeholder="e.g. 1 year, until Mar 2027" />
                    </div>

                    <div class="mb-3">
                        <div class="form-label">Warranty photo or file <span class="register-optional">(optional)</span></div>
                        <label class="file-drop file-drop-row">
                            <span class="file-drop-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6v18h12V7z" /><path d="M14 3v4h4" /></svg>
                            </span>
                            <span class="flex-grow-1">
                                <span class="file-drop-title" data-empty="Linked to every unit">Linked to every unit</span>
                                <span class="file-drop-sub">Photo or PDF · up to @FileUploads.MaxMegabytes MB</span>
                            </span>
                            <span class="btn btn-outline-secondary btn-sm">Choose</span>
                            <input asp-for="WarrantyFile" type="file" accept="@FileUploads.DocumentAccept"
                                   data-max-bytes="@FileUploads.MaxBytes" class="file-drop-input" />
                        </label>
                    </div>

                    <div>
                        <label asp-for="Description" class="form-label">Description <span class="register-optional">(optional)</span></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Shared notes for the whole batch."></textarea>
                    </div>
                </div>
            </div>

            <div class="asset-card register-toggle">
                <span class="register-toggle-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6v12M7 6v12M11 6v12M14 6v12M18 6v12M20 6v12" /></svg>
                </span>
                <label for="createBarcode" class="flex-grow-1 mb-0">
                    <span class="register-toggle-title" id="barcodeTitle">Barcode labels for every unit</span>
                    <span class="register-toggle-sub">Left off, none are made; you can add one later from each asset's page.</span>
                </label>
                <div class="form-check form-switch m-0">
                    <input asp-for="CreateBarcode" type="checkbox" role="switch" id="createBarcode" class="form-check-input" />
                </div>
            </div>
        </div>
    </div>

    <div class="register-footer">
        <span>Nothing is saved unless every unit can be.</span>
        <div class="d-flex" style="gap:8px;">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" id="submitBtn" class="btn btn-primary">Register assets</button>
        </div>
    </div>
</form>

<partial name="_QuickAddModel" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            var quantity = document.getElementById('quantity');
            var baseName = document.getElementById('baseName');
            var serials = document.getElementById('serialNumbers');
            var gutter = document.getElementById('serialGutter');
            var previewHead = document.getElementById('previewHead');
            var previewBody = document.getElementById('previewBody');
            var serialCount = document.getElementById('serialCount');
            var submitBtn = document.getElementById('submitBtn');
            var unitCost = document.getElementById('unitCost');
            var createBarcode = document.getElementById('createBarcode');
            var maxNumber = @SchoolInventoryManagement.BLL.Services.AssetCodes.MaxNumber;
            var branchSelect = document.getElementById('branchSelect');
            var locationSelect = document.getElementById('locationSelect');
            var branchCodes = @Json.Serialize(ViewBag.BranchCodes);

            // The picked model's category code and next free number, from
            // the model search box.
            var picked = null;
            var autoName = '';

            // Mirrors AssetService: code {category}-{number:D4}, barcode
            // {branch}-{location}-{code}, name "{name} - Unit {number}".
            function pad(n) {
                var s = String(n);
                while (s.length < 4) s = '0' + s;
                return s;
            }

            function codeFor(number) { return picked.prefix + '-' + pad(number); }

            // "M-LIB", or null until a branch is picked. XXX with no location.
            function codeStart() {
                var branchCode = branchCodes[branchSelect.value];
                if (!branchCode) return null;
                var option = locationSelect.options[locationSelect.selectedIndex];
                return branchCode + '-' + ((option && option.getAttribute('data-code')) || '@SchoolInventoryManagement.BLL.Services.AssetCodes.NoLocation');
            }

            function escapeHtml(text) {
                var div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            // ₱27.8K, ₱1.2M -- the summary tile is narrow.
            function compactPeso(value) {
                if (value >= 1e6) return '₱' + (value / 1e6).toFixed(1).replace(/\.0$/, '') + 'M';
                if (value >= 1e3) return '₱' + (value / 1e3).toFixed(1).replace(/\.0$/, '') + 'K';
                return '₱' + value.toFixed(2).replace(/\.00$/, '');
            }

            function update() {
                var qty = parseInt(quantity.value, 10) || 0;
                var n = baseName.value.trim();
                var valid = picked && qty >= 1 && qty <= 200 && picked.next + qty - 1 <= maxNumber;

                // Barcodes are only shown when "Add barcode" is on and a
                // branch is picked.
                var start = createBarcode.checked ? codeStart() : null;
                function row(number) {
                    var code = codeFor(number);
                    return '<div class="bulk-preview-row"><span class="asset-code-chip">' + escapeHtml(code) + '</span>'
                        + '<span>' + escapeHtml(n + ' - Unit ' + number) + '</span>'
                        + (start ? '<span class="bulk-preview-barcode">' + escapeHtml(start + '-' + code) + '</span>' : '')
                        + '</div>';
                }

                previewBody.innerHTML = '';
                if (!picked || qty < 1 || !n) {
                    previewHead.textContent = 'Pick a model and enter a name to see the codes.';
                } else if (!valid && picked.next + qty - 1 > maxNumber) {
                    var left = Math.max(0, maxNumber - picked.next + 1);
                    previewHead.innerHTML = '<span class="text-danger">Only ' + left + ' code' + (left === 1 ? '' : 's')
                        + ' left for ' + escapeHtml(picked.prefix) + '. Register fewer, or give the category a new code.</span>';
                } else {
                    var first = picked.next;
                    var last = first + qty - 1;
                    previewHead.innerHTML = 'Will create <strong>' + qty + ' unit' + (qty === 1 ? '' : 's') + '</strong>'
                        + ' &middot; <span class="asset-code-chip">' + escapeHtml(codeFor(first)) + '</span>'
                        + (qty > 1 ? ' to <span class="asset-code-chip">' + escapeHtml(codeFor(last)) + '</span>' : '');

                    // First three, then "N more", then the last one.
                    var html = '';
                    var shown = Math.min(qty, 3);
                    for (var i = 0; i < shown; i++) html += row(first + i);
                    if (qty > 4) {
                        html += '<div class="bulk-preview-row bulk-preview-more"><span>&vellip;</span><span>'
                            + (qty - 4) + ' more unit' + (qty - 4 === 1 ? '' : 's') + '</span></div>';
                    }
                    if (qty > 3) html += row(last);
                    previewBody.innerHTML = html;
                }

                // Serial lines line up with the codes; blanks are fine.
                var lines = serials.value.split('\n');
                while (lines.length && !lines[lines.length - 1].trim()) lines.pop();
                var filled = lines.filter(function (l) { return l.trim().length > 0; }).length;
                if (!lines.length) {
                    serialCount.className = 'bulk-serial-count d-none';
                } else if (lines.length > qty) {
                    serialCount.textContent = lines.length + ' lines for ' + qty;
                    serialCount.className = 'bulk-serial-count is-error';
                } else {
                    serialCount.textContent = filled + ' of ' + qty + ' filled';
                    serialCount.className = 'bulk-serial-count';
                }

                // Gutter: one code per line, as many lines as units (or
                // typed lines, whichever is more, so extras stand out).
                var gutterLines = Math.max(qty, lines.length, 1);
                var g = '';
                for (var k = 0; k < gutterLines; k++) {
                    var label = picked && k < qty ? codeFor(picked.next + k) : (k < qty ? '#' + (k + 1) : 'extra');
                    g += '<div class="' + (k >= qty ? 'is-extra' : '') + '">' + escapeHtml(label) + '</div>';
                }
                gutter.innerHTML = g;
                serials.rows = Math.min(Math.max(qty, 3), 10);
                gutter.scrollTop = serials.scrollTop;

                // Summary tile.
                var cost = parseFloat(unitCost.value);
                document.getElementById('sumUnits').textContent = qty > 0 ? qty : 0;
                sabShow(document.getElementById('sumCost'), qty > 0 && cost > 0 ? compactPeso(cost * qty) : '', 'Not set');
                document.getElementById('sumSerials').textContent = filled;
                document.getElementById('sharedSub').textContent = qty > 0
                    ? 'Set once, applied to all ' + qty + '.'
                    : 'Set once, applied to all of them.';
                document.getElementById('barcodeTitle').textContent = qty > 0
                    ? 'Barcode labels for all ' + qty
                    : 'Barcode labels for every unit';

                submitBtn.textContent = qty > 0
                    ? 'Register ' + qty + ' asset' + (qty === 1 ? '' : 's')
                    : 'Register assets';
            }

            document.addEventListener('model-picked', function (e) {
                picked = e.detail;
                // Start the name off as the model's name if nothing is typed.
                if (picked && (!baseName.value.trim() || baseName.value === autoName)) {
                    baseName.value = picked.name;
                    autoName = picked.name;
                }
                update();
            });

            [quantity, baseName, serials, unitCost].forEach(function (el) {
                el.addEventListener('input', update);
            });
            serials.addEventListener('scroll', function () { gutter.scrollTop = serials.scrollTop; });
            createBarcode.addEventListener('change', update);

            // − / + beside the quantity.
            document.querySelectorAll('.qty-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var qty = (parseInt(quantity.value, 10) || 0) + parseInt(btn.getAttribute('data-step'), 10);
                    quantity.value = Math.min(200, Math.max(1, qty));
                    update();
                });
            });

            // ---- Location and department follow branch -----------------
            // Each list only ever holds the chosen branch's entries, and
            // stays locked until a branch is picked. Options are rebuilt
            // rather than hidden, because some browsers ignore "hidden" on
            // <option>.
            if (!branchSelect) return;

            function followBranch(select, emptyText) {
                if (!select) return;

                var all = Array.from(select.options)
                    .filter(function (o) { return o.value; })
                    .map(function (o) {
                        return { value: o.value, text: o.text, branch: o.getAttribute('data-branch'), code: o.getAttribute('data-code') };
                    });
                var selected = select.value;

                function rebuild() {
                    var branchId = branchSelect.value;
                    select.innerHTML = '';

                    var placeholder = document.createElement('option');
                    placeholder.value = '';
                    placeholder.text = branchId ? emptyText : '-- Pick a branch first --';
                    select.appendChild(placeholder);

                    all
                        .filter(function (x) { return x.branch === branchId; })
                        .forEach(function (x) {
                            var opt = document.createElement('option');
                            opt.value = x.value;
                            opt.text = x.text;
                            if (x.code) opt.setAttribute('data-code', x.code);
                            if (x.value === selected) opt.selected = true;
                            select.appendChild(opt);
                        });

                    select.disabled = !branchId;
                }

                branchSelect.addEventListener('change', function () {
                    selected = ''; // a new branch means its own entries
                    rebuild();
                });
                select.addEventListener('change', function () {
                    selected = select.value;
                });

                rebuild(); // on load too, so an edit or a failed post shows the right list
            }

            followBranch(locationSelect, '-- None --');
            followBranch(document.getElementById('departmentSelect'), '-- Select Department --');

            // After followBranch, so the location list is rebuilt first.
            branchSelect.addEventListener('change', update);
            locationSelect.addEventListener('change', update);
            update();
        })();
    </script>
}
