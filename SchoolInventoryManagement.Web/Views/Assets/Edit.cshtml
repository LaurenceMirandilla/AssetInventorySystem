@model SchoolInventoryManagement.Web.ViewModels.AssetEditViewModel
@{
    ViewData["Title"] = "Edit Asset";
}

<h2>Edit Asset</h2>

<form asp-action="Edit" asp-route-id="@Model.AssetID" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="AssetID" />
    <input type="hidden" asp-for="RowVersionBase64" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="AssetName" class="form-label"></label>
        <input asp-for="AssetName" class="form-control" />
        <span asp-validation-for="AssetName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="SerialNumber" class="form-label"></label>
        <input asp-for="SerialNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Condition" class="form-label"></label>
        <select asp-for="Condition" class="form-select"
                asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.ConditionStatus>()"></select>
        <div class="form-text">Its physical state right now — for example, mark it Damaged if a crack is found on the shelf.</div>
    </div>

    <div class="mb-3">
        <label asp-for="AcquisitionCost" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">₱</span>
            <input asp-for="AcquisitionCost" type="number" step="0.01" min="0" placeholder="0.00" class="form-control" />
        </div>
        <span asp-validation-for="AcquisitionCost" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="WarrantyInformation" class="form-label"></label>
        <input asp-for="WarrantyInformation" class="form-control" placeholder="e.g. 1 year, until Mar 2027" />
    </div>

    @* The current files are not sent back with the form: the server reads
       them from the database, so saving without choosing a new file keeps
       them and nobody can swap in a file of their own. *@
    <div class="mb-3">
        <label asp-for="WarrantyFile" class="form-label">Warranty photo or file <span class="text-muted">(optional)</span></label>
        @if (!string.IsNullOrWhiteSpace(Model.WarrantyFileURL))
        {
            <div class="mb-2 d-flex align-items-center" style="gap:12px;">
                <a href="@Model.WarrantyFileURL" target="_blank" rel="noopener">View current warranty file</a>
                <div class="form-check mb-0">
                    <input asp-for="RemoveWarrantyFile" class="form-check-input" />
                    <label asp-for="RemoveWarrantyFile" class="form-check-label small">Remove it</label>
                </div>
            </div>
        }
        <input asp-for="WarrantyFile" type="file" accept="@SchoolInventoryManagement.Web.Helpers.FileUploads.DocumentAccept"
               data-max-bytes="@SchoolInventoryManagement.Web.Helpers.FileUploads.MaxBytes" class="form-control" />
        <div class="form-text">
            A photo of the warranty card or receipt, or a PDF. Max @SchoolInventoryManagement.Web.Helpers.FileUploads.MaxMegabytes MB.
            @if (!string.IsNullOrWhiteSpace(Model.WarrantyFileURL))
            {
                <text>Choosing a new file replaces the current one.</text>
            }
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">Photo <span class="text-muted">(optional)</span></label>
        @if (!string.IsNullOrWhiteSpace(Model.ImageURL))
        {
            <div class="mb-2">
                <img src="@Model.ImageURL" alt="Current photo" class="rounded border" style="max-height:120px;" />
            </div>
        }
        <input asp-for="ImageFile" type="file" accept="@SchoolInventoryManagement.Web.Helpers.FileUploads.ImageAccept"
               data-max-bytes="@SchoolInventoryManagement.Web.Helpers.FileUploads.MaxBytes" class="form-control" />
        <div class="form-text">
            JPG, PNG or WEBP. Max @SchoolInventoryManagement.Web.Helpers.FileUploads.MaxMegabytes MB.
            @if (!string.IsNullOrWhiteSpace(Model.ImageURL))
            {
                <text>Leave empty to keep the current photo.</text>
            }
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="BranchID" class="form-label">Branch</label>
        <select asp-for="BranchID" id="branchSelect" asp-items="ViewBag.Branches" class="form-select">
            <option value="">-- Select Branch --</option>
        </select>
        <span asp-validation-for="BranchID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CurrentLocationID" class="form-label">Location</label>
        <select asp-for="CurrentLocationID" id="locationSelect" class="form-select">
            <option value="">-- Pick a branch first --</option>
            @foreach (var loc in (List<SchoolInventoryManagement.BLL.DTOs.LocationDTO>)ViewBag.LocationsByBranch)
            {
                <option value="@loc.LocationID" data-branch="@loc.BranchID"
                        selected="@(loc.LocationID == Model.CurrentLocationID)">@loc.LocationName</option>
            }
        </select>
        <div class="form-text">Only locations in the chosen branch are listed.</div>
    </div>

    <div class="mb-3">
        <label asp-for="DepartmentID" class="form-label">Department</label>
        <select asp-for="DepartmentID" id="departmentSelect" class="form-select">
            <option value="">-- Pick a branch first --</option>
            @foreach (var dept in (List<SchoolInventoryManagement.BLL.DTOs.DepartmentDTO>)ViewBag.DepartmentsByBranch)
            {
                <option value="@dept.DepartmentID" data-branch="@dept.BranchID"
                        selected="@(dept.DepartmentID == Model.DepartmentID)">@dept.DepartmentName</option>
            }
        </select>
        <span asp-validation-for="DepartmentID" class="text-danger"></span>
        <div class="form-text">Only departments in the chosen branch are listed.</div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@Model.AssetID" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            // ---- Location and department follow branch -----------------
            // Each list only ever holds the chosen branch's entries, and
            // stays locked until a branch is picked. Options are rebuilt
            // rather than hidden, because some browsers ignore "hidden" on
            // <option>.
            var branchSelect = document.getElementById('branchSelect');
            if (!branchSelect) return;

            function followBranch(select, emptyText) {
                if (!select) return;

                var all = Array.from(select.options)
                    .filter(function (o) { return o.value; })
                    .map(function (o) {
                        return { value: o.value, text: o.text, branch: o.getAttribute('data-branch') };
                    });
                var selected = select.value;

                function rebuild() {
                    var branchId = branchSelect.value;
                    select.innerHTML = '';

                    var placeholder = document.createElement('option');
                    placeholder.value = '';
                    placeholder.text = branchId ? emptyText : '-- Pick a branch first --';
                    select.appendChild(placeholder);

                    all
                        .filter(function (x) { return x.branch === branchId; })
                        .forEach(function (x) {
                            var opt = document.createElement('option');
                            opt.value = x.value;
                            opt.text = x.text;
                            if (x.value === selected) opt.selected = true;
                            select.appendChild(opt);
                        });

                    select.disabled = !branchId;
                }

                branchSelect.addEventListener('change', function () {
                    selected = ''; // a new branch means its own entries
                    rebuild();
                });
                select.addEventListener('change', function () {
                    selected = select.value;
                });

                rebuild(); // on load too, so an edit or a failed post shows the right list
            }

            followBranch(document.getElementById('locationSelect'), '-- None --');
            followBranch(document.getElementById('departmentSelect'), '-- Select Department --');
        })();
    </script>
}