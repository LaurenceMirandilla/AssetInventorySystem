@model SchoolInventoryManagement.Web.ViewModels.AssetEditViewModel
@using SchoolInventoryManagement.BLL.DTOs
@using SchoolInventoryManagement.DAL.Entities.Enums
@using SchoolInventoryManagement.Web.Helpers
@{
    ViewData["Title"] = "Edit Asset";
    var asset = (AssetResponseDTO)ViewBag.Asset;
    var lastEdit = ViewBag.LastEdit as string;
    var warrantyFileName = string.IsNullOrWhiteSpace(Model.WarrantyFileURL) ? null : System.IO.Path.GetFileName(Model.WarrantyFileURL);
    var warrantyIsPdf = warrantyFileName?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true;
}

<div class="asset-detail-head">
    <div>
        <nav class="asset-crumbs" aria-label="Breadcrumb">
            <a asp-action="Index">Assets</a>
            <span aria-hidden="true">&rsaquo;</span>
            <a asp-action="Details" asp-route-id="@asset.AssetID">@asset.AssetCode</a>
            <span aria-hidden="true">&rsaquo;</span>
            <span>Edit</span>
        </nav>
        <h2 class="asset-detail-title">Edit asset</h2>
        <div class="asset-detail-sub">Update this unit's details. Changes are saved to its audit log.</div>
    </div>
</div>

<partial name="_AssetStrip" model="asset" />

<form asp-action="Edit" asp-route-id="@Model.AssetID" method="post" enctype="multipart/form-data" class="register-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="AssetID" />
    <input type="hidden" asp-for="RowVersionBase64" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="asset-card register-step mb-3">
                <div class="register-step-head">
                    <span class="register-step-num">1</span>
                    <div>
                        <div class="register-step-title">What it is</div>
                        <div class="register-step-sub">The model and code can't be changed here.</div>
                    </div>
                </div>
                <div class="register-step-body">
                    <div class="mb-3">
                        <label asp-for="AssetName" class="form-label">Asset name</label>
                        <input asp-for="AssetName" class="form-control" />
                        <span asp-validation-for="AssetName" class="text-danger"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label asp-for="SerialNumber" class="form-label">Serial number <span class="register-optional">(optional)</span></label>
                            <input asp-for="SerialNumber" class="form-control" />
                        </div>
                        <div class="col-md-7">
                            <div class="form-label">Condition</div>
                            <partial name="_ConditionChips" model="Model.Condition" />
                            <div class="form-text">Its physical state right now — e.g. mark it Damaged if a crack is found.</div>
                        </div>
                    </div>

                    <div>
                        <label asp-for="Description" class="form-label">Description <span class="register-optional">(optional)</span></label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Colour, accessories, marks..."></textarea>
                    </div>
                </div>
            </div>

            <div class="asset-card register-step mb-3">
                <div class="register-step-head">
                    <span class="register-step-num">2</span>
                    <div>
                        <div class="register-step-title">Purchase &amp; warranty</div>
                        <div class="register-step-sub">Cost counts toward the value-in-service total.</div>
                    </div>
                </div>
                <div class="register-step-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="AcquisitionCost" class="form-label">Cost <span class="register-optional">(optional)</span></label>
                            <div class="input-group">
                                <span class="input-group-text">₱</span>
                                <input asp-for="AcquisitionCost" type="number" step="0.01" min="0" placeholder="0.00" class="form-control" />
                            </div>
                            <span asp-validation-for="AcquisitionCost" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WarrantyInformation" class="form-label">Warranty <span class="register-optional">(optional)</span></label>
                            <input asp-for="WarrantyInformation" class="form-control" placeholder="e.g. 1 year, until Mar 2027" />
                        </div>
                    </div>

                    @* The current file is not sent back with the form: the
                       server reads it from the database, so saving without
                       choosing a new file keeps it and nobody can swap in a
                       file of their own. *@
                    <div class="form-label">Warranty photo or file <span class="register-optional">(optional)</span></div>
                    @if (warrantyFileName != null)
                    {
                        <div class="current-file mb-2">
                            <span class="current-file-icon @(warrantyIsPdf ? "is-pdf" : "")">@(warrantyIsPdf ? "PDF" : "IMG")</span>
                            <div class="flex-grow-1 min-w-0">
                                <a href="@Model.WarrantyFileURL" target="_blank" rel="noopener" class="current-file-link">View current warranty file</a>
                                <div class="current-file-name">@warrantyFileName</div>
                            </div>
                            <div class="form-check mb-0">
                                <input asp-for="RemoveWarrantyFile" class="form-check-input" />
                                <label asp-for="RemoveWarrantyFile" class="form-check-label small">Remove it</label>
                            </div>
                        </div>
                    }
                    <label class="file-drop file-drop-row">
                        <span class="file-drop-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6v18h12V7z" /><path d="M14 3v4h4" /></svg>
                        </span>
                        <span class="flex-grow-1">
                            @{ var dropText = warrantyFileName != null ? "Choose a new file to replace it" : "Drop the warranty card or receipt here"; }
                            <span class="file-drop-title" data-empty="@dropText">@dropText</span>
                            <span class="file-drop-sub">Photo or PDF · up to @FileUploads.MaxMegabytes MB</span>
                        </span>
                        <input asp-for="WarrantyFile" type="file" accept="@FileUploads.DocumentAccept"
                               data-max-bytes="@FileUploads.MaxBytes" class="file-drop-input" />
                    </label>
                </div>
            </div>

            <div class="asset-card register-step mb-3">
                <div class="register-step-head">
                    <span class="register-step-num">3</span>
                    <div>
                        <div class="register-step-title">Where it is</div>
                        <div class="register-step-sub">Choose the branch first — locations and departments follow it.</div>
                    </div>
                </div>
                <div class="register-step-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="BranchID" class="form-label">Branch</label>
                            <select asp-for="BranchID" id="branchSelect" asp-items="ViewBag.Branches" class="form-select">
                                <option value="">Select a branch</option>
                            </select>
                            <span asp-validation-for="BranchID" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CurrentLocationID" class="form-label">Location <span class="register-optional">(optional)</span></label>
                            <select asp-for="CurrentLocationID" id="locationSelect" class="form-select">
                                <option value="">-- Pick a branch first --</option>
                                @foreach (var loc in (List<LocationDTO>)ViewBag.LocationsByBranch)
                                {
                                    <option value="@loc.LocationID" data-branch="@loc.BranchID"
                                            selected="@(loc.LocationID == Model.CurrentLocationID)">@loc.LocationName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DepartmentID" class="form-label">Department</label>
                            <select asp-for="DepartmentID" id="departmentSelect" class="form-select">
                                <option value="">-- Pick a branch first --</option>
                                @foreach (var dept in (List<DepartmentDTO>)ViewBag.DepartmentsByBranch)
                                {
                                    <option value="@dept.DepartmentID" data-branch="@dept.BranchID"
                                            selected="@(dept.DepartmentID == Model.DepartmentID)">@dept.DepartmentName</option>
                                }
                            </select>
                            <span asp-validation-for="DepartmentID" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="asset-card register-side mb-3">
                <div class="register-side-title">Photo <span class="register-optional">(optional)</span></div>
                <label class="file-drop file-drop-tall edit-photo" data-preview="true">
                    <img class="file-drop-preview @(string.IsNullOrWhiteSpace(Model.ImageURL) ? "d-none" : "")"
                         src="@(string.IsNullOrWhiteSpace(Model.ImageURL) ? null : Model.ImageURL)" alt="" />
                    <span class="file-drop-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
                    </span>
                    @{ var photoText = string.IsNullOrWhiteSpace(Model.ImageURL) ? "Drop a photo or click to upload" : "Replace photo"; }
                    <span class="file-drop-title" data-empty="@photoText">@photoText</span>
                    <span class="file-drop-sub">JPG, PNG or WebP · up to @FileUploads.MaxMegabytes MB</span>
                    <input asp-for="ImageFile" type="file" accept="@FileUploads.ImageAccept"
                           data-max-bytes="@FileUploads.MaxBytes" class="file-drop-input" />
                </label>
            </div>

            @if (asset.Status == AssetStatus.Available)
            {
                <div class="asset-card register-side">
                    <div class="register-side-title mb-1">Moving it somewhere else?</div>
                    <div class="register-side-note">
                        Use <a asp-controller="AssetMovements" asp-action="Transfer" asp-route-id="@asset.AssetID" class="fw-semibold">Transfer</a>
                        instead of changing the location here — a transfer is recorded in the asset's movement history.
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="register-footer">
        <span>@(lastEdit ?? "Changes are saved to the audit log.")</span>
        <div class="d-flex" style="gap:8px;">
            <a asp-action="Details" asp-route-id="@Model.AssetID" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            // ---- Location and department follow branch -----------------
            // Each list only ever holds the chosen branch's entries, and
            // stays locked until a branch is picked. Options are rebuilt
            // rather than hidden, because some browsers ignore "hidden" on
            // <option>.
            var branchSelect = document.getElementById('branchSelect');
            if (!branchSelect) return;

            function followBranch(select, emptyText) {
                if (!select) return;

                var all = Array.from(select.options)
                    .filter(function (o) { return o.value; })
                    .map(function (o) {
                        return { value: o.value, text: o.text, branch: o.getAttribute('data-branch') };
                    });
                var selected = select.value;

                function rebuild() {
                    var branchId = branchSelect.value;
                    select.innerHTML = '';

                    var placeholder = document.createElement('option');
                    placeholder.value = '';
                    placeholder.text = branchId ? emptyText : '-- Pick a branch first --';
                    select.appendChild(placeholder);

                    all
                        .filter(function (x) { return x.branch === branchId; })
                        .forEach(function (x) {
                            var opt = document.createElement('option');
                            opt.value = x.value;
                            opt.text = x.text;
                            if (x.value === selected) opt.selected = true;
                            select.appendChild(opt);
                        });

                    select.disabled = !branchId;
                }

                branchSelect.addEventListener('change', function () {
                    selected = ''; // a new branch means its own entries
                    rebuild();
                });
                select.addEventListener('change', function () {
                    selected = select.value;
                });

                rebuild(); // on load too, so an edit or a failed post shows the right list
            }

            followBranch(document.getElementById('locationSelect'), '-- None --');
            followBranch(document.getElementById('departmentSelect'), '-- Select Department --');
        })();
    </script>
}