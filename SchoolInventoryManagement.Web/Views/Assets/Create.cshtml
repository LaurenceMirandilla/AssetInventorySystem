@model SchoolInventoryManagement.Web.ViewModels.AssetCreateViewModel
@{
    ViewData["Title"] = "New Asset";
    var modelChoices = (List<SchoolInventoryManagement.Web.ViewModels.ModelCodeOption>)ViewBag.ModelChoices;
    ViewData["SelectedModelId"] = Model.ModelID;
}

<h2>New Asset</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <partial name="_ModelPicker" model="modelChoices" view-data="ViewData" />
    </div>

    @* The code is not typed: it comes from the model's category and the
       next free number, and is shown here before saving. *@
    <div class="mb-3">
        <div class="form-label">Asset code</div>
        <div id="codePreview" class="fw-semibold sab-code">Pick a model to see its code.</div>
        <div class="form-text">Given automatically when you save, and never changes.</div>
    </div>

    <div class="mb-3">
        <label asp-for="AssetName" class="form-label"></label>
        <input asp-for="AssetName" id="assetName" class="form-control" />
        <span asp-validation-for="AssetName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="SerialNumber" class="form-label"></label>
        <input asp-for="SerialNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AcquisitionDate" class="form-label"></label>
        <input asp-for="AcquisitionDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AcquisitionCost" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">₱</span>
            <input asp-for="AcquisitionCost" type="number" step="0.01" min="0" placeholder="0.00" class="form-control" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="WarrantyInformation" class="form-label"></label>
        <input asp-for="WarrantyInformation" class="form-control" placeholder="e.g. 1 year, until Mar 2027" />
    </div>

    <div class="mb-3">
        <label asp-for="WarrantyFile" class="form-label">Warranty photo or file <span class="text-muted">(optional)</span></label>
        <input asp-for="WarrantyFile" type="file" accept="@SchoolInventoryManagement.Web.Helpers.FileUploads.DocumentAccept"
               data-max-bytes="@SchoolInventoryManagement.Web.Helpers.FileUploads.MaxBytes" class="form-control" />
        <div class="form-text">A photo of the warranty card or receipt, or a PDF. Max @SchoolInventoryManagement.Web.Helpers.FileUploads.MaxMegabytes MB.</div>
    </div>

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">Photo <span class="text-muted">(optional)</span></label>
        <input asp-for="ImageFile" type="file" accept="@SchoolInventoryManagement.Web.Helpers.FileUploads.ImageAccept"
               data-max-bytes="@SchoolInventoryManagement.Web.Helpers.FileUploads.MaxBytes" class="form-control" />
        <div class="form-text">JPG, PNG or WEBP. Max @SchoolInventoryManagement.Web.Helpers.FileUploads.MaxMegabytes MB.</div>
    </div>
    <div class="mb-3">
        <label asp-for="Condition" class="form-label"></label>
        <select asp-for="Condition" asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.ConditionStatus>()" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="BranchID" class="form-label">Branch</label>
        <select asp-for="BranchID" id="branchSelect" asp-items="ViewBag.Branches" class="form-select">
            <option value="">-- Select Branch --</option>
        </select>
        <span asp-validation-for="BranchID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CurrentLocationID" class="form-label">Location</label>
        <select asp-for="CurrentLocationID" id="locationSelect" class="form-select">
            <option value="">-- Pick a branch first --</option>
            @foreach (var loc in (List<SchoolInventoryManagement.BLL.DTOs.LocationDTO>)ViewBag.LocationsByBranch)
            {
                <option value="@loc.LocationID" data-branch="@loc.BranchID" data-code="@loc.LocationCode"
                        selected="@(loc.LocationID == Model.CurrentLocationID)">@loc.LocationName (@loc.LocationCode)</option>
            }
        </select>
        <div class="form-text">Only locations in the chosen branch are listed.</div>
    </div>

    <div class="mb-3">
        <label asp-for="DepartmentID" class="form-label">Department</label>
        <select asp-for="DepartmentID" id="departmentSelect" class="form-select">
            <option value="">-- Pick a branch first --</option>
            @foreach (var dept in (List<SchoolInventoryManagement.BLL.DTOs.DepartmentDTO>)ViewBag.DepartmentsByBranch)
            {
                <option value="@dept.DepartmentID" data-branch="@dept.BranchID"
                        selected="@(dept.DepartmentID == Model.DepartmentID)">@dept.DepartmentName</option>
            }
        </select>
        <span asp-validation-for="DepartmentID" class="text-danger"></span>
        <div class="form-text">Only departments in the chosen branch are listed.</div>
    </div>

    <div class="mb-3">
        <div class="form-label">Barcode label</div>
        <input asp-for="CreateBarcode" type="checkbox" id="createBarcode" class="btn-check" autocomplete="off" />
        <label for="createBarcode" id="createBarcodeLabel" class="btn btn-outline-primary">Add barcode</label>
        <div class="form-text">Click to make a barcode when the asset is saved. Leave it off to save without one; you can still add it later from the asset's page.</div>
        <div id="barcodePreview" class="form-text sab-code"></div>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

<partial name="_QuickAddModel" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            var branchSelect = document.getElementById('branchSelect');
            var locationSelect = document.getElementById('locationSelect');

            // ---- Code preview and name --------------------------------
            // Shows the asset code a save would give (AssetCodes.Format) and
            // the barcode it would get (AssetCodes.Barcode: branch letter,
            // location code or XXX, asset code). Picking a model also starts
            // the name off as the model's name if nothing is typed yet.
            var codePreview = document.getElementById('codePreview');
            var barcodePreview = document.getElementById('barcodePreview');
            var assetName = document.getElementById('assetName');
            var branchCodes = @Json.Serialize(ViewBag.BranchCodes);
            var maxNumber = @SchoolInventoryManagement.BLL.Services.AssetCodes.MaxNumber;
            var picked = null;
            var autoName = '';

            function pad(n) { var s = String(n); while (s.length < 4) s = '0' + s; return s; }

            function updateCode() {
                barcodePreview.textContent = '';
                if (!picked) {
                    codePreview.textContent = 'Pick a model to see its code.';
                    return;
                }
                if (picked.next > maxNumber) {
                    codePreview.textContent = picked.prefix + ' has no numbers left — give the category a new code.';
                    return;
                }
                var code = picked.prefix + '-' + pad(picked.next);
                codePreview.textContent = code;

                var branchCode = branchCodes[branchSelect.value];
                if (!branchCode) return;
                var option = locationSelect.options[locationSelect.selectedIndex];
                var locationCode = (option && option.getAttribute('data-code')) || '@SchoolInventoryManagement.BLL.Services.AssetCodes.NoLocation';
                barcodePreview.textContent = 'Barcode if added: ' + branchCode + '-' + locationCode + '-' + code;
            }

            document.addEventListener('model-picked', function (e) {
                picked = e.detail;
                if (picked && (!assetName.value.trim() || assetName.value === autoName)) {
                    assetName.value = picked.name;
                    autoName = picked.name;
                }
                updateCode();
            });

            // ---- Add barcode toggle -------------------------------------
            // The label says what will happen, so "on" isn't just a color.
            var createBarcode = document.getElementById('createBarcode');
            var createBarcodeLabel = document.getElementById('createBarcodeLabel');
            function syncBarcode() {
                createBarcodeLabel.textContent = createBarcode.checked ? '✓ Barcode will be added' : 'Add barcode';
            }
            createBarcode.addEventListener('change', syncBarcode);
            syncBarcode(); // a failed post keeps the choice

            // ---- Location and department follow branch -----------------
            // Each list only ever holds the chosen branch's entries, and
            // stays locked until a branch is picked. Options are rebuilt
            // rather than hidden, because some browsers ignore "hidden" on
            // <option>.
            if (!branchSelect) return;

            function followBranch(select, emptyText) {
                if (!select) return;

                var all = Array.from(select.options)
                    .filter(function (o) { return o.value; })
                    .map(function (o) {
                        return { value: o.value, text: o.text, branch: o.getAttribute('data-branch'), code: o.getAttribute('data-code') };
                    });
                var selected = select.value;

                function rebuild() {
                    var branchId = branchSelect.value;
                    select.innerHTML = '';

                    var placeholder = document.createElement('option');
                    placeholder.value = '';
                    placeholder.text = branchId ? emptyText : '-- Pick a branch first --';
                    select.appendChild(placeholder);

                    all
                        .filter(function (x) { return x.branch === branchId; })
                        .forEach(function (x) {
                            var opt = document.createElement('option');
                            opt.value = x.value;
                            opt.text = x.text;
                            if (x.code) opt.setAttribute('data-code', x.code);
                            if (x.value === selected) opt.selected = true;
                            select.appendChild(opt);
                        });

                    select.disabled = !branchId;
                }

                branchSelect.addEventListener('change', function () {
                    selected = ''; // a new branch means its own entries
                    rebuild();
                });
                select.addEventListener('change', function () {
                    selected = select.value;
                });

                rebuild(); // on load too, so an edit or a failed post shows the right list
            }

            followBranch(locationSelect, '-- None --');
            followBranch(document.getElementById('departmentSelect'), '-- Select Department --');

            // After followBranch, so the location list is rebuilt first.
            branchSelect.addEventListener('change', updateCode);
            locationSelect.addEventListener('change', updateCode);
            updateCode();
        })();
    </script>
}