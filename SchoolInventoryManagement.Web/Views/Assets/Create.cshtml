@model SchoolInventoryManagement.Web.ViewModels.AssetCreateViewModel
@{
    ViewData["Title"] = "New Asset";
    var modelChoices = (List<SchoolInventoryManagement.Web.ViewModels.ModelCodeOption>)ViewBag.ModelChoices;
    ViewData["SelectedModelId"] = Model.ModelID;
}

<h2>New Asset</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <partial name="_ModelPicker" model="modelChoices" view-data="ViewData" />
    </div>

    @* The code is not typed: it comes from the model's category prefix and
       the next free number, and is shown here before saving. *@
    <div class="mb-3">
        <div class="form-label">Asset code</div>
        <div id="codePreview" class="fw-semibold sab-code">Pick a model to see its code.</div>
        <div class="form-text">Given automatically when you save.</div>
    </div>

    <div class="mb-3">
        <label asp-for="AssetName" class="form-label"></label>
        <input asp-for="AssetName" id="assetName" class="form-control" />
        <span asp-validation-for="AssetName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="SerialNumber" class="form-label"></label>
        <input asp-for="SerialNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AcquisitionDate" class="form-label"></label>
        <input asp-for="AcquisitionDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AcquisitionCost" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">₱</span>
            <input asp-for="AcquisitionCost" type="number" step="0.01" min="0" placeholder="0.00" class="form-control" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="WarrantyInformation" class="form-label"></label>
        <input asp-for="WarrantyInformation" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">Photo <span class="text-muted">(optional)</span></label>
        <input asp-for="ImageFile" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Condition" class="form-label"></label>
        <select asp-for="Condition" asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.ConditionStatus>()" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="BranchID" class="form-label">Branch</label>
        <select asp-for="BranchID" id="branchSelect" asp-items="ViewBag.Branches" class="form-select">
            <option value="">-- Select Branch --</option>
        </select>
        <span asp-validation-for="BranchID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CurrentLocationID" class="form-label">Location</label>
        <select asp-for="CurrentLocationID" id="locationSelect" class="form-select">
            <option value="">-- Pick a branch first --</option>
            @foreach (var loc in (List<SchoolInventoryManagement.BLL.DTOs.LocationDTO>)ViewBag.LocationsByBranch)
            {
                <option value="@loc.LocationID" data-branch="@loc.BranchID"
                        selected="@(loc.LocationID == Model.CurrentLocationID)">@loc.LocationName</option>
            }
        </select>
        <div class="form-text">Only locations in the chosen branch are listed.</div>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            // ---- Code preview and name --------------------------------
            // When a model is picked: show the code it will get, and start
            // the name off as the model's name if nothing is typed yet.
            var codePreview = document.getElementById('codePreview');
            var assetName = document.getElementById('assetName');
            var autoName = '';

            function pad(n) { var s = String(n); while (s.length < 4) s = '0' + s; return s; }

            document.addEventListener('model-picked', function (e) {
                var m = e.detail;
                if (!m) {
                    codePreview.textContent = 'Pick a model to see its code.';
                    return;
                }
                codePreview.textContent = m.next > @SchoolInventoryManagement.BLL.Services.AssetCodes.MaxNumber
                    ? m.prefix + ' has no codes left — give the category a new prefix.'
                    : m.prefix + '-' + pad(m.next);

                if (!assetName.value.trim() || assetName.value === autoName) {
                    assetName.value = m.name;
                    autoName = m.name;
                }
            });

            // ---- Location follows branch --------------------------------
            // The list only ever holds the chosen branch's locations, and
            // stays locked until a branch is picked. Options are rebuilt
            // rather than hidden, because some browsers ignore "hidden" on
            // <option>.
            var branchSelect = document.getElementById('branchSelect');
            var locationSelect = document.getElementById('locationSelect');
            if (!branchSelect || !locationSelect) return;

            var allLocations = Array.from(locationSelect.options)
                .filter(function (o) { return o.value; })
                .map(function (o) {
                    return { value: o.value, text: o.text, branch: o.getAttribute('data-branch') };
                });
            var selected = locationSelect.value;

            function rebuild() {
                var branchId = branchSelect.value;
                locationSelect.innerHTML = '';

                var placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.text = branchId ? '-- None --' : '-- Pick a branch first --';
                locationSelect.appendChild(placeholder);

                allLocations
                    .filter(function (l) { return l.branch === branchId; })
                    .forEach(function (l) {
                        var opt = document.createElement('option');
                        opt.value = l.value;
                        opt.text = l.text;
                        if (l.value === selected) opt.selected = true;
                        locationSelect.appendChild(opt);
                    });

                locationSelect.disabled = !branchId;
            }

            branchSelect.addEventListener('change', function () {
                selected = ''; // a new branch means its own location
                rebuild();
            });
            locationSelect.addEventListener('change', function () {
                selected = locationSelect.value;
            });

            rebuild(); // on load too, so a failed post shows the right list
        })();
    </script>
}