@model SchoolInventoryManagement.Web.ViewModels.AssetCreateViewModel
@{
    ViewData["Title"] = "New Asset";
}

<h2>New Asset</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="AssetCode" class="form-label"></label>
        <input asp-for="AssetCode" class="form-control" />
        <span asp-validation-for="AssetCode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ModelID" class="form-label">Model</label>
        <select asp-for="ModelID" asp-items="ViewBag.Models" class="form-select">
            <option value="">-- Select Model --</option>
        </select>
        <span asp-validation-for="ModelID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AssetName" class="form-label"></label>
        <input asp-for="AssetName" class="form-control" />
        <span asp-validation-for="AssetName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="SerialNumber" class="form-label"></label>
        <input asp-for="SerialNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AcquisitionDate" class="form-label"></label>
        <input asp-for="AcquisitionDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AcquisitionCost" class="form-label"></label>
        <input asp-for="AcquisitionCost" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="WarrantyInformation" class="form-label"></label>
        <input asp-for="WarrantyInformation" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">Photo <span class="text-muted">(optional)</span></label>
        <input asp-for="ImageFile" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Condition" class="form-label"></label>
        <select asp-for="Condition" asp-items="Html.GetEnumSelectList<SchoolInventoryManagement.DAL.Entities.Enums.ConditionStatus>()" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="BranchID" class="form-label">Branch</label>
        <select asp-for="BranchID" id="branchSelect" asp-items="ViewBag.Branches" class="form-select">
            <option value="">-- Select Branch --</option>
        </select>
        <span asp-validation-for="BranchID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CurrentLocationID" class="form-label">Location</label>
        <select asp-for="CurrentLocationID" id="locationSelect" class="form-select">
            <option value="">-- Pick a branch first --</option>
            @foreach (var loc in (List<SchoolInventoryManagement.BLL.DTOs.LocationDTO>)ViewBag.LocationsByBranch)
            {
                <option value="@loc.LocationID" data-branch="@loc.BranchID"
                        selected="@(loc.LocationID == Model.CurrentLocationID)">@loc.LocationName</option>
            }
        </select>
        <div class="form-text">Only locations in the chosen branch are listed.</div>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            // Location is chosen within a branch: the list only ever holds
            // that branch's locations, and stays locked until a branch is
            // picked. The options are rebuilt rather than hidden, because
            // some browsers ignore "hidden" on <option>.
            var branchSelect = document.getElementById('branchSelect');
            var locationSelect = document.getElementById('locationSelect');
            if (!branchSelect || !locationSelect) return;

            var allLocations = Array.from(locationSelect.options)
                .filter(function (o) { return o.value; })
                .map(function (o) {
                    return { value: o.value, text: o.text, branch: o.getAttribute('data-branch') };
                });
            var selected = locationSelect.value;

            function rebuild() {
                var branchId = branchSelect.value;
                locationSelect.innerHTML = '';

                var placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.text = branchId ? '-- None --' : '-- Pick a branch first --';
                locationSelect.appendChild(placeholder);

                allLocations
                    .filter(function (l) { return l.branch === branchId; })
                    .forEach(function (l) {
                        var opt = document.createElement('option');
                        opt.value = l.value;
                        opt.text = l.text;
                        if (l.value === selected) opt.selected = true;
                        locationSelect.appendChild(opt);
                    });

                locationSelect.disabled = !branchId;
            }

            branchSelect.addEventListener('change', function () {
                selected = ''; // a new branch means its own location
                rebuild();
            });
            locationSelect.addEventListener('change', function () {
                selected = locationSelect.value;
            });

            rebuild(); // on load too, so an edit or a failed post shows the right list
        })();
    </script>
}