@model List<SchoolInventoryManagement.Web.ViewModels.ModelCodeOption>
@* Model picker shared by Register and Bulk register. Looks and opens like
   a normal dropdown, but you can also type to narrow the list. The list is
   drawn by the page (not a <datalist>, whose popup the browser styles its
   own way). The hidden ModelID is what posts. Picking a model raises a
   "model-picked" event carrying its code prefix and next number, so each
   form can show the codes it will create. Pass the current ModelID in
   ViewData["SelectedModelId"]. *@
@{
    var selectedId = ViewData["SelectedModelId"] as int?;
    var selected = Model.FirstOrDefault(m => m.ModelID == selectedId);
}

<label for="modelSearch" class="form-label">Model</label>
<div class="model-picker position-relative">
    <input id="modelSearch" class="form-select" autocomplete="off"
           role="combobox" aria-expanded="false" aria-controls="modelList" aria-autocomplete="list"
           placeholder="Select a model, or type to search…" value="@(selected?.Label)" />
    <ul id="modelList" class="dropdown-menu w-100 model-picker-list" role="listbox">
        @foreach (var m in Model)
        {
            <li>
                <button type="button" class="dropdown-item" role="option" tabindex="-1"
                        data-label="@m.Label" data-id="@m.ModelID" data-name="@m.ModelName"
                        data-prefix="@m.CodePrefix" data-next="@m.NextNumber">
                    @m.ModelName <span class="text-muted small">— @m.CategoryName</span>
                </button>
            </li>
        }
        <li id="modelNoMatch" class="dropdown-item-text text-muted small d-none">No model matches what you typed.</li>
    </ul>
</div>
<input type="hidden" name="ModelID" id="modelId" value="@selectedId" />
<div class="form-text" id="modelHint">Pick from the list, or type part of the name to narrow it.</div>
@Html.ValidationMessage("ModelID", "", new { @class = "text-danger" })

<script>
    (function () {
        var search = document.getElementById('modelSearch');
        var list = document.getElementById('modelList');
        var hidden = document.getElementById('modelId');
        var hint = document.getElementById('modelHint');
        var noMatch = document.getElementById('modelNoMatch');
        var items = Array.from(list.querySelectorAll('button[data-id]'));
        var active = -1;

        function norm(s) { return (s || '').trim().toLowerCase(); }

        // The model the box currently names: its full label, or just the
        // model name, ignoring case. Anything else means no model chosen.
        function exactMatch() {
            var text = norm(search.value);
            if (!text) return null;
            return items.find(function (b) {
                return norm(b.dataset.label) === text || norm(b.dataset.name) === text;
            }) || null;
        }

        function visibleItems() {
            return items.filter(function (b) { return !b.parentElement.classList.contains('d-none'); });
        }

        // Narrows the list to what was typed. When the box already holds a
        // picked model, everything shows, like reopening a dropdown.
        function filter() {
            var text = norm(search.value);
            var showAll = !text || exactMatch() !== null;
            items.forEach(function (b) {
                var hit = showAll || norm(b.dataset.label).indexOf(text) !== -1;
                b.parentElement.classList.toggle('d-none', !hit);
            });
            noMatch.classList.toggle('d-none', visibleItems().length > 0);
            setActive(-1);
        }

        function setActive(index) {
            var shown = visibleItems();
            items.forEach(function (b) { b.classList.remove('active'); });
            active = index;
            if (index >= 0 && index < shown.length) {
                shown[index].classList.add('active');
                shown[index].scrollIntoView({ block: 'nearest' });
            }
        }

        function open() {
            filter();
            list.classList.add('show');
            search.setAttribute('aria-expanded', 'true');
            var current = exactMatch();
            if (current) setActive(visibleItems().indexOf(current));
        }

        function close() {
            list.classList.remove('show');
            search.setAttribute('aria-expanded', 'false');
            setActive(-1);
        }

        function pick(button) {
            search.value = button.dataset.label;
            sync();
            close();
        }

        function sync() {
            var match = exactMatch();
            hidden.value = match ? match.dataset.id : '';
            hint.textContent = match
                ? 'Codes in this category start with ' + match.dataset.prefix + '-.'
                : (search.value ? 'No model picked yet — choose one from the list.' : 'Pick from the list, or type part of the name to narrow it.');
            hint.className = 'form-text' + (search.value && !match ? ' text-danger' : '');

            document.dispatchEvent(new CustomEvent('model-picked', {
                detail: match ? {
                    id: match.dataset.id,
                    name: match.dataset.name,
                    prefix: match.dataset.prefix,
                    next: parseInt(match.dataset.next, 10)
                } : null
            }));
        }

        search.addEventListener('focus', open);
        search.addEventListener('click', open);
        search.addEventListener('input', function () { open(); sync(); });

        search.addEventListener('keydown', function (e) {
            var shown = visibleItems();
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (!list.classList.contains('show')) open();
                setActive(Math.min(active + 1, shown.length - 1));
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                setActive(Math.max(active - 1, 0));
            } else if (e.key === 'Enter') {
                // Enter picks the highlighted model instead of submitting
                // the form while the list is open.
                if (list.classList.contains('show')) {
                    e.preventDefault();
                    var target = shown[active] || (shown.length === 1 ? shown[0] : null);
                    if (target) pick(target);
                }
            } else if (e.key === 'Escape' || e.key === 'Tab') {
                close();
            }
        });

        // mousedown, not click: it fires before the box loses focus.
        items.forEach(function (b) {
            b.addEventListener('mousedown', function (e) { e.preventDefault(); pick(b); });
        });

        search.addEventListener('blur', close);

        // Runs once the page has finished loading, so the form's own script
        // is listening before the first event goes out.
        window.addEventListener('DOMContentLoaded', sync);
    })();
</script>
