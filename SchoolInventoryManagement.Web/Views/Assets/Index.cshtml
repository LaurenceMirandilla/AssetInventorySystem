@model SchoolInventoryManagement.Web.ViewModels.AssetIndexViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Assets";
    var canManage = User.IsInRole("Asset Officer") || User.IsInRole("Administrator");
    var activeStatus = Model.Status?.ToString();
}

<div class="sab-page-head">
    <div>
        <h2>Assets</h2>
        @if (Model.HasFilters)
        {
            <p class="sab-page-sub">@Model.TotalFilteredCount of @Model.GrandTotalCount registered unit@(Model.GrandTotalCount == 1 ? "" : "s") match@(Model.TotalFilteredCount == 1 ? "es" : "") your filters.</p>
        }
        else
        {
            <p class="sab-page-sub">@Model.TotalFilteredCount registered unit@(Model.TotalFilteredCount == 1 ? "" : "s").</p>
        }
    </div>
    <div class="sab-page-actions">
        <a asp-action="ExportAssets"
           asp-route-keyword="@Model.Keyword"
           asp-route-categoryId="@Model.CategoryId"
           asp-route-departmentId="@Model.DepartmentId"
           asp-route-status="@Model.Status"
           asp-route-condition="@Model.Condition" asp-route-locationId="@Model.LocationId" asp-route-modelId="@Model.ModelId" asp-route-branchId="@Model.BranchId"
           class="btn btn-outline-secondary">Export CSV</a>

        @if (canManage)
        {
            <a asp-action="BulkCreate" class="btn btn-outline-primary">+ Bulk register</a>
            <a asp-action="Create" class="btn btn-primary">+ Register asset</a>
        }
    </div>
</div>

@* KPI tiles -- a live breakdown of the rows below, so they always add up
   to what the table is showing. Every filter narrows them, status
   included, which means selecting a status zeroes the other four. That is
   the honest count, so the highlighted tile doubles as the way out:
   clicking it drops the status and restores the full breakdown, as does
   "All assets". The other filters ride along on every tile, so you never
   lose your search by clicking one. *@
<div class="report-tiles mb-3">
    <a asp-action="Index"
       asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId"
       asp-route-departmentId="@Model.DepartmentId" asp-route-condition="@Model.Condition" asp-route-locationId="@Model.LocationId" asp-route-modelId="@Model.ModelId" asp-route-branchId="@Model.BranchId"
       class="report-tile text-decoration-none @(activeStatus == null ? "active" : "")">
        <span class="report-tile-value">@Model.TotalFilteredCount</span>
        <span class="report-tile-label">@(Model.HasFilters ? "All matches" : "All assets")</span>
    </a>
    <a asp-action="Index"
       asp-route-status="@(activeStatus == "Available" ? null : "Available")"
       asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId"
       asp-route-departmentId="@Model.DepartmentId" asp-route-condition="@Model.Condition" asp-route-locationId="@Model.LocationId" asp-route-modelId="@Model.ModelId" asp-route-branchId="@Model.BranchId"
       class="report-tile text-decoration-none @(activeStatus == "Available" ? "active" : "")">
        <span class="report-tile-value">@Model.AvailableCount</span>
        <span class="report-tile-label">Available</span>
    </a>
    <a asp-action="Index"
       asp-route-status="@(activeStatus == "Assigned" ? null : "Assigned")"
       asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId"
       asp-route-departmentId="@Model.DepartmentId" asp-route-condition="@Model.Condition" asp-route-locationId="@Model.LocationId" asp-route-modelId="@Model.ModelId" asp-route-branchId="@Model.BranchId"
       class="report-tile text-decoration-none @(activeStatus == "Assigned" ? "active" : "")">
        <span class="report-tile-value">@Model.AssignedCount</span>
        <span class="report-tile-label">Assigned</span>
    </a>
    <a asp-action="Index"
       asp-route-status="@(activeStatus == "UnderMaintenance" ? null : "UnderMaintenance")"
       asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId"
       asp-route-departmentId="@Model.DepartmentId" asp-route-condition="@Model.Condition" asp-route-locationId="@Model.LocationId" asp-route-modelId="@Model.ModelId" asp-route-branchId="@Model.BranchId"
       class="report-tile text-decoration-none @(activeStatus == "UnderMaintenance" ? "active" : "")">
        <span class="report-tile-value">@Model.UnderMaintenanceCount</span>
        <span class="report-tile-label">Under maintenance</span>
    </a>
    <a asp-action="Index"
       asp-route-status="@(activeStatus == "Disposed" ? null : "Disposed")"
       asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId"
       asp-route-departmentId="@Model.DepartmentId" asp-route-condition="@Model.Condition" asp-route-locationId="@Model.LocationId" asp-route-modelId="@Model.ModelId" asp-route-branchId="@Model.BranchId"
       class="report-tile text-decoration-none @(activeStatus == "Disposed" ? "active" : "")">
        <span class="report-tile-value">@Model.DisposedCount</span>
        <span class="report-tile-label">Disposed</span>
    </a>
</div>

@* Filters, rows and the pager are one raised surface, as in the mockup --
   the filter row is a toolbar on the card rather than a detached form. *@
<div class="sab-table-card">
    <form method="get" class="sab-table-toolbar">
        <div class="sab-table-filters">
            <input type="text" name="keyword" class="form-control" style="width:190px;"
                   placeholder="Name, code, serial…" value="@Model.Keyword" />
            @* Order follows the hierarchy: Category > Model, then
               Branch > Location / Department. Every list is usable on its
               own; picking a parent narrows its children, and picking a
               child selects its parent. The script at the bottom does it. *@
            <select name="categoryId" id="fCategory" class="form-select" style="width:auto;">
                <option value="">All categories</option>
                @foreach (var c in Model.CategoryOptions)
                {
                    <option value="@c.CategoryID" selected="@(Model.CategoryId == c.CategoryID)">@c.CategoryName</option>
                }
            </select>

            <select name="modelId" id="fModel" class="form-select" style="width:auto;">
                <option value="">All models</option>
                @foreach (var g in Model.ModelOptions.GroupBy(m => m.CategoryName))
                {
                    <optgroup label="@g.Key">
                        @foreach (var m in g)
                        {
                            <option value="@m.ModelID" data-parent="@m.CategoryID" selected="@(Model.ModelId == m.ModelID)">@m.ModelName</option>
                        }
                    </optgroup>
                }
            </select>

            <select name="branchId" id="fBranch" class="form-select" style="width:auto;">
                <option value="">All branches</option>
                @foreach (var b in Model.BranchOptions)
                {
                    <option value="@b.BranchID" selected="@(Model.BranchId == b.BranchID)">@b.BranchName</option>
                }
            </select>

            <select name="locationId" id="fLocation" class="form-select" style="width:auto;">
                <option value="">All locations</option>
                @foreach (var g in Model.LocationOptions.GroupBy(l => l.BranchName))
                {
                    <optgroup label="@g.Key">
                        @foreach (var l in g)
                        {
                            <option value="@l.LocationID" data-parent="@l.BranchID" selected="@(Model.LocationId == l.LocationID)">@l.LocationName</option>
                        }
                    </optgroup>
                }
            </select>

            <select name="departmentId" id="fDepartment" class="form-select" style="width:auto;">
                <option value="">All departments</option>
                @foreach (var g in Model.DepartmentOptions.GroupBy(d => d.BranchName))
                {
                    <optgroup label="@g.Key">
                        @foreach (var d in g)
                        {
                            <option value="@d.DepartmentID" data-parent="@d.BranchID" selected="@(Model.DepartmentId == d.DepartmentID)">@d.DepartmentName</option>
                        }
                    </optgroup>
                }
            </select>

            @Html.DropDownList("status", (IEnumerable<SelectListItem>)ViewBag.StatusFilter,
                 "All statuses", new { @class = "form-select", style = "width:auto;" })
            @Html.DropDownList("condition", (IEnumerable<SelectListItem>)ViewBag.ConditionFilter,
                 "All conditions", new { @class = "form-select", style = "width:auto;" })
            <button type="submit" class="btn btn-secondary">Apply</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>

        <span class="sab-table-count">
            @if (Model.TotalFilteredCount == 0)
            {
                <text>No matches</text>
            }
            else
            {
                <text>Showing @Model.FirstRowNumber–@Model.LastRowNumber of @Model.TotalFilteredCount</text>
            }
        </span>
    </form>

    @if (Model.TotalFilteredCount > 0)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Asset</th>
                    <th>Category</th>
                    <th>Condition</th>
                    <th>Status</th>
                    <th>Holder / Location</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in Model.Assets)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@asset.AssetID" class="sab-code">@asset.AssetCode</a></td>
                        <td>
                            <div class="fw-semibold">@asset.AssetName</div>
                            <div class="text-muted small">
                                @asset.ModelName
                                @if (!string.IsNullOrWhiteSpace(asset.SerialNumber))
                                {
                                    <text> &middot; SN @asset.SerialNumber</text>
                                }
                            </div>
                        </td>
                        <td>@asset.CategoryName</td>
                        <td><span class="status-pill status-@asset.Condition.ToString().ToLowerInvariant()">@DisplayText.Humanize(asset.Condition.ToString())</span></td>
                        <td><span class="status-pill status-@asset.Status.ToString().ToLowerInvariant()">@DisplayText.Humanize(asset.Status.ToString())</span></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(asset.AssignedUserName))
                            {
                                var initials = string.Concat(asset.AssignedUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => p[0])).ToUpperInvariant();
                                if (initials.Length > 2) { initials = initials[..2]; }
                                <div class="d-flex align-items-center" style="gap:8px;">
                                    <span class="sab-avatar sab-avatar-soft sab-avatar-sm">@initials</span>
                                    <span>@asset.AssignedUserName</span>
                                </div>
                            }
                            else
                            {
                                @(asset.CurrentLocationName ?? "—")
                            }
                        </td>
                        <td><a asp-action="Details" asp-route-id="@asset.AssetID">View</a></td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <div class="sab-table-foot">
                <span class="text-muted small">Page @Model.Page of @Model.TotalPages</span>
                <div>
                    <a class="btn btn-outline-secondary btn-sm @(Model.Page <= 1 ? "disabled" : "")"
                       asp-action="Index"
                       asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId"
                       asp-route-departmentId="@Model.DepartmentId" asp-route-status="@Model.Status"
                       asp-route-condition="@Model.Condition" asp-route-locationId="@Model.LocationId" asp-route-modelId="@Model.ModelId" asp-route-branchId="@Model.BranchId" asp-route-page="@(Model.Page - 1)">Previous</a>
                    <a class="btn btn-outline-secondary btn-sm @(Model.Page >= Model.TotalPages ? "disabled" : "")"
                       asp-action="Index"
                       asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId"
                       asp-route-departmentId="@Model.DepartmentId" asp-route-status="@Model.Status"
                       asp-route-condition="@Model.Condition" asp-route-locationId="@Model.LocationId" asp-route-modelId="@Model.ModelId" asp-route-branchId="@Model.BranchId" asp-route-page="@(Model.Page + 1)">Next</a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="sab-empty">
            <div class="sab-empty-title">No assets match these filters</div>
            <p>Every record here is one physical unit. Clear the filters to see the whole inventory.</p>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset filters</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Cascading filters. Every list can be used on its own, and the
        // pairs keep each other consistent:
        //   Category -> narrows Model.   Model -> selects its Category.
        //   Branch -> narrows Location and Department.
        //   Location or Department -> selects its Branch, which then
        //   narrows the other one.
        // With no parent chosen, a child list shows everything grouped
        // under its parent's name. This only shapes the lists -- the server
        // applies whatever is submitted.
        (function () {
            var categorySel = document.getElementById('fCategory');
            var modelSel = document.getElementById('fModel');
            var branchSel = document.getElementById('fBranch');
            var locationSel = document.getElementById('fLocation');
            var departmentSel = document.getElementById('fDepartment');
            if (!categorySel || !modelSel || !branchSel || !locationSel || !departmentSel) return;

            // Snapshot every child option once, with its parent id and group,
            // so a list can be rebuilt from scratch whenever its parent changes.
            function snapshot(select) {
                return Array.from(select.querySelectorAll('option[data-parent]')).map(function (o) {
                    return {
                        value: o.value,
                        text: o.textContent,
                        parent: o.getAttribute('data-parent'),
                        group: o.parentElement.tagName === 'OPTGROUP' ? o.parentElement.label : null
                    };
                });
            }

            var allModels = snapshot(modelSel);
            var allLocations = snapshot(locationSel);
            var allDepartments = snapshot(departmentSel);

            // Rebuild a child list with only the options under parentValue.
            // With no parent chosen, everything is listed under group headers;
            // with one chosen, the headers would all say the same thing, so
            // the list goes flat. Keeps the current choice if it survives,
            // otherwise falls back to the first ("All ...") entry.
            function rebuild(select, options, parentValue) {
                var current = select.value;
                var placeholder = select.options[0];
                select.innerHTML = '';
                select.appendChild(placeholder);

                var groups = {};
                options.forEach(function (o) {
                    if (parentValue && o.parent !== parentValue) return;

                    var container = select;
                    if (!parentValue && o.group) {
                        if (!groups[o.group]) {
                            groups[o.group] = document.createElement('optgroup');
                            groups[o.group].label = o.group;
                            select.appendChild(groups[o.group]);
                        }
                        container = groups[o.group];
                    }

                    var opt = document.createElement('option');
                    opt.value = o.value;
                    opt.textContent = o.text;
                    opt.setAttribute('data-parent', o.parent);
                    container.appendChild(opt);
                });

                select.value = current;
                if (select.value !== current) select.value = '';
            }

            function parentOf(options, value) {
                for (var i = 0; i < options.length; i++) {
                    if (options[i].value === value) return options[i].parent;
                }
                return '';
            }

            function syncModels() {
                rebuild(modelSel, allModels, categorySel.value);
            }

            function syncBranchChildren() {
                rebuild(locationSel, allLocations, branchSel.value);
                rebuild(departmentSel, allDepartments, branchSel.value);
            }

            // Picking a child selects its parent, then re-narrows the
            // parent's other children to match.
            function adoptParent(childSel, childOptions, parentSel, resync) {
                if (!childSel.value) return;
                var parent = parentOf(childOptions, childSel.value);
                if (parent && parentSel.value !== parent) {
                    parentSel.value = parent;
                    resync();
                }
            }

            categorySel.addEventListener('change', syncModels);
            branchSel.addEventListener('change', syncBranchChildren);

            modelSel.addEventListener('change', function () {
                adoptParent(modelSel, allModels, categorySel, syncModels);
            });
            locationSel.addEventListener('change', function () {
                adoptParent(locationSel, allLocations, branchSel, syncBranchChildren);
            });
            departmentSel.addEventListener('change', function () {
                adoptParent(departmentSel, allDepartments, branchSel, syncBranchChildren);
            });

            // On load: let any chosen child settle its parent first (a
            // bookmarked URL may carry a child without its parent), then
            // narrow everything to match.
            adoptParent(modelSel, allModels, categorySel, function () {});
            adoptParent(locationSel, allLocations, branchSel, function () {});
            adoptParent(departmentSel, allDepartments, branchSel, function () {});
            syncModels();
            syncBranchChildren();
        })();
    </script>
}