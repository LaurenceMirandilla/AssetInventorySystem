@model SchoolInventoryManagement.BLL.DTOs.AssetResponseDTO
@{
    ViewData["Title"] = Model.AssetName;
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<nav class="mb-2" style="font-size:0.85rem;">
    <a asp-action="Index" class="text-muted">Assets</a>
    <span class="text-muted mx-1">&rsaquo;</span>
    <span class="sab-code">@Model.AssetCode</span>
</nav>

<div class="d-flex justify-content-between align-items-start flex-wrap mb-1" style="gap:12px;">
    <div>
        <h2 class="mb-0 d-flex align-items-center" style="gap:10px;">
            @Model.AssetName
            <span class="status-pill status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span>
        </h2>
        <p class="text-muted mb-3">
            <span class="sab-code">@Model.AssetCode</span> &middot; @Model.ModelName
            @if (!string.IsNullOrWhiteSpace(Model.SerialNumber))
            {
                <text>&middot; Serial @Model.SerialNumber</text>
            }
        </p>
    </div>

    @if (User.IsInRole("Asset Officer") || User.IsInRole("Administrator"))
    {
        <div class="d-flex" style="gap:8px;">
            <a asp-action="Edit" asp-route-id="@Model.AssetID" class="btn btn-outline-secondary">Edit</a>

            @if (Model.Status == SchoolInventoryManagement.DAL.Entities.Enums.AssetStatus.Disposed)
            {
                <form asp-action="Restore" asp-route-id="@Model.AssetID" method="post" onsubmit="return confirm('Restore this asset to Available?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(Model.RowVersion)" />
                    <button type="submit" class="btn btn-success">Restore</button>
                </form>
            }
            else if (Model.Status == SchoolInventoryManagement.DAL.Entities.Enums.AssetStatus.UnderMaintenance)
            {
                <form asp-action="ReturnToService" asp-route-id="@Model.AssetID" method="post" onsubmit="return confirm('Mark this asset Available again?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(Model.RowVersion)" />
                    <button type="submit" class="btn btn-success">Return to Service</button>
                </form>
            }
            else if (Model.Status == SchoolInventoryManagement.DAL.Entities.Enums.AssetStatus.Available)
            {
                <a asp-controller="AssetMovements" asp-action="Transfer" asp-route-id="@Model.AssetID" class="btn btn-outline-secondary">Transfer</a>
                <a asp-action="Dispose" asp-route-id="@Model.AssetID" class="btn btn-outline-danger">Dispose</a>

                <form asp-action="SendToMaintenance" asp-route-id="@Model.AssetID" method="post" onsubmit="return confirm('Send this asset for maintenance?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rowVersionBase64" value="@Convert.ToBase64String(Model.RowVersion)" />
                    <button type="submit" class="btn btn-outline-secondary">Send to Maintenance</button>
                </form>

                <a asp-controller="AssetAssignments" asp-action="Assign" asp-route-id="@Model.AssetID" class="btn btn-primary">Assign</a>
            }
            else if (Model.Status == SchoolInventoryManagement.DAL.Entities.Enums.AssetStatus.Assigned && Model.ActiveAssignmentID.HasValue)
            {
                <a asp-controller="AssetAssignments" asp-action="Return" asp-route-id="@Model.ActiveAssignmentID" class="btn btn-primary">Record return</a>
            }
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="mb-3">Details</h5>
                <div class="row row-cols-1 row-cols-md-3 g-3">
                    <div class="col">
                        <div class="text-muted small">Category</div>
                        <div class="fw-semibold">@Model.CategoryName</div>
                    </div>
                    <div class="col">
                        <div class="text-muted small">Model</div>
                        <div class="fw-semibold">@Model.ModelName</div>
                    </div>
                    <div class="col">
                        <div class="text-muted small">Condition</div>
                        <div class="fw-semibold">@Model.Condition</div>
                    </div>

                    <div class="col">
                        <div class="text-muted small">Acquired</div>
                        <div class="fw-semibold">@(Model.AcquisitionDate?.ToString("MMM d, yyyy") ?? "—")</div>
                    </div>
                    <div class="col">
                        <div class="text-muted small">Cost</div>
                        <div class="fw-semibold">@(Model.AcquisitionCost?.ToString("C") ?? "—")</div>
                    </div>
                    <div class="col">
                        <div class="text-muted small">Warranty</div>
                        <div class="fw-semibold">@(Model.WarrantyInformation ?? "—")</div>
                    </div>

                    <div class="col">
                        <div class="text-muted small">Branch</div>
                        <div class="fw-semibold">@Model.BranchName</div>
                    </div>
                    <div class="col">
                        <div class="text-muted small">Department</div>
                        <div class="fw-semibold">@(Model.DepartmentName ?? "—")</div>
                    </div>
                    <div class="col">
                        <div class="text-muted small">Location</div>
                        <div class="fw-semibold">@(Model.CurrentLocationName ?? (Model.AssignedUserName != null ? "— with holder" : "—"))</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <hr />
                    <div class="text-muted small">Description</div>
                    <div>@Model.Description</div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">History</h5>
                    <p class="text-muted mb-0 small">Assignments, movements, disposals and the audit trail for this unit.</p>
                </div>
                <a asp-action="History" asp-route-id="@Model.AssetID" class="btn btn-outline-secondary">View History</a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        @if (!string.IsNullOrWhiteSpace(Model.AssignedUserName))
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="text-muted small mb-3" style="text-transform:uppercase; letter-spacing:.04em;">Current holder</h6>
                    <div class="d-flex align-items-center" style="gap:10px;">
                        <span class="sab-avatar sab-avatar-soft">
                            @string.Concat(Model.AssignedUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => p[0])).ToUpperInvariant()
                        </span>
                        <div>
                            <div class="fw-semibold">@Model.AssignedUserName</div>
                            <div class="text-muted small">@(Model.DepartmentName ?? "—")</div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-body">
                <h6 class="text-muted small mb-3" style="text-transform:uppercase; letter-spacing:.04em;">Photo &amp; label</h6>

                @if (!string.IsNullOrWhiteSpace(Model.ImageURL))
                {
                    <img src="@Model.ImageURL" alt="@Model.AssetName" class="img-fluid rounded mb-3" style="width:100%; object-fit:cover;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center mb-3"
                         style="height:140px; background:var(--sab-bg); border:1px dashed var(--sab-border); border-radius:var(--sab-radius-sm); color:var(--sab-text-faint);">
                        No photo
                    </div>
                }

                <img src="@Url.Action("QrCode", new { id = Model.AssetID })" alt="QR code" width="120" height="120" class="d-block mb-2" />
                <a href="@Url.Action("QrCode", new { id = Model.AssetID })" download="@($"{Model.AssetCode}-qr.png")"
                   class="btn btn-outline-primary btn-sm w-100">Download QR</a>
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-1">Back to List</a>