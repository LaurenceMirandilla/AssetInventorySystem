@model List<SchoolInventoryManagement.BLL.DTOs.RedTaggedAssetDTO>
@{
    ViewData["Title"] = "Red Tags";
    // What this page shows, for the live updates (_Layout, site.js).
    ViewData["LiveScope"] = "assets";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="sab-page-head">
    <div>
        <h2>Red tags</h2>
        <p class="sab-page-sub">Units the Property Department has marked for disposal, oldest first. Dispose of each one, or remove the tag if it can still be used.</p>
    </div>
    <div class="sab-page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Items</a>
        <a asp-controller="Reports" asp-action="Disposals" class="btn btn-outline-secondary">Disposals report</a>
    </div>
</div>

<div class="sab-table-card">
    @if (Model.Count == 0)
    {
        <div class="sab-empty">
            <div class="sab-empty-title">Nothing is red tagged</div>
            <p>Open an asset and choose <strong>Red tag</strong> to mark it for disposal.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table asset-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Asset</th>
                        <th class="d-none d-md-table-cell">Where</th>
                        <th>Reason</th>
                        <th class="d-none d-lg-table-cell">Tagged</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@a.AssetID" class="asset-code-chip">@a.AssetCode</a></td>
                            <td>
                                <div class="fw-semibold">@a.AssetName</div>
                                <div class="asset-muted small">@a.ModelName · @DisplayText.Humanize(a.Condition.ToString())</div>
                            </td>
                            <td class="d-none d-md-table-cell">
                                @DisplayText.Or(a.LocationName, "No room")
                                <div class="asset-muted small">@a.BranchName</div>
                            </td>
                            <td>@a.Reason</td>
                            <td class="d-none d-lg-table-cell text-nowrap">
                                @(a.TaggedAt?.ToString("MMM d, yyyy") ?? "")
                                <div class="asset-muted small">@a.TaggedByName</div>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Dispose" asp-route-id="@a.AssetID" class="btn btn-sm btn-danger">Dispose</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
