@model List<SchoolInventoryManagement.BLL.DTOs.NewItemRequestResponseDTO>
@{
    ViewData["Title"] = "New-Item Requests";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="sab-page-head">
    <div>
        <h2>New-Item Requests</h2>
        <p class="sab-page-sub">
            @Model.Count request@(Model.Count == 1 ? "" : "s") awaiting a decision, soonest needed first.
            You cannot decide one raised by someone holding your own role.
        </p>
    </div>
</div>

@if (Model.Any())
{
    <div class="sab-table-card">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Item</th>
                    <th>Needed by</th>
                    <th>Requested by</th>
                    <th>Submitted</th>
                    <th style="width:38%;">Decision</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    var late = request.NeededBy is not null && request.NeededBy.Value.Date < DateTime.Today;

                    <tr>
                        <td>@request.NewItemRequestID</td>
                        <td>
                            <div class="fw-semibold">@request.ItemName</div>
                            @if (!string.IsNullOrWhiteSpace(request.Reason))
                            {
                                <div class="text-muted small"><em>@request.Reason</em></div>
                            }
                        </td>
                        <td class="@(late ? "text-danger fw-semibold" : "")">
                            @(request.NeededBy?.ToString("MMM d, yyyy") ?? "—")
                            @if (late)
                            {
                                <div class="small">Date has passed</div>
                            }
                        </td>
                        <td>
                            <div>@request.RequestedByUserName</div>
                            <div class="text-muted small">@request.DepartmentName</div>
                        </td>
                        <td>@request.RequestDate.ToString("MMM d, yyyy")</td>
                        <td>
                            @* One form, two submits: Reject overrides the action via
                               formaction so both buttons share the remarks box. *@
                            <form asp-action="Approve" asp-route-id="@request.NewItemRequestID" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rowVersionBase64"
                                       value="@RowVersionHelper.ToBase64(request.RowVersion)" />
                                <input type="text" name="remarks" class="form-control form-control-sm mb-2"
                                       placeholder="Remarks (optional — sent to the requester)" />
                                <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                        formaction="@Url.Action("Reject", new { id = request.NewItemRequestID })">
                                    Reject
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card">
        <div class="sab-empty">
            <div class="sab-empty-title">Nothing waiting</div>
            <p>New-item requests land here when someone asks for something the school does not have.</p>
        </div>
    </div>
}