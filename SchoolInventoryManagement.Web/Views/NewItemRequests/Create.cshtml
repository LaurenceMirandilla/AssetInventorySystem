@model SchoolInventoryManagement.Web.ViewModels.CreateNewItemRequestViewModel
@{
    ViewData["Title"] = "Request a New Item";

    // Always at least one row, even after a post that removed them all.
    // Each row is a name, a quantity and an estimated price; a missing
    // quantity shows as 1, a missing price as blank.
    var names = Model.ItemNames.Count > 0 ? Model.ItemNames : new List<string?> { "" };
    var rows = names.Select((name, i) => (Name: name,
        Quantity: i < Model.Quantities.Count && Model.Quantities[i] is int q ? q : 1,
        Price: i < Model.EstimatedPrices.Count ? Model.EstimatedPrices[i] : null)).ToList();
}

<div class="sab-page-head">
    <div>
        <h2>Request a New Item</h2>
        <p class="sab-page-sub">
            For something the school does not have yet. If it is already in the catalogue,
            <a asp-controller="AssetRequests" asp-action="Create">borrow it instead</a>.
        </p>
    </div>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <div class="d-flex gap-2 mb-1">
            <label class="form-label mb-0 flex-grow-1">Item to be added</label>
            <label class="form-label mb-0" style="width:110px;">Quantity</label>
            <label class="form-label mb-0" style="width:190px;">Estimated price (each)</label>
            <span style="width:42px;"></span>
        </div>

        <div id="itemRows">
            @foreach (var row in rows)
            {
                <div class="d-flex gap-2 mb-2 item-row">
                    <input type="text" name="ItemNames" value="@row.Name" maxlength="150"
                           class="form-control flex-grow-1" placeholder="e.g. Document camera" />
                    <input type="number" name="Quantities" value="@row.Quantity" min="1" max="1000" step="1"
                           class="form-control qty-input" style="width:110px;" aria-label="Quantity" required />
                    <div class="input-group" style="width:190px;">
                        <span class="input-group-text">₱</span>
                        <input type="number" name="EstimatedPrices"
                               value="@(row.Price?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"
                               min="0.01" max="9999999999.99" step="0.01" placeholder="0.00"
                               class="form-control price-input" aria-label="Estimated price for one" required />
                    </div>
                    <button type="button" class="btn btn-outline-danger remove-row" style="width:42px;" title="Remove this item">&times;</button>
                </div>
            }
        </div>

        <button type="button" id="addItemRow" class="btn btn-outline-primary btn-sm">+ Add another item</button>
        <span asp-validation-for="ItemNames" class="text-danger d-block"></span>
        <div class="form-text">Each item becomes its own request. The reason and date below apply to all of them.</div>

        @* Quantity x estimated price, added up over every row. Display
           only -- each request stores its own price, and its own total is
           worked out from it wherever it is shown. *@
        <div class="d-flex justify-content-end align-items-baseline gap-2 mt-2 pt-2 border-top">
            <span class="text-muted">Estimated total</span>
            <span id="estimatedTotal" class="fs-5 fw-semibold">₱0.00</span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Reason" class="form-label">Reason</label>
        <textarea asp-for="Reason" class="form-control" rows="4"
                  placeholder="What it is for and who will use it."></textarea>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>

    <div class="mb-3" style="max-width:260px;">
        <label asp-for="NeededBy" class="form-label">When do you need it?</label>
        <input asp-for="NeededBy" type="date" class="form-control"
               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="NeededBy" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Submit Request</button>
    <a asp-action="MyRequests" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            // "+ Add another item": copy the first row, emptied, quantity 1.
            // Every row posts as ItemNames + Quantities + EstimatedPrices,
            // which bind to the three lists in order. The x removes a row; the last one is only
            // cleared.
            var rowsBox = document.getElementById('itemRows');
            var maxRows = 20; // the service refuses more than this anyway

            function syncRemoveButtons() {
                var rowsNow = rowsBox.querySelectorAll('.item-row');
                rowsNow.forEach(function (row) {
                    row.querySelector('.remove-row').hidden = rowsNow.length === 1;
                });
                document.getElementById('addItemRow').disabled = rowsNow.length >= maxRows;
            }

            // Estimated total: quantity x price for every row, added up.
            // Rows with no price yet count as zero.
            var totalBox = document.getElementById('estimatedTotal');

            function formatPeso(n) {
                return '₱' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function updateTotal() {
                var total = 0;
                rowsBox.querySelectorAll('.item-row').forEach(function (row) {
                    var qty = parseInt(row.querySelector('.qty-input').value, 10);
                    var price = parseFloat(row.querySelector('.price-input').value);
                    if (qty > 0 && price > 0) total += qty * price;
                });
                totalBox.textContent = formatPeso(total);
            }

            rowsBox.addEventListener('input', updateTotal);

            document.getElementById('addItemRow').addEventListener('click', function () {
                var copy = rowsBox.querySelector('.item-row').cloneNode(true);
                copy.querySelector('input[name="ItemNames"]').value = '';
                copy.querySelector('input[name="Quantities"]').value = 1;
                copy.querySelector('input[name="EstimatedPrices"]').value = '';
                rowsBox.appendChild(copy);
                syncRemoveButtons();
                updateTotal();
                copy.querySelector('input').focus();
            });

            rowsBox.addEventListener('click', function (e) {
                var button = e.target.closest('.remove-row');
                if (!button) return;
                var rowsNow = rowsBox.querySelectorAll('.item-row');
                var row = button.closest('.item-row');
                if (rowsNow.length > 1) {
                    row.remove();
                } else {
                    row.querySelector('input[name="ItemNames"]').value = '';
                    row.querySelector('input[name="Quantities"]').value = 1;
                    row.querySelector('input[name="EstimatedPrices"]').value = '';
                }
                syncRemoveButtons();
                updateTotal();
            });

            syncRemoveButtons();
            updateTotal();
        })();
    </script>
}