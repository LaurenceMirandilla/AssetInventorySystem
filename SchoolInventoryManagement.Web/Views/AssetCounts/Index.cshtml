@model List<SchoolInventoryManagement.BLL.DTOs.AssetCountSummaryDTO>
@{
    ViewData["Title"] = "Counts";
    var canCount = User.IsInRole("Property Officer") || User.IsInRole("Administrator");
}

<div class="sab-page-head">
    <div>
        <h2>Counts</h2>
        <p class="sab-page-sub">Physical counts of assets by the Property Department, newest first.</p>
    </div>
    <div class="sab-page-actions">
        <a asp-controller="Assets" asp-action="Index" class="btn btn-outline-secondary">&larr; Items</a>
        @if (canCount)
        {
            <a asp-action="Create" class="btn btn-primary">Count a room</a>
        }
    </div>
</div>

<div class="sab-table-card">
    @if (Model.Count == 0)
    {
        <div class="sab-empty">
            <div class="sab-empty-title">No counts yet</div>
            <p>Pick a room and tick what is there; anything left unticked is listed as missing.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table asset-table mb-0">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Room</th>
                        <th class="d-none d-md-table-cell">Counted by</th>
                        <th class="text-end">On record</th>
                        <th class="text-end">Found</th>
                        <th class="text-end">Missing</th>
                        <th class="text-end d-none d-sm-table-cell">Not on record</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="text-nowrap"><a asp-action="Details" asp-route-id="@c.AssetCountID" class="fw-semibold">@c.CountedAt.ToString("MMM d, yyyy")</a><div class="asset-muted small">@c.CountedAt.ToString("h:mm tt")</div></td>
                            <td>@c.LocationName<div class="asset-muted small">@c.BranchName</div></td>
                            <td class="d-none d-md-table-cell">@c.CountedByName</td>
                            <td class="text-end">@c.Expected</td>
                            <td class="text-end">@c.Found</td>
                            <td class="text-end @(c.Missing > 0 ? "count-missing fw-bold" : "")">@c.Missing</td>
                            <td class="text-end d-none d-sm-table-cell">@c.FoundElsewhere</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
